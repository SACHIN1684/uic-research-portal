<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Confirm Duplicate Publications — UIC Research Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark portal-nav">
  <div class="container-fluid px-4">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/portal">
      <div class="brand-icon"><i class="fas fa-flask"></i></div>
      <div>
        <div class="brand-title">UIC Research Portal</div>
        <div class="brand-sub">University Institute of Computing, Chandigarh University</div>
      </div>
    </a>
    <div class="ms-auto d-flex align-items-center gap-2">
      <a href="/" class="btn btn-outline-light btn-sm"><i class="fas fa-home me-1"></i>Home</a>
      <a href="/portal" class="nav-link-btn"><i class="fas fa-th-large me-1"></i>Directory</a>
    </div>
  </div>
</nav>

<main class="main-content">
  <div class="container" style="max-width: 1150px;">

    <div class="alert alert-warning border-warning shadow-sm rounded-3 p-4 mb-4">
      <div class="d-flex align-items-start gap-3">
        <i class="fas fa-exclamation-triangle fa-2x text-warning mt-1"></i>
        <div>
          <h4 class="fw-bold text-dark mb-1">
            Duplicate Publications Detected
            <% if (typeof scopeTitle !== 'undefined' && scopeTitle) { %> — <%= scopeTitle %><% } %>
          </h4>
          <p class="mb-2 text-dark">
            We checked every uploaded publication against existing records (by <strong>Paper Title</strong> and <strong>EID</strong> for each faculty).
            <strong><%= duplicateItems.length %></strong> publication(s) already exist, and <strong><%= newItems.length %></strong> publication(s) are new.
          </p>
          <p class="mb-0 small text-muted">
            Choose whether to <strong>Replace</strong> the existing entries with your new details, <strong>Skip</strong> duplicates and add only new papers, or <strong>Add All Anyway</strong>.
          </p>
        </div>
      </div>
    </div>

    <form action="<%= confirmAction %>" method="POST">
      <input type="hidden" name="new_items_json" value="<%= newItemsJson %>">
      <input type="hidden" name="duplicate_items_json" value="<%= duplicateItemsJson %>">
      <input type="hidden" name="unmatched_count" value="<%= typeof unmatchedCount !== 'undefined' ? unmatchedCount : 0 %>">
      <input type="hidden" name="unmatched_names" value="<%= typeof unmatchedNames !== 'undefined' ? unmatchedNames : '' %>">
      <input type="hidden" name="pending_id" value="<%= typeof pendingId !== 'undefined' ? pendingId : '' %>">

      <% if (typeof uniquePendingNames !== 'undefined' && uniquePendingNames && uniquePendingNames.length > 0) { %>
        <div class="alert alert-danger border-danger shadow-sm rounded-3 p-3 mb-4">
          <div class="fw-bold mb-2">
            <i class="fas fa-user-clock me-1"></i>
            Pending Faculty Names Not Found in Directory (<%= unmatchedCount %> row(s) will stay Pending):
          </div>
          <div class="d-flex flex-wrap gap-2">
            <% uniquePendingNames.forEach(item => { %>
              <span class="badge bg-white text-danger border border-danger px-2 py-1 fs-6">
                <%= item.name %> (<%= item.department %> &bull; <%= item.count %>)
              </span>
            <% }) %>
          </div>
        </div>
      <% } %>

      <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3 d-flex justify-content-between align-items-center flex-wrap gap-3 bg-light rounded-3">
          <div class="d-flex gap-2 flex-wrap">
            <span class="badge bg-success fs-6 px-3 py-2">
              <i class="fas fa-plus-circle me-1"></i>New Publications: <%= newItems.length %>
            </span>
            <span class="badge bg-warning text-dark fs-6 px-3 py-2">
              <i class="fas fa-copy me-1"></i>Duplicates Found: <%= duplicateItems.length %>
            </span>
          </div>
          <div class="d-flex gap-2 flex-wrap">
            <a href="<%= backUrl %>" class="btn btn-outline-secondary">
              <i class="fas fa-times me-1"></i>Cancel
            </a>
            <button type="submit" name="decision" value="skip" class="btn btn-primary fw-semibold">
              <i class="fas fa-forward me-1"></i>Skip Duplicates & Add New (<%= newItems.length %>)
            </button>
            <button type="submit" name="decision" value="replace" class="btn btn-warning fw-bold text-dark shadow-sm">
              <i class="fas fa-sync-alt me-1"></i>Replace Existing & Add New
            </button>
            <button type="submit" name="decision" value="add_all" class="btn btn-outline-dark fw-semibold">
              <i class="fas fa-layer-group me-1"></i>Add All Anyway
            </button>
          </div>
        </div>
      </div>

      <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-4">
        <div class="card-header bg-white py-3">
          <h5 class="mb-0 fw-bold text-dark">
            <i class="fas fa-exchange-alt me-2 text-warning"></i>Matching Existing Publications (<%= duplicateItems.length %>)
          </h5>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th style="width: 4%;">#</th>
                <th style="width: 14%;">Faculty</th>
                <th style="width: 12%;">Matched By</th>
                <th style="width: 35%;">Current Database Record</th>
                <th style="width: 35%;">New Uploaded Details</th>
              </tr>
            </thead>
            <tbody>
              <% duplicateItems.forEach((item, idx) => { %>
                <tr>
                  <td class="text-muted fw-bold"><%= idx + 1 %></td>
                  <td>
                    <div class="fw-bold text-dark small"><%= item.facultyName %></div>
                    <% if (item.facultyCode) { %>
                      <span class="badge bg-light text-secondary border font-monospace" style="font-size: 0.7rem;"><%= item.facultyCode %></span>
                    <% } %>
                  </td>
                  <td>
                    <% if (item.matchReason.includes('Both')) { %>
                      <span class="badge bg-danger">Title & EID</span>
                    <% } else if (item.matchReason.includes('EID')) { %>
                      <span class="badge bg-warning text-dark">EID Match</span>
                    <% } else { %>
                      <span class="badge bg-info text-dark">Paper Title</span>
                    <% } %>
                  </td>
                  <td>
                    <div class="fw-bold text-dark small mb-1"><%= item.existing.title %></div>
                    <div class="d-flex flex-wrap gap-1 align-items-center" style="font-size: 0.75rem;">
                      <span class="badge bg-primary-subtle text-primary border">ROS: <%= parseFloat(item.existing.ros || 0).toFixed(2) %></span>
                      <span class="badge bg-secondary"><%= item.existing.quartile || 'N/A' %></span>
                      <span class="badge bg-light text-dark border"><%= item.existing.document_type %></span>
                      <span class="badge bg-info-subtle text-dark border"><%= item.existing.pub_department || 'UIC' %></span>
                      <span class="text-muted"><%= item.existing.month %></span>
                      <% if (item.existing.eid) { %><span class="font-monospace text-muted">EID: <%= item.existing.eid %></span><% } %>
                    </div>
                  </td>
                  <td>
                    <div class="fw-bold text-primary small mb-1"><%= item.incoming.title %></div>
                    <div class="d-flex flex-wrap gap-1 align-items-center" style="font-size: 0.75rem;">
                      <span class="badge bg-success-subtle text-success border">ROS: <%= parseFloat(item.incoming.ros || 0).toFixed(2) %></span>
                      <span class="badge bg-secondary"><%= item.incoming.quartile || 'N/A' %></span>
                      <span class="badge bg-light text-dark border"><%= item.incoming.document_type %></span>
                      <span class="badge bg-info-subtle text-dark border"><%= item.incoming.pub_department || 'UIC' %></span>
                      <span class="text-muted"><%= item.incoming.month %></span>
                      <% if (item.incoming.eid) { %><span class="font-monospace text-muted">EID: <%= item.incoming.eid %></span><% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </form>

  </div>
</main>

<footer class="portal-footer">
  <div class="container-fluid px-4 text-center">
    <span><i class="fas fa-university me-1"></i>UIC Research Portal &copy; <%= new Date().getFullYear() %> &mdash; University Institute of Computing, Chandigarh University</span>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
