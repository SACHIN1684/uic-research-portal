  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script id="allYearsDataJson" type="application/json">
    <%- JSON.stringify(allYearsROS) %>
  </script>
  <script id="allYearsTopPerformersJson" type="application/json">
    <%- JSON.stringify(allYearsTopPerformers) %>
  </script>
  <script>
  document.addEventListener('DOMContentLoaded', () => {
    const allYearsData = JSON.parse(document.getElementById('allYearsDataJson').textContent);
    const allYearsPerf = JSON.parse(document.getElementById('allYearsTopPerformersJson').textContent);
    const yearSelect = document.getElementById('reportingYearSelect');
    const perfYearSelect = document.getElementById('perfYearSelect');
    if (!yearSelect) return;

    function esc(str) {
      return String(str || '').replace(/[&<>"']/g, c => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      }[c]));
    }

    function initials(name) {
      const parts = String(name || '').replace(/^(Dr\.|Prof\.|Mr\.|Ms\.|Mrs\.|Er\.)\s*/i, '').trim().split(/\s+/);
      if (parts.length >= 2) return (parts[0][0] + parts[1][0]).toUpperCase();
      return (parts[0] || '?').substring(0, 2).toUpperCase();
    }

    let currentYear = parseInt(yearSelect.value, 10) || 2026;
    let currentChartMode = 'growth';
    let currentPerfTab = 'monthly';
    let selectedMonthKey = null;
    let selectedQuarterKey = null;
    let selectedHalfKey = null;
    let rosChartInstance = null;

    function renderGrowthChartAndInsights(year, data) {
      const chartHeading = document.getElementById('chartYearHeading');
      if (chartHeading) chartHeading.textContent = year;

      const rows = data.rows || [];
      const activeRows = rows.filter(r => r.total > 0 || r.ros > 0);
      const peakRow = activeRows.reduce((best, r) => (!best || r.ros > best.ros ? r : best), null);
      const avgActive = activeRows.length ? (data.totals.ros / activeRows.length) : 0;

      // Latest MoM growth among consecutive months with prior > 0 or latest active transition
      let latestMomHtml = '<span class="text-muted">N/A (No MoM baseline)</span>';
      for (let i = rows.length - 1; i >= 1; i--) {
        if ((rows[i].ros > 0 || rows[i].total > 0) && rows[i - 1].ros > 0) {
          const pct = rows[i].mom_growth_pct;
          const diff = rows[i].mom_diff;
          const isUp = diff >= 0;
          const color = isUp ? 'text-success' : 'text-danger';
          const icon = isUp ? 'fa-arrow-trend-up' : 'fa-arrow-trend-down';
          const sign = isUp ? '+' : '';
          latestMomHtml = `<span class="${color}"><i class="fas ${icon} me-1"></i>${sign}${pct}% (${sign}${diff.toFixed(2)} in ${rows[i].monthShort || rows[i].month})</span>`;
          break;
        }
      }

      const peakEl = document.getElementById('insightPeakMonth');
      const momEl = document.getElementById('insightMomGrowth');
      const cumEl = document.getElementById('insightCumulativeRos');
      const avgEl = document.getElementById('insightAvgActiveRos');
      if (peakEl) peakEl.textContent = peakRow ? `${peakRow.month} (${peakRow.ros.toFixed(2)} ROS)` : 'No publications';
      if (momEl) momEl.innerHTML = latestMomHtml;
      if (cumEl) cumEl.textContent = `${(data.totals.ros || 0).toFixed(2)} ROS (${data.totals.total || 0} papers)`;
      if (avgEl) avgEl.textContent = activeRows.length ? `${avgActive.toFixed(2)} ROS (${activeRows.length} active mos)` : '0.00 ROS';

      const canvas = document.getElementById('deptRosGrowthChart');
      if (!canvas || typeof Chart === 'undefined') return;

      const labels = rows.map(r => r.monthShort || r.month.split(' ')[0]);
      const monthlyVals = rows.map(r => Number(r.ros || 0));
      const cumulativeVals = rows.map(r => Number(r.cumulative_ros || 0));
      const paperVals = rows.map(r => Number(r.total || 0));

      let datasets = [];
      let scales = {
        x: { grid: { display: false } },
        y: { beginAtZero: true, title: { display: true, text: 'ROS Score' } }
      };

      if (currentChartMode === 'growth') {
        datasets = [
          {
            type: 'bar',
            label: `Monthly Dept ROS (${year})`,
            data: monthlyVals,
            backgroundColor: 'rgba(13, 110, 253, 0.78)',
            borderColor: '#0b5ed7',
            borderWidth: 1.5,
            borderRadius: 6,
            order: 2
          },
          {
            type: 'line',
            label: 'Cumulative ROS Growth',
            data: cumulativeVals,
            borderColor: '#c8102e',
            backgroundColor: 'rgba(200, 16, 46, 0.12)',
            borderWidth: 3,
            pointBackgroundColor: '#c8102e',
            pointRadius: 4,
            pointHoverRadius: 6,
            fill: true,
            tension: 0.3,
            order: 1
          }
        ];
      } else if (currentChartMode === 'papers') {
        datasets = [
          {
            type: 'bar',
            label: `Monthly Dept ROS (${year})`,
            data: monthlyVals,
            backgroundColor: 'rgba(200, 16, 46, 0.8)',
            borderColor: '#960c22',
            borderWidth: 1.5,
            borderRadius: 6,
            yAxisID: 'y',
            order: 2
          },
          {
            type: 'line',
            label: 'Total Papers Published',
            data: paperVals,
            borderColor: '#0b1f3f',
            backgroundColor: 'rgba(11, 31, 63, 0.12)',
            borderWidth: 3,
            pointBackgroundColor: '#0b1f3f',
            pointRadius: 4,
            tension: 0.25,
            yAxisID: 'y1',
            order: 1
          }
        ];
        scales = {
          x: { grid: { display: false } },
          y: { beginAtZero: true, position: 'left', title: { display: true, text: 'ROS Score' } },
          y1: { beginAtZero: true, position: 'right', grid: { drawOnChartArea: false }, ticks: { precision: 0 }, title: { display: true, text: 'Papers Count' } }
        };
      } else {
        datasets = [
          { type: 'bar', label: 'Q1 ROS', data: rows.map(r => Number(r.q1_ros || 0)), backgroundColor: '#198754', stack: 'q' },
          { type: 'bar', label: 'Q2 ROS', data: rows.map(r => Number(r.q2_ros || 0)), backgroundColor: '#0d6efd', stack: 'q' },
          { type: 'bar', label: 'Q3 ROS', data: rows.map(r => Number(r.q3_ros || 0)), backgroundColor: '#0dcaf0', stack: 'q' },
          { type: 'bar', label: 'Q4 ROS', data: rows.map(r => Number(r.q4_ros || 0)), backgroundColor: '#ffc107', stack: 'q' }
        ];
        scales = {
          x: { stacked: true, grid: { display: false } },
          y: { stacked: true, beginAtZero: true, title: { display: true, text: 'ROS by Quartile' } }
        };
      }

      if (rosChartInstance) {
        rosChartInstance.destroy();
      }
      rosChartInstance = new Chart(canvas.getContext('2d'), {
        data: { labels, datasets },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: { position: 'top', labels: { usePointStyle: true, font: { weight: '600' } } },
            tooltip: {
              callbacks: {
                afterBody: function(items) {
                  const idx = items[0] ? items[0].dataIndex : -1;
                  if (idx < 0 || !rows[idx]) return '';
                  const r = rows[idx];
                  const lines = [`Papers: ${r.total}`];
                  if (r.mom_growth_pct !== null && r.mom_growth_pct !== undefined) {
                    const s = r.mom_growth_pct >= 0 ? '+' : '';
                    lines.push(`MoM ROS Change: ${s}${r.mom_growth_pct}%`);
                  }
                  return lines;
                }
              }
            }
          },
          scales
        }
      });
    }

    function renderSpotlightCard(title, badgeText, badgeClass, iconClass, periodObj) {
      if (!periodObj || !periodObj.winner) {
        return `
          <div class="d-flex justify-content-between align-items-start mb-2">
            <span class="badge ${badgeClass}">${esc(badgeText)}</span>
            <i class="fas ${iconClass} text-muted fs-5"></i>
          </div>
          <div class="small fw-bold text-dark">${esc(title)}</div>
          <div class="text-muted small mt-2"><i class="fas fa-info-circle me-1"></i>No publications recorded in this period.</div>
        `;
      }
      const winners = (periodObj.winners && periodObj.winners.length > 0) ? periodObj.winners : [periodObj.winner];
      const isTie = winners.length > 1;
      const topWinner = winners[0];
      const namesHtml = winners.slice(0, 2).map(w => `
        <a href="/faculty/${w.id}" class="text-decoration-none fw-bold text-dark d-block text-truncate" title="${esc(w.name)}">
          ${esc(w.name)}
        </a>
      `).join('');
      const moreTie = winners.length > 2 ? `<div class="small text-muted">+${winners.length - 2} more tied</div>` : '';

      return `
        <div class="d-flex justify-content-between align-items-start mb-2">
          <span class="badge ${badgeClass}">${esc(badgeText)}</span>
          <i class="fas ${iconClass} text-warning fs-5"></i>
        </div>
        <div class="small text-muted fw-semibold mb-1">${esc(title)} &bull; ${esc(periodObj.range || periodObj.label)}</div>
        <div class="d-flex align-items-center gap-2 my-2">
          <div class="avatar-circle-sm">${initials(topWinner.name)}</div>
          <div class="min-w-0 flex-grow-1">
            ${namesHtml}
            ${moreTie}
            <div class="small text-muted">${isTie ? `<span class="badge bg-warning text-dark">Co-Winners (${winners.length} tied)</span>` : esc(topWinner.employee_code)}</div>
          </div>
        </div>
        <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-2 small">
          <span><strong class="text-danger fs-6">${topWinner.ros.toFixed(2)}</strong> ROS</span>
          <span class="text-muted">${topWinner.total_pubs} ${topWinner.total_pubs === 1 ? 'paper' : 'papers'}</span>
        </div>
      `;
    }

    function renderTopPerformersSection(year, resetDefaults = false) {
      const perf = allYearsPerf[year];
      const yearBadge = document.getElementById('perfYearBadge');
      const exportBtn = document.getElementById('exportTopPerformersBtn');
      if (yearBadge) yearBadge.textContent = year;
      if (exportBtn) exportBtn.href = `/export/top-performers?year=${year}`;
      if (!perf) return;

      if (resetDefaults || !selectedMonthKey || !selectedMonthKey.startsWith(String(year))) {
        selectedMonthKey = perf.defaults.monthKey;
        selectedQuarterKey = perf.defaults.quarterKey;
        selectedHalfKey = perf.defaults.halfKey;
      }

      // Spotlight Cards (using latest active or selected periods)
      const spotMonthObj = perf.monthly.find(m => m.key === selectedMonthKey) || perf.monthly[0];
      const spotQuarterObj = perf.quarterly.find(q => q.key === selectedQuarterKey) || perf.quarterly[0];
      const spotHalfObj = perf.sixMonthly.find(h => h.key === selectedHalfKey) || perf.sixMonthly[0];
      const spotAnnualObj = perf.annual;

      const sM = document.getElementById('spotMonthly');
      const sQ = document.getElementById('spotQuarterly');
      const sH = document.getElementById('spotSixMonthly');
      const sA = document.getElementById('spotAnnual');
      if (sM) sM.innerHTML = renderSpotlightCard('Monthly Top Performer', spotMonthObj.label, 'bg-primary', 'fa-medal', spotMonthObj);
      if (sQ) sQ.innerHTML = renderSpotlightCard('Quarterly Top Performer', spotQuarterObj.label, 'bg-success', 'fa-trophy', spotQuarterObj);
      if (sH) sH.innerHTML = renderSpotlightCard('Six-Monthly Top Performer', spotHalfObj.key + ' ' + year, 'bg-dark', 'fa-crown', spotHalfObj);
      if (sA) sA.innerHTML = renderSpotlightCard('Annual Top Performer', 'Year ' + year, 'bg-danger', 'fa-award', spotAnnualObj);

      // Tabs active state
      document.querySelectorAll('#perfModeTabs [data-perf-tab]').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.perfTab === currentPerfTab);
      });

      const subWrap = document.getElementById('perfSubSelectorWrap');
      const subSelect = document.getElementById('perfSubSelect');
      const snapshotGrid = document.getElementById('perfSnapshotGrid');

      let activePeriod = null;

      if (currentPerfTab === 'monthly') {
        if (subWrap) subWrap.style.display = 'flex';
        if (subSelect) {
          subSelect.innerHTML = perf.monthly.map(m =>
            `<option value="${m.key}" ${m.key === selectedMonthKey ? 'selected' : ''}>${esc(m.full)} (${m.total_pubs} papers)</option>`
          ).join('');
        }
        activePeriod = perf.monthly.find(m => m.key === selectedMonthKey) || perf.monthly[0];
        if (snapshotGrid) {
          snapshotGrid.innerHTML = perf.monthly.map(m => {
            const isSel = m.key === activePeriod.key;
            const hasData = m.total_pubs > 0 && m.winner;
            const winText = hasData
              ? (m.winners.length > 1 ? `${esc(m.winner.name)} (+${m.winners.length - 1})` : esc(m.winner.name))
              : 'No data';
            return `
              <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                <button type="button" class="w-100 period-mini-card ${isSel ? 'selected' : ''} ${!hasData ? 'empty-period' : ''}" data-pick-key="${m.key}">
                  <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-bold small text-dark">${esc(m.short)}</span>
                    <span class="badge ${hasData ? 'bg-danger' : 'bg-secondary bg-opacity-50'}">${hasData ? m.winner.ros.toFixed(2) : '0.00'}</span>
                  </div>
                  <div class="text-truncate small ${hasData ? 'fw-semibold text-primary' : 'text-muted'}" title="${winText}">${winText}</div>
                  <div class="text-muted" style="font-size: 0.7rem;">${m.total_pubs} papers</div>
                </button>
              </div>
            `;
          }).join('');
        }
      } else if (currentPerfTab === 'quarterly') {
        if (subWrap) subWrap.style.display = 'flex';
        if (subSelect) {
          subSelect.innerHTML = perf.quarterly.map(q =>
            `<option value="${q.key}" ${q.key === selectedQuarterKey ? 'selected' : ''}>${esc(q.label)} (${esc(q.range)})</option>`
          ).join('');
        }
        activePeriod = perf.quarterly.find(q => q.key === selectedQuarterKey) || perf.quarterly[0];
        if (snapshotGrid) {
          snapshotGrid.innerHTML = perf.quarterly.map(q => {
            const isSel = q.key === activePeriod.key;
            const hasData = q.total_pubs > 0 && q.winner;
            const winText = hasData
              ? (q.winners.length > 1 ? `${esc(q.winner.name)} (+${q.winners.length - 1} tied)` : esc(q.winner.name))
              : 'No publications';
            return `
              <div class="col-sm-6 col-lg-3">
                <button type="button" class="w-100 period-mini-card ${isSel ? 'selected' : ''} ${!hasData ? 'empty-period' : ''}" data-pick-key="${q.key}">
                  <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-bold text-dark">${esc(q.label)}</span>
                    <span class="badge ${hasData ? 'bg-success' : 'bg-secondary bg-opacity-50'}">${hasData ? q.winner.ros.toFixed(2) + ' ROS' : '0.00'}</span>
                  </div>
                  <div class="small text-muted mb-1">${esc(q.range)}</div>
                  <div class="text-truncate small ${hasData ? 'fw-bold text-primary' : 'text-muted'}">${winText}</div>
                  <div class="text-muted mt-1" style="font-size: 0.72rem;">Dept Total: ${q.dept_ros.toFixed(2)} ROS (${q.total_pubs} papers)</div>
                </button>
              </div>
            `;
          }).join('');
        }
      } else if (currentPerfTab === 'sixMonthly') {
        if (subWrap) subWrap.style.display = 'flex';
        if (subSelect) {
          subSelect.innerHTML = perf.sixMonthly.map(h =>
            `<option value="${h.key}" ${h.key === selectedHalfKey ? 'selected' : ''}>${esc(h.label)} (${esc(h.range)})</option>`
          ).join('');
        }
        activePeriod = perf.sixMonthly.find(h => h.key === selectedHalfKey) || perf.sixMonthly[0];
        if (snapshotGrid) {
          snapshotGrid.innerHTML = perf.sixMonthly.map(h => {
            const isSel = h.key === activePeriod.key;
            const hasData = h.total_pubs > 0 && h.winner;
            const winText = hasData
              ? (h.winners.length > 1 ? `${esc(h.winner.name)} (+${h.winners.length - 1} tied)` : esc(h.winner.name))
              : 'No publications';
            return `
              <div class="col-md-6">
                <button type="button" class="w-100 period-mini-card ${isSel ? 'selected' : ''} ${!hasData ? 'empty-period' : ''}" data-pick-key="${h.key}">
                  <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-bold text-dark fs-6">${esc(h.label)}</span>
                    <span class="badge ${hasData ? 'bg-dark' : 'bg-secondary bg-opacity-50'} fs-6">${hasData ? h.winner.ros.toFixed(2) + ' ROS' : '0.00'}</span>
                  </div>
                  <div class="small text-muted mb-2">${esc(h.range)}</div>
                  <div class="text-truncate ${hasData ? 'fw-bold text-primary' : 'text-muted'}">
                    <i class="fas fa-trophy text-warning me-1"></i>Top: ${winText}
                  </div>
                  <div class="small text-muted mt-1">Active Faculty: ${h.active_faculty} &bull; Dept ROS: ${h.dept_ros.toFixed(2)} (${h.total_pubs} papers)</div>
                </button>
              </div>
            `;
          }).join('');
        }
      } else {
        if (subWrap) subWrap.style.display = 'none';
        activePeriod = perf.annual;
        if (snapshotGrid) {
          const top3 = (activePeriod.top || []).slice(0, 3);
          if (top3.length === 0) {
            snapshotGrid.innerHTML = '';
          } else {
            const medals = [
              { lbl: '1st Place (Annual Top)', cls: 'border-warning bg-warning-subtle', badge: 'bg-warning text-dark' },
              { lbl: '2nd Place', cls: 'border-secondary bg-light', badge: 'bg-secondary' },
              { lbl: '3rd Place', cls: 'border-info bg-info-subtle', badge: 'bg-info text-dark' }
            ];
            snapshotGrid.innerHTML = top3.map((f, idx) => {
              const m = medals[idx] || medals[2];
              return `
                <div class="col-md-4">
                  <div class="p-3 rounded-3 border ${m.cls} h-100">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                      <span class="badge ${m.badge}">Rank #${f.rank}</span>
                      <strong class="text-danger fs-5">${f.ros.toFixed(2)} ROS</strong>
                    </div>
                    <a href="/faculty/${f.id}" class="fw-bold text-dark text-decoration-none fs-6 d-block">${esc(f.name)}</a>
                    <div class="small text-muted">${esc(f.employee_code)} &bull; ${f.total_pubs} papers (Q1:${f.q1}, Q2:${f.q2}, Q3:${f.q3}, Q4:${f.q4})</div>
                  </div>
                </div>
              `;
            }).join('');
          }
        }
      }

      // Bind clicks on snapshot cards
      if (snapshotGrid) {
        snapshotGrid.querySelectorAll('[data-pick-key]').forEach(btn => {
          btn.addEventListener('click', () => {
            const key = btn.dataset.pickKey;
            if (currentPerfTab === 'monthly') selectedMonthKey = key;
            else if (currentPerfTab === 'quarterly') selectedQuarterKey = key;
            else if (currentPerfTab === 'sixMonthly') selectedHalfKey = key;
            renderTopPerformersSection(currentYear, false);
          });
        });
      }

      // Update leaderboard heading & badges
      const heading = document.getElementById('perfTableHeading');
      const subHeading = document.getElementById('perfTableSub');
      const badgesEl = document.getElementById('perfPeriodBadges');
      if (heading) heading.textContent = `Leaderboard — ${activePeriod.full || activePeriod.label}`;
      if (subHeading) subHeading.textContent = `${activePeriod.range || activePeriod.full || activePeriod.label} • Ranked by ROS Score (ties share rank)`;
      if (badgesEl) {
        badgesEl.innerHTML = `
          <span class="badge bg-primary">${activePeriod.active_faculty} Active Faculty</span>
          <span class="badge bg-secondary">${activePeriod.total_pubs} Total Papers</span>
          <span class="badge bg-danger">${activePeriod.dept_ros.toFixed(2)} Dept ROS</span>
        `;
      }

      // Leaderboard rows
      const lbBody = document.getElementById('perfLeaderboardBody');
      if (lbBody) {
        if (!activePeriod.top || activePeriod.top.length === 0) {
          lbBody.innerHTML = `
            <tr>
              <td colspan="7" class="text-center py-4 text-muted">
                <i class="fas fa-folder-open me-2"></i>No faculty publications recorded for <strong>${esc(activePeriod.full || activePeriod.label)}</strong>.
              </td>
            </tr>
          `;
        } else {
          lbBody.innerHTML = activePeriod.top.map(f => {
            const sharePct = activePeriod.dept_ros > 0 ? ((f.ros / activePeriod.dept_ros) * 100).toFixed(1) : '0.0';
            const rankBadge = f.rank === 1
              ? `<span class="badge bg-warning text-dark fs-6 px-2 py-1"><i class="fas fa-trophy me-1"></i>#1</span>`
              : (f.rank === 2
                ? `<span class="badge bg-secondary fs-6 px-2 py-1">#2</span>`
                : (f.rank === 3
                  ? `<span class="badge bg-info text-dark fs-6 px-2 py-1">#3</span>`
                  : `<span class="fw-bold text-muted">#${f.rank}</span>`));

            const avatarHtml = f.photo
              ? `<img src="/uploads/${esc(f.photo)}" alt="" class="avatar-circle-sm">`
              : `<div class="avatar-circle-sm">${initials(f.name)}</div>`;

            return `
              <tr class="${f.rank === 1 ? 'table-warning bg-opacity-25' : ''}">
                <td>${rankBadge}</td>
                <td>
                  <div class="d-flex align-items-center gap-2">
                    ${avatarHtml}
                    <div>
                      <a href="/faculty/${f.id}" class="fw-bold text-dark text-decoration-none">${esc(f.name)}</a>
                      <div class="small text-muted">${esc(f.designation || 'Faculty')}</div>
                    </div>
                  </div>
                </td>
                <td class="text-center"><span class="badge bg-light text-dark border">${esc(f.employee_code)}</span></td>
                <td class="text-center fw-bold">${f.total_pubs}</td>
                <td class="text-center">
                  <span class="badge bg-success-subtle text-success border border-success-subtle">Q1:${f.q1}</span>
                  <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Q2:${f.q2}</span>
                  <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">Q3:${f.q3}</span>
                  <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Q4:${f.q4}</span>
                </td>
                <td class="text-center"><span class="badge bg-danger fs-6 px-3 py-1">${f.ros.toFixed(2)}</span></td>
                <td class="text-center small fw-semibold text-muted">${sharePct}%</td>
              </tr>
            `;
          }).join('');
        }
      }
    }

    function updateYearView(year, updateUrl = true) {
      currentYear = parseInt(year, 10) || 2026;
      if (yearSelect && parseInt(yearSelect.value, 10) !== currentYear) yearSelect.value = currentYear;
      if (perfYearSelect && parseInt(perfYearSelect.value, 10) !== currentYear) perfYearSelect.value = currentYear;

      const fallbackMonths = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
      const data = allYearsData[currentYear] || {
        year: currentYear,
        rows: fallbackMonths.map(m => ({
          month: m + ' ' + currentYear, monthShort: m, q1: 0, q2: 0, q3: 0, q4: 0, q1_ros: 0, q2_ros: 0, q3_ros: 0, q4_ros: 0, total: 0, ros: 0, cumulative_ros: 0
        })),
        totals: { q1: 0, q2: 0, q3: 0, q4: 0, q1_ros: 0, q2_ros: 0, q3_ros: 0, q4_ros: 0, total: 0, ros: 0 }
      };

      // Update metric cards
      const q1Lbl = document.getElementById('metricYearQ1Label');
      const totLbl = document.getElementById('metricYearTotalLabel');
      const rosLbl = document.getElementById('metricYearRosLabel');
      if (q1Lbl) q1Lbl.textContent = currentYear;
      if (totLbl) totLbl.textContent = currentYear;
      if (rosLbl) rosLbl.textContent = currentYear;

      const q1Val = document.getElementById('metricQ1Val');
      const totVal = document.getElementById('metricTotalVal');
      const rosVal = document.getElementById('metricRosVal');
      const periodVal = document.getElementById('metricPeriodVal');
      if (q1Val) q1Val.textContent = data.totals.q1;
      if (totVal) totVal.textContent = data.totals.total;
      if (rosVal) rosVal.textContent = data.totals.ros.toFixed(2);
      if (periodVal) periodVal.textContent = 'Jan – Dec ' + currentYear;

      // Update table banner
      const banner = document.getElementById('tableYearBanner');
      if (banner) {
        banner.innerHTML = 'Research Output Score (ROS) of the UIC Department &bull; Calendar Year ' + currentYear;
      }

      function renderQuartCell(rosVal, countVal, badgeCls) {
        if (countVal > 0 || rosVal > 0) {
          const pWord = countVal === 1 ? 'paper' : 'papers';
          return `<span class="badge ${badgeCls} px-2 py-1 fs-6">${rosVal.toFixed(2)}</span><div class="text-muted mt-1" style="font-size: 0.7rem;">(${countVal} ${pWord})</div>`;
        }
        return `<span class="text-muted">0.00</span>`;
      }

      // Update table rows
      const tbody = document.getElementById('monthlyRosTableBody');
      if (tbody) {
        tbody.innerHTML = '';
        data.rows.forEach((row, idx) => {
          const tr = document.createElement('tr');
          if (row.total > 0) {
            tr.style.backgroundColor = '#f0fdf4';
          } else if (idx % 2 === 1) {
            tr.style.backgroundColor = '#fafbfc';
          } else {
            tr.style.backgroundColor = '#ffffff';
          }

          const q1Badge = renderQuartCell(row.q1_ros || 0, row.q1 || 0, 'bg-success');
          const q2Badge = renderQuartCell(row.q2_ros || 0, row.q2 || 0, 'bg-primary');
          const q3Badge = renderQuartCell(row.q3_ros || 0, row.q3 || 0, 'bg-info text-dark');
          const q4Badge = renderQuartCell(row.q4_ros || 0, row.q4 || 0, 'bg-warning text-dark');
          const totalClass = row.total > 0 ? 'text-primary' : 'text-muted';
          const totalCell = row.total > 0
            ? `${row.total}<div class="text-muted fw-normal" style="font-size: 0.7rem;">papers</div>`
            : `0`;
          const rosBadge = row.ros > 0 ? `<span class="badge bg-danger text-white px-3 py-1 fs-6 shadow-sm">${row.ros.toFixed(2)}</span>` : `<span class="text-muted">0.00</span>`;

          tr.innerHTML = `
            <td class="text-start ps-4 fw-semibold text-dark">
              <span class="d-inline-flex align-items-center gap-2">
                <span class="badge rounded-circle bg-secondary bg-opacity-25 text-dark" style="width: 22px; height: 22px; line-height: 16px; font-size: 0.72rem;">${idx + 1}</span>
                <strong>${row.month}</strong>
              </span>
            </td>
            <td>${q1Badge}</td>
            <td>${q2Badge}</td>
            <td>${q3Badge}</td>
            <td>${q4Badge}</td>
            <td class="fw-bold fs-6 ${totalClass}">${totalCell}</td>
            <td class="pe-4 fw-bold fs-6">${rosBadge}</td>
          `;
          tbody.appendChild(tr);
        });
      }

      // Update footer
      const footLbl = document.getElementById('tableFooterLabel');
      if (footLbl) footLbl.innerHTML = `<i class="fas fa-calculator me-1 text-primary"></i> Total (Jan – Dec ${currentYear})`;
      const fQ1 = document.getElementById('footQ1');
      const fQ2 = document.getElementById('footQ2');
      const fQ3 = document.getElementById('footQ3');
      const fQ4 = document.getElementById('footQ4');
      const fTot = document.getElementById('footTotal');
      const fRos = document.getElementById('footRos');
      if (fQ1) fQ1.innerHTML = `${(data.totals.q1_ros || 0).toFixed(2)}<div class="text-muted fw-normal" style="font-size: 0.72rem;">(${data.totals.q1} papers)</div>`;
      if (fQ2) fQ2.innerHTML = `${(data.totals.q2_ros || 0).toFixed(2)}<div class="text-muted fw-normal" style="font-size: 0.72rem;">(${data.totals.q2} papers)</div>`;
      if (fQ3) fQ3.innerHTML = `${(data.totals.q3_ros || 0).toFixed(2)}<div class="text-muted fw-normal" style="font-size: 0.72rem;">(${data.totals.q3} papers)</div>`;
      if (fQ4) fQ4.innerHTML = `${(data.totals.q4_ros || 0).toFixed(2)}<div class="text-muted fw-normal" style="font-size: 0.72rem;">(${data.totals.q4} papers)</div>`;
      if (fTot) fTot.textContent = data.totals.total;
      if (fRos) fRos.textContent = data.totals.ros.toFixed(2) + ' Points';

      // Render Department ROS Growth Graph + Top Performers
      renderGrowthChartAndInsights(currentYear, data);
      renderTopPerformersSection(currentYear, true);

      // Update URL param
      if (updateUrl && window.history && window.history.replaceState) {
        const newUrl = new URL(window.location);
        newUrl.searchParams.set('year', currentYear);
        window.history.replaceState({}, '', newUrl);
      }
    }

    yearSelect.addEventListener('change', function() {
      updateYearView(parseInt(this.value, 10), true);
    });

    if (perfYearSelect) {
      perfYearSelect.addEventListener('change', function() {
        updateYearView(parseInt(this.value, 10), true);
      });
    }

    document.querySelectorAll('[data-chart-mode]').forEach(btn => {
      btn.addEventListener('click', () => {
        currentChartMode = btn.dataset.chartMode;
        document.querySelectorAll('[data-chart-mode]').forEach(b => b.classList.toggle('active', b === btn));
        const data = allYearsData[currentYear];
        if (data) renderGrowthChartAndInsights(currentYear, data);
      });
    });

    document.querySelectorAll('#perfModeTabs [data-perf-tab]').forEach(btn => {
      btn.addEventListener('click', () => {
        currentPerfTab = btn.dataset.perfTab;
        renderTopPerformersSection(currentYear, false);
      });
    });

    const perfSubSelect = document.getElementById('perfSubSelect');
    if (perfSubSelect) {
      perfSubSelect.addEventListener('change', function() {
        if (currentPerfTab === 'monthly') selectedMonthKey = this.value;
        else if (currentPerfTab === 'quarterly') selectedQuarterKey = this.value;
        else if (currentPerfTab === 'sixMonthly') selectedHalfKey = this.value;
        renderTopPerformersSection(currentYear, false);
      });
    }

    // Initial render of Chart + Top Performers for selectedYear
    const initData = allYearsData[currentYear];
    if (initData) {
      renderGrowthChartAndInsights(currentYear, initData);
    }
    renderTopPerformersSection(currentYear, true);

    // Auto-open Admin Login modal if requested via query param
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('admin_login_required') === '1' || urlParams.get('login_err')) {
      const loginModalEl = document.getElementById('adminLoginModal');
      if (loginModalEl) new bootstrap.Modal(loginModalEl).show();
    }
  });
  </script>

  <!-- Admin Login Modal -->
  <div class="modal fade" id="adminLoginModal" tabindex="-1" aria-labelledby="adminLoginModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg">
        <form action="/admin/login" method="POST">
          <div class="modal-header text-white" style="background: var(--cu-navy);">
            <h5 class="modal-title fw-bold" id="adminLoginModalLabel">
              <i class="fas fa-user-shield me-2 text-warning"></i>Admin Login — UIC Research Portal
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body p-4">
            <p class="small text-muted mb-3">
              Enter your Admin credentials to unlock editing rights (add, edit, upload, and delete faculty or publications).
            </p>
            <div class="mb-3">
              <label class="form-label fw-bold">Username</label>
              <input type="text" name="username" class="form-control" placeholder="Enter admin username" required>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold">Password</label>
              <input type="password" name="password" class="form-control" placeholder="Enter admin password" required>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold small">After Login Go To:</label>
              <select name="return_to" class="form-select form-select-sm">
                <option value="/portal">Research Portal Directory (Editing Mode)</option>
                <option value="/">Home Page</option>
              </select>
            </div>
            <div class="alert alert-light border small text-muted mb-0 py-2">
              <i class="fas fa-info-circle text-primary me-1"></i>
              Default credentials: Username <code>admin</code> &bull; Password <code>uic@2026</code> (you can change these after logging in).
            </div>
          </div>
          <div class="modal-footer bg-light">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-danger fw-bold"><i class="fas fa-sign-in-alt me-1"></i>Login as Admin</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <% if (isAdmin) { %>
  <!-- Admin Settings Modal (Change Username & Password) -->
  <div class="modal fade" id="adminSettingsModal" tabindex="-1" aria-labelledby="adminSettingsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg">
        <form action="/admin/update-credentials" method="POST">
          <input type="hidden" name="return_to" value="/">
          <div class="modal-header bg-success text-white">
            <h5 class="modal-title fw-bold" id="adminSettingsModalLabel">
              <i class="fas fa-key me-2"></i>Update Admin Username & Password
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body p-4">
            <div class="mb-3">
              <label class="form-label fw-bold">Current Password <span class="text-danger">*</span></label>
              <input type="password" name="current_password" class="form-control" placeholder="Verify current password" required>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold">New Username <span class="text-danger">*</span></label>
              <input type="text" name="new_username" class="form-control" value="<%= adminUsername %>" required>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold">New Password</label>
              <input type="password" name="new_password" class="form-control" placeholder="Leave blank to keep existing password">
            </div>
          </div>
          <div class="modal-footer bg-light">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-success fw-bold"><i class="fas fa-save me-1"></i>Save Credentials</button>
          </div>
        </form>
      </div>
    </div>
  </div>
  <% } %>
</body>
</html>
