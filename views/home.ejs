        <!-- Executive Director Card -->
        <div class="col-md-6 col-lg-4">
          <div class="leader-card">
            <div class="leader-img-wrapper">
              <img src="/images/director_uic.jpg" alt="Executive Director UIC — Dr. Gurpreet Singh" class="leader-img" style="object-position: center top;">
              <span class="leader-tag tag-director"><i class="fas fa-star me-1"></i> Executive Director, UIC</span>
            </div>
            <div class="p-4 d-flex flex-column flex-grow-1">
              <h4 class="fw-bold text-dark mb-1">Dr. Gurpreet Singh</h4>
              <div class="text-danger fw-semibold small mb-3">Executive Director — University Institute of Computing</div>
              <p class="text-muted small mb-4 flex-grow-1">
                Leading the academic and research initiatives of UIC. Champion of faculty innovation, international research collaborations, patents, and high-impact Q1 journal publications.
              </p>
              <div class="border-top pt-3 d-flex justify-content-between align-items-center text-muted small">
                <span><i class="fas fa-envelope text-primary me-1"></i> director.uic@cumail.in</span>
                <span><i class="fas fa-building text-secondary me-1"></i> Block E2 - North Campus</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Head MCA -->
        <div class="col-md-6 col-lg-4">
          <div class="leader-card">
            <div class="leader-img-wrapper">
