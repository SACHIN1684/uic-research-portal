<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Photo Gallery &amp; Hall of Fame — UIC Research Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
  <script src="/js/theme.js"></script>
  <style>
    :root {
      --cu-red: #c8102e;
      --cu-red-dark: #960c22;
      --cu-navy: #0b1f3f;
      --cu-navy-light: #163665;
      --cu-gold: #d4af37;
    }
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: #1e293b;
      background-color: #f8fafc;
      overflow-x: hidden;
    }
    .display-font { font-family: 'Space Grotesk', sans-serif; }
    .cu-topbar {
      background: var(--cu-navy);
      color: rgba(255, 255, 255, 0.85);
      font-size: 0.8rem;
      padding: 6px 0;
      border-bottom: 2px solid var(--cu-red);
    }
    .home-navbar {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(12px);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
      position: sticky;
      top: 0;
      z-index: 1030;
      transition: all 0.3s ease;
    }
    .brand-logo-badge {
      background: linear-gradient(135deg, var(--cu-red), #e63946);
      color: #fff;
      font-weight: 800;
      font-size: 1.25rem;
      padding: 8px 14px;
      border-radius: 10px;
      box-shadow: 0 4px 14px rgba(200, 16, 46, 0.35);
      letter-spacing: 0.5px;
    }
    .page-hero-gallery {
      background: linear-gradient(135deg, #090e17 0%, #0f172a 45%, #16243d 100%);
      color: #ffffff;
      padding: 3rem 0 2.5rem;
      position: relative;
      border-bottom: 3px solid #f59e0b;
    }
    .gallery-stat-card {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 14px;
      padding: 1rem 1.25rem;
      backdrop-filter: blur(8px);
      transition: transform 0.2s;
    }
    .gallery-stat-card:hover {
      transform: translateY(-2px);
      background: rgba(255, 255, 255, 0.12);
    }
    .gallery-card {
      transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s ease;
      border: 1px solid rgba(0, 0, 0, 0.08);
    }
    .gallery-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 14px 30px rgba(0, 0, 0, 0.15) !important;
    }
    .gallery-img-wrap {
      overflow: hidden;
      position: relative;
    }
    .gallery-img {
      transition: transform 0.4s ease;
    }
    .gallery-card:hover .gallery-img {
      transform: scale(1.08);
    }
    .gallery-card:hover .gallery-overlay {
      opacity: 1 !important;
    }
  </style>
</head>
<body>

  <!-- Top bar -->
  <div class="cu-topbar">
    <div class="container-fluid px-3 px-lg-4 d-flex justify-content-between align-items-center">
      <div class="d-flex align-items-center gap-2">
        <span class="badge bg-danger text-white fw-bold px-2 py-1" style="font-size: 0.7rem;">CHANDIGARH UNIVERSITY</span>
        <span class="d-none d-md-inline text-white-50">|</span>
        <span class="d-none d-md-inline"><i class="fas fa-university me-1 text-warning"></i> University Institute of Computing (UIC)</span>
      </div>
      <div class="d-flex align-items-center gap-3">
        <span><i class="fas fa-award text-info me-1"></i> QS World Ranked</span>
        <span class="d-none d-md-inline">&bull;</span>
        <a href="/patents" class="text-white text-decoration-none">
          <i class="fas fa-certificate text-warning me-1"></i> Patents
        </a>
        <span class="d-none d-md-inline">&bull;</span>
        <a href="/portal" class="text-white fw-bold text-decoration-none">
          <i class="fas fa-sign-in-alt me-1"></i> Enter Portal
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navbar -->
  <nav class="navbar navbar-expand-lg home-navbar py-2">
    <div class="container-fluid px-3 px-lg-4">
      <a class="navbar-brand d-flex align-items-center gap-2 text-nowrap" href="/">
        <div class="brand-logo-badge py-1 px-2 fs-6">
          <i class="fas fa-laptop-code me-1"></i> UIC
        </div>
        <div>
          <div class="fw-bold fs-6 text-dark lh-1 display-font">UIC Research Portal</div>
          <div class="text-muted" style="font-size: 0.68rem; letter-spacing: 0.2px;">
            University Institute of Computing &bull; Chandigarh University
          </div>
        </div>
      </a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navGallery">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navGallery">
        <ul class="navbar-nav ms-auto align-items-center gap-1 gap-xl-2 my-2 my-lg-0" style="font-size: 0.88rem;">
          <li class="nav-item">
            <a class="nav-link fw-semibold text-dark px-2" href="/">
              <i class="fas fa-home text-secondary me-1"></i> Home
            </a>
          </li>

          <!-- Research Menu (Dropdown) -->
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle fw-bold text-dark px-2" href="#" id="galResearchDropdown" role="button" data-bs-toggle="dropdown">
              <i class="fas fa-flask text-danger me-1"></i> Research
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 py-2 rounded-3" style="min-width: 250px;">
              <li><a class="dropdown-item py-2 px-3 fw-semibold text-dark" href="/#overview"><i class="fas fa-chart-pie text-secondary me-2 fa-fw"></i> Research Overview</a></li>
              <li><a class="dropdown-item py-2 px-3 fw-semibold text-dark" href="/#leadership"><i class="fas fa-users-cog text-danger me-2 fa-fw"></i> My Director &amp; Heads</a></li>
              <li><a class="dropdown-item py-2 px-3 fw-semibold text-dark" href="/#coordinator"><i class="fas fa-user-tie text-success me-2 fa-fw"></i> Research Coordinator</a></li>
              <li><a class="dropdown-item py-2 px-3 fw-semibold text-dark" href="/#top-researchers"><i class="fas fa-user-graduate text-info me-2 fa-fw"></i> Top Researchers</a></li>
              <li><hr class="dropdown-divider my-1"></li>
              <li><a class="dropdown-item py-2 px-3 fw-bold text-danger d-flex align-items-center justify-content-between" href="/publications"><span><i class="fas fa-book-open text-danger me-2 fa-fw"></i> Publications</span><span class="badge bg-danger rounded-pill small">Online DB</span></a></li>
              <li><a class="dropdown-item py-2 px-3 fw-semibold text-primary d-flex align-items-center justify-content-between" href="/conferences"><span><i class="fas fa-calendar-alt text-primary me-2 fa-fw"></i> Upcoming Conferences</span><span class="badge bg-primary bg-opacity-10 text-primary rounded-pill small">Indexed</span></a></li>
              <li><a class="dropdown-item py-2 px-3 fw-bold text-warning d-flex align-items-center justify-content-between" href="/patents"><span><i class="fas fa-certificate text-warning me-2 fa-fw"></i> Patents &amp; Inventions</span><span class="badge bg-warning text-dark rounded-pill small">57 Patents</span></a></li>
              <li><a class="dropdown-item py-2 px-3 fw-bold text-success active d-flex align-items-center justify-content-between" href="/gallery"><span><i class="fas fa-images text-success me-2 fa-fw"></i> Photo Gallery &amp; Awards</span><span class="badge bg-success rounded-pill small">Current</span></a></li>
            </ul>
          </li>

          <!-- My Campus Menu (Dropdown) -->
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle fw-bold text-dark px-2" href="#" id="galCampusDropdown" role="button" data-bs-toggle="dropdown">
              <i class="fas fa-university text-primary me-1"></i> My Campus
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 py-2 rounded-3" style="min-width: 230px;">
              <li><a class="dropdown-item py-2 px-3 fw-semibold text-dark" href="/#campus"><i class="fas fa-building text-secondary me-2 fa-fw"></i> Campus Infrastructure</a></li>
              <li><a class="dropdown-item py-2 px-3 fw-bold text-danger" href="/#monthly-ros"><i class="fas fa-chart-line text-danger me-2 fa-fw"></i> ROS &amp; Growth</a></li>
              <li><a class="dropdown-item py-2 px-3 fw-semibold text-dark" href="/#top-performers"><i class="fas fa-trophy text-warning me-2 fa-fw"></i> Top Performers</a></li>
              <li><a class="dropdown-item py-2 px-3 fw-semibold text-dark" href="/#top-researchers"><i class="fas fa-user-graduate text-info me-2 fa-fw"></i> Top Faculty Researchers</a></li>
            </ul>
          </li>

          <li class="nav-item">
            <a class="nav-link fw-semibold text-dark text-nowrap px-2" href="/portal">
              <i class="fas fa-users me-1 text-primary"></i> Faculty Directory
            </a>
          </li>

          <% if (isAdmin) { %>
            <li class="nav-item ms-lg-1">
              <div class="d-flex align-items-center gap-1">
                <button type="button" class="btn btn-warning btn-sm fw-bold py-2 px-3 text-nowrap text-dark shadow-sm" data-bs-toggle="modal" data-bs-target="#addGalleryPhotoModal">
                  <i class="fas fa-plus me-1"></i> Add Photo
                </button>
                <form action="/admin/logout" method="POST" class="d-inline">
                  <input type="hidden" name="return_to" value="/gallery">
                  <button type="submit" class="btn btn-outline-danger btn-sm fw-bold py-2 px-2" title="Logout from Admin Mode">
                    <i class="fas fa-sign-out-alt"></i>
                  </button>
                </form>
              </div>
            </li>
          <% } else { %>
            <li class="nav-item ms-lg-1">
              <button class="btn btn-outline-primary btn-sm fw-bold py-2 px-3 rounded-pill text-nowrap" data-bs-toggle="modal" data-bs-target="#adminLoginModal">
                <i class="fas fa-lock me-1"></i> Admin Login
              </button>
            </li>
          <% } %>

          <li class="nav-item ms-lg-1">
            <button type="button" class="btn btn-sm rounded-pill theme-toggle-btn px-2 py-2" title="Toggle Light / Dark Theme" aria-label="Toggle Theme">
              <i class="fas fa-moon theme-icon"></i>
            </button>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Hero Header Section -->
  <div class="page-hero-gallery">
    <div class="container-fluid px-3 px-lg-4">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-4">
        <div>
          <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge bg-warning text-dark fw-bold px-3 py-1">
              <i class="fas fa-camera-retro me-1"></i> UIC Photo Archive &amp; Hall of Fame
            </span>
            <span class="badge bg-white bg-opacity-15 text-light border border-white border-opacity-25 px-2 py-1 small">
              <i class="fas fa-award me-1"></i> Research Excellence &bull; <%= new Date().getFullYear() %>
            </span>
          </div>
          <h1 class="display-font fw-bold text-white mb-2" style="font-size: 2.3rem;">
            UIC Department Photo Gallery
          </h1>
          <p class="text-white text-opacity-80 mb-0" style="max-width: 820px; font-size: 0.95rem;">
            Commemorating moments of excellence: faculty award felicitations, international conferences, patent milestone celebrations, and student hackathon achievements at Chandigarh University.
          </p>
        </div>

        <!-- Metric Stat Cards -->
        <div class="d-flex align-items-center gap-3 flex-wrap">
          <div class="gallery-stat-card text-center">
            <div class="fs-4 fw-bold text-warning display-font"><%= photos.length %></div>
            <div class="small text-white text-opacity-75" style="font-size: 0.72rem;">Total Photos</div>
          </div>
          <div class="gallery-stat-card text-center">
            <div class="fs-4 fw-bold text-success display-font">
              <%= photos.filter(p => p.category === 'awards').length %>
            </div>
            <div class="small text-white text-opacity-75" style="font-size: 0.72rem;">Awards &amp; Honors</div>
          </div>
          <div class="gallery-stat-card text-center">
            <div class="fs-4 fw-bold text-info display-font">
              <%= photos.filter(p => p.category === 'conferences').length %>
            </div>
            <div class="small text-white text-opacity-75" style="font-size: 0.72rem;">Conferences</div>
          </div>
          <div class="gallery-stat-card text-center">
            <div class="fs-4 fw-bold text-warning-emphasis display-font">
              <%= photos.filter(p => p.category === 'patents').length %>
            </div>
            <div class="small text-white text-opacity-75" style="font-size: 0.72rem;">Patents &amp; Labs</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <main class="container-fluid px-3 px-lg-4 py-4">

    <!-- Flash Alerts -->
    <% if (query.added) { %>
      <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2 fs-5 align-middle"></i>
        <strong>Photo Added!</strong> New event photograph has been recorded into the UIC gallery archive.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (query.deleted) { %>
      <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-trash me-2 fs-5 align-middle"></i>
        <strong>Photo Removed!</strong> The photograph has been removed from the gallery.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (query.err) { %>
      <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle me-2 fs-5 align-middle"></i>
        <strong>Error:</strong> <%= query.err %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <!-- Filter & Search Toolbar -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 p-3 bg-white rounded-4 shadow-sm border mb-4">
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <a href="/gallery" class="btn btn-sm <%= currentCategory === 'all' ? 'btn-dark' : 'btn-outline-dark' %> rounded-pill px-3 py-2 fw-semibold">
          <i class="fas fa-layer-group me-1"></i> All Moments (<%= photos.length %>)
        </a>
        <a href="/gallery?category=awards" class="btn btn-sm <%= currentCategory === 'awards' ? 'btn-dark' : 'btn-outline-dark' %> rounded-pill px-3 py-2 fw-semibold">
          <i class="fas fa-trophy text-warning me-1"></i> Awards &amp; Felicitations
        </a>
        <a href="/gallery?category=conferences" class="btn btn-sm <%= currentCategory === 'conferences' ? 'btn-dark' : 'btn-outline-dark' %> rounded-pill px-3 py-2 fw-semibold">
          <i class="fas fa-microphone-alt text-primary me-1"></i> Conferences &amp; Symposia
        </a>
        <a href="/gallery?category=patents" class="btn btn-sm <%= currentCategory === 'patents' ? 'btn-dark' : 'btn-outline-dark' %> rounded-pill px-3 py-2 fw-semibold">
          <i class="fas fa-lightbulb text-warning me-1"></i> Patents &amp; Innovations
        </a>
        <a href="/gallery?category=hackathons" class="btn btn-sm <%= currentCategory === 'hackathons' ? 'btn-dark' : 'btn-outline-dark' %> rounded-pill px-3 py-2 fw-semibold">
          <i class="fas fa-laptop-code text-success me-1"></i> Hackathons &amp; Labs
        </a>
      </div>

      <div class="d-flex align-items-center gap-2">
        <div class="position-relative" style="width: 260px;">
          <input type="text" id="gallerySearchInput" class="form-control form-control-sm rounded-pill ps-4" placeholder="Search event, award, venue...">
          <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-2 text-muted" style="font-size: 0.8rem;"></i>
        </div>
        <% if (isAdmin) { %>
          <button type="button" class="btn btn-warning btn-sm fw-bold rounded-pill px-3 py-2 text-dark shadow-sm text-nowrap" data-bs-toggle="modal" data-bs-target="#addGalleryPhotoModal">
            <i class="fas fa-plus me-1"></i> Add Photo
          </button>
        <% } %>
      </div>
    </div>

    <!-- Gallery Grid -->
    <div class="row g-4" id="galleryGridContainer">
      <% if (photos && photos.length > 0) { %>
        <% photos.forEach((item, idx) => { %>
          <div class="col-12 col-md-6 col-lg-4 col-xl-3 gallery-card-col"
               data-title="<%= item.title.toLowerCase() %>"
               data-venue="<%= (item.venue || '').toLowerCase() %>"
               data-desc="<%= (item.description || '').toLowerCase() %>">
            <div class="card h-100 border-0 rounded-4 overflow-hidden shadow-sm gallery-card bg-white position-relative">
              <!-- Image Wrap with Lightbox Trigger -->
              <div class="gallery-img-wrap position-relative" style="height: 220px; cursor: pointer;" onclick="openPageLightbox(<%= idx %>)">
                <img src="<%= item.image_url %>" alt="<%= item.title %>" class="w-100 h-100 object-fit-cover gallery-img">
                <div class="gallery-overlay d-flex align-items-center justify-content-center position-absolute top-0 start-0 w-100 h-100 bg-dark bg-opacity-40 opacity-0 transition-all">
                  <span class="btn btn-light btn-sm rounded-circle shadow p-2"><i class="fas fa-expand-alt text-dark"></i></span>
                </div>
                <!-- Category Badge -->
                <div class="position-absolute top-0 start-0 m-2">
                  <% if (item.category === 'awards') { %>
                    <span class="badge bg-warning text-dark fw-bold px-2 py-1 shadow-sm"><i class="fas fa-trophy me-1"></i>Award</span>
                  <% } else if (item.category === 'conferences') { %>
                    <span class="badge bg-primary fw-bold px-2 py-1 shadow-sm"><i class="fas fa-users me-1"></i>Conference</span>
                  <% } else if (item.category === 'patents') { %>
                    <span class="badge bg-success fw-bold px-2 py-1 shadow-sm"><i class="fas fa-certificate me-1"></i>Patent</span>
                  <% } else { %>
                    <span class="badge bg-info text-dark fw-bold px-2 py-1 shadow-sm"><i class="fas fa-code me-1"></i>Hackathon</span>
                  <% } %>
                </div>
              </div>

              <!-- Card Body -->
              <div class="card-body p-3 d-flex flex-column">
                <h6 class="fw-bold mb-1 text-dark" style="font-size: 0.95rem; line-height: 1.35; min-height: 2.6rem;">
                  <%= item.title %>
                </h6>
                <div class="d-flex align-items-center gap-2 text-muted small mb-2" style="font-size: 0.75rem;">
                  <span><i class="far fa-calendar-alt text-primary me-1"></i><%= item.event_date %></span>
                  <span>&bull;</span>
                  <span class="text-truncate" title="<%= item.venue %>"><i class="fas fa-map-marker-alt text-danger me-1"></i><%= item.venue %></span>
                </div>
                <p class="text-muted small mb-3 flex-grow-1" style="font-size: 0.78rem; line-height: 1.4;">
                  <%= item.description %>
                </p>

                <div class="pt-2 border-top d-flex align-items-center justify-content-between">
                  <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 py-1 fw-semibold" style="font-size: 0.75rem;" onclick="openPageLightbox(<%= idx %>)">
                    <i class="fas fa-eye me-1"></i> View HD
                  </button>
                  <% if (isAdmin) { %>
                    <form action="/gallery/<%= item.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this photograph from the gallery?')">
                      <input type="hidden" name="return_to" value="/gallery">
                      <button type="submit" class="btn btn-outline-danger btn-sm py-1 px-2 rounded-pill" title="Delete Photo">
                        <i class="fas fa-trash-alt"></i>
                      </button>
                    </form>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-12 py-5 text-center text-muted">
          <i class="fas fa-images fa-3x mb-3 text-secondary opacity-50"></i>
          <h5>No photographs found in this category</h5>
          <p class="small">Try switching categories or clear your search query.</p>
        </div>
      <% } %>
    </div>
  </main>

  <!-- Interactive Lightbox Modal -->
  <div class="modal fade" id="pageLightboxModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content border-0 rounded-4 overflow-hidden shadow-lg bg-dark text-white">
        <div class="position-relative">
          <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3 z-3" data-bs-dismiss="modal"></button>
          <img id="pageLightboxImg" src="" alt="Gallery Preview" class="w-100 object-fit-contain" style="max-height: 520px; background: #000;">
          <button type="button" class="btn btn-dark bg-opacity-50 text-white position-absolute top-50 start-0 translate-middle-y ms-2 rounded-circle" id="pageLightboxPrevBtn" style="width: 44px; height: 44px;">
            <i class="fas fa-chevron-left"></i>
          </button>
          <button type="button" class="btn btn-dark bg-opacity-50 text-white position-absolute top-50 end-0 translate-middle-y me-2 rounded-circle" id="pageLightboxNextBtn" style="width: 44px; height: 44px;">
            <i class="fas fa-chevron-right"></i>
          </button>
        </div>
        <div class="modal-body p-4 bg-dark">
          <div class="d-flex align-items-center gap-2 mb-2">
            <span id="pageLightboxCategory" class="badge bg-warning text-dark fw-bold"></span>
            <span id="pageLightboxDate" class="small text-light text-opacity-75"></span>
            <span class="text-light text-opacity-50">&bull;</span>
            <span id="pageLightboxVenue" class="small text-light text-opacity-75"></span>
          </div>
          <h4 id="pageLightboxTitle" class="fw-bold mb-2 text-white"></h4>
          <p id="pageLightboxDesc" class="text-light text-opacity-75 small mb-0"></p>
        </div>
      </div>
    </div>
  </div>

  <% if (isAdmin) { %>
    <!-- Add Gallery Photo Modal (Admin Only) -->
    <div class="modal fade" id="addGalleryPhotoModal" tabindex="-1">
      <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
          <form action="/gallery/add" method="POST" enctype="multipart/form-data">
            <div class="modal-header bg-warning text-dark">
              <h5 class="modal-title fw-bold"><i class="fas fa-camera-retro me-2"></i>Add Photo to UIC Gallery</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
              <div class="row g-3 mb-3">
                <div class="col-md-8">
                  <label class="form-label fw-bold">Event / Award Title <span class="text-danger">*</span></label>
                  <input type="text" name="title" class="form-control" placeholder="e.g. National Research Excellence Award 2026" required>
                </div>
                <div class="col-md-4">
                  <label class="form-label fw-bold">Category <span class="text-danger">*</span></label>
                  <select name="category" class="form-select" required>
                    <option value="awards">Awards &amp; Felicitations</option>
                    <option value="conferences">Conferences &amp; Symposia</option>
                    <option value="patents">Patents &amp; Innovations</option>
                    <option value="hackathons">Hackathons &amp; Labs</option>
                  </select>
                </div>
              </div>

              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label fw-bold">Date / Month</label>
                  <input type="text" name="event_date" class="form-control" placeholder="e.g. October 2026">
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-bold">Venue / Campus Location</label>
                  <input type="text" name="venue" class="form-control" placeholder="e.g. Main University Auditorium">
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label fw-bold">Upload Photograph File <span class="text-danger">*</span></label>
                <input type="file" name="gallery_file" class="form-control" accept="image/*">
                <div class="form-text small">Upload high-res JPG, PNG, or WEBP image. Alternatively provide an image URL below.</div>
              </div>

              <div class="mb-3">
                <label class="form-label fw-bold">Or Image URL</label>
                <input type="url" name="image_url" class="form-control" placeholder="https://...">
              </div>

              <div class="mb-3">
                <label class="form-label fw-bold">Description / Citation</label>
                <textarea name="description" class="form-control" rows="3" placeholder="Brief summary of the honor, keynote, or student achievement..."></textarea>
              </div>

              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="featured" id="galFeaturedCheck" value="1" checked>
                <label class="form-check-label fw-semibold" for="galFeaturedCheck">
                  Feature in Homepage Showcase
                </label>
              </div>
            </div>
            <div class="modal-footer bg-light">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-warning fw-bold text-dark"><i class="fas fa-upload me-1"></i>Save Photo to Gallery</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  <% } else { %>
    <!-- Admin Login Modal -->
    <div class="modal fade" id="adminLoginModal" tabindex="-1">
      <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">
          <form action="/admin/login" method="POST">
            <input type="hidden" name="return_to" value="/gallery">
            <div class="modal-header bg-danger text-white">
              <h6 class="modal-title fw-bold"><i class="fas fa-lock me-2"></i>Admin Authentication</h6>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3">
              <div class="mb-3">
                <label class="form-label small fw-bold">Username</label>
                <input type="text" name="username" class="form-control form-control-sm" required autofocus>
              </div>
              <div class="mb-3">
                <label class="form-label small fw-bold">Password</label>
                <input type="password" name="password" class="form-control form-control-sm" required>
              </div>
              <button type="submit" class="btn btn-danger btn-sm w-100 fw-bold">Sign In as Admin</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Modern Footer -->
  <footer class="cu-footer py-5 mt-5" style="background: #090e17; color: #94a3b8; border-top: 2px solid #c8102e;">
    <div class="container">
      <div class="row g-4 pb-4">
        <div class="col-lg-5">
          <div class="d-flex align-items-center gap-2 mb-3">
            <div class="brand-logo-badge py-1 px-3 fs-6">UIC</div>
            <span class="fw-bold text-white fs-5 display-font">UIC Research Portal</span>
          </div>
          <p class="small text-muted mb-0">
            University Institute of Computing (UIC), Chandigarh University. Excellence in academic computing research, patents, Scopus indexed publications, and student innovation.
          </p>
        </div>
        <div class="col-lg-3 col-md-6">
          <h6 class="text-white fw-bold mb-3">Research Quick Links</h6>
          <ul class="list-unstyled small d-flex flex-column gap-2 mb-0">
            <li><a href="/" class="text-light text-decoration-none"><i class="fas fa-angle-right me-1 text-danger"></i> Home &amp; About</a></li>
            <li><a href="/publications" class="text-light text-decoration-none"><i class="fas fa-angle-right me-1 text-danger"></i> Publications Database</a></li>
            <li><a href="/patents" class="text-light text-decoration-none"><i class="fas fa-angle-right me-1 text-danger"></i> Patents &amp; Inventions</a></li>
            <li><a href="/conferences" class="text-light text-decoration-none"><i class="fas fa-angle-right me-1 text-danger"></i> Upcoming Conferences</a></li>
            <li><a href="/portal" class="text-light text-decoration-none"><i class="fas fa-angle-right me-1 text-danger"></i> Faculty Directory</a></li>
          </ul>
        </div>
        <div class="col-lg-4 col-md-6">
          <h6 class="text-white fw-bold mb-3">Campus Information</h6>
          <div class="small d-flex flex-column gap-2">
            <div><i class="fas fa-map-marker-alt text-danger me-2"></i> NH-95, Chandigarh-Ludhiana Highway, Mohali, Punjab 140413</div>
            <div><i class="fas fa-envelope text-primary me-2"></i> info@cuchd.in | research.uic@cumail.in</div>
            <div><i class="fas fa-award text-warning me-2"></i> NAAC A+ Accredited &bull; QS World Ranked</div>
          </div>
        </div>
      </div>
      <div class="border-top border-secondary border-opacity-25 pt-3 text-center small text-muted">
        &copy; <%= new Date().getFullYear() %> <strong>University Institute of Computing (UIC), Chandigarh University</strong>. All Rights Reserved.
      </div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const allGalleryItems = <%- JSON.stringify(photos || []) %>;
    let pageCurrentIdx = 0;
    const pageLightboxModalEl = document.getElementById('pageLightboxModal');
    const pageLightboxModal = pageLightboxModalEl ? new bootstrap.Modal(pageLightboxModalEl) : null;

    function openPageLightbox(idx) {
      if (!allGalleryItems || !allGalleryItems[idx]) return;
      pageCurrentIdx = idx;
      updatePageLightbox();
      if (pageLightboxModal) pageLightboxModal.show();
    }

    function updatePageLightbox() {
      const item = allGalleryItems[pageCurrentIdx];
      if (!item) return;
      document.getElementById('pageLightboxImg').src = item.image_url;
      document.getElementById('pageLightboxTitle').textContent = item.title;
      document.getElementById('pageLightboxCategory').textContent = (item.category || '').toUpperCase();
      document.getElementById('pageLightboxDate').textContent = item.event_date || '';
      document.getElementById('pageLightboxVenue').textContent = item.venue || '';
      document.getElementById('pageLightboxDesc').textContent = item.description || '';
    }

    const prevBtn = document.getElementById('pageLightboxPrevBtn');
    const nextBtn = document.getElementById('pageLightboxNextBtn');
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        if (allGalleryItems.length === 0) return;
        pageCurrentIdx = (pageCurrentIdx - 1 + allGalleryItems.length) % allGalleryItems.length;
        updatePageLightbox();
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        if (allGalleryItems.length === 0) return;
        pageCurrentIdx = (pageCurrentIdx + 1) % allGalleryItems.length;
        updatePageLightbox();
      });
    }

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (!pageLightboxModalEl || !pageLightboxModalEl.classList.contains('show')) return;
      if (e.key === 'ArrowLeft' && prevBtn) prevBtn.click();
      if (e.key === 'ArrowRight' && nextBtn) nextBtn.click();
    });

    // Real-time search filter
    const searchInput = document.getElementById('gallerySearchInput');
    const cardCols = document.querySelectorAll('.gallery-card-col');
    if (searchInput) {
      searchInput.addEventListener('input', function() {
        const q = this.value.trim().toLowerCase();
        cardCols.forEach(col => {
          const t = col.dataset.title || '';
          const v = col.dataset.venue || '';
          const d = col.dataset.desc || '';
          const match = !q || t.includes(q) || v.includes(q) || d.includes(q);
          col.style.display = match ? '' : 'none';
        });
      });
    }
  </script>
</body>
</html>
