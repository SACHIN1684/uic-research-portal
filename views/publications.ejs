  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    let activeMonthFilter = '<%= filters.month || "all" %>';
    let activeYearFilter = '<%= filters.year || "all" %>';

    function selectYearFilter(year, btnElem) {
      activeYearFilter = year;
      document.querySelectorAll('.year-pill-btn').forEach(b => {
        b.classList.remove('active');
        const badge = b.querySelector('.badge');
        if (badge) {
          badge.className = 'badge bg-light text-dark border rounded-pill';
        }
      });
      if (btnElem) {
        btnElem.classList.add('active');
        const activeBadge = btnElem.querySelector('.badge');
        if (activeBadge) {
          activeBadge.className = 'badge bg-danger rounded-pill';
        }
      }
      const ySelect = document.getElementById('yearSelect');
      if (ySelect) ySelect.value = year;

      // Update Top Banner subtitle
      const bannerText = document.getElementById('bannerYearText');
      if (bannerText) {
        bannerText.textContent = year === 'all' ? 'All Academic Sessions' : 'Academic Session ' + year;
      }

      // Update URL query state cleanly without full reload
      try {
        const url = new URL(window.location);
        if (year === 'all') url.searchParams.delete('year');
        else url.searchParams.set('year', year);
        window.history.replaceState({}, '', url);
      } catch (e) {}

      filterTable();
    }

    function onYearSelectChange() {
      const select = document.getElementById('yearSelect');
      if (!select) return;
      const val = select.value;
      const btn = document.querySelector(`.year-pill-btn[data-year="${val}"]`) || document.querySelector(`.year-pill-btn[data-year="all"]`);
      selectYearFilter(val, btn);
    }

    function selectMonthFilter(month, btnElem) {
      activeMonthFilter = month;
      document.querySelectorAll('.month-pill-btn').forEach(b => {
        b.classList.remove('active');
        const badge = b.querySelector('.badge');
        if (badge) {
          badge.className = 'badge bg-light text-dark border rounded-pill';
        }
      });
      if (btnElem) {
        btnElem.classList.add('active');
        const activeBadge = btnElem.querySelector('.badge');
        if (activeBadge) {
          activeBadge.className = 'badge bg-danger rounded-pill';
        }
      }
      filterTable();
    }

    function filterTable() {
      const searchVal = (document.getElementById('liveSearchInput').value || '').toLowerCase().trim();
      const yearVal = (activeYearFilter || 'all').toLowerCase();
      const quartileVal = (document.getElementById('quartileSelect').value || 'all').toUpperCase();
      const deptVal = (document.getElementById('deptSelect').value || 'all').toLowerCase();
      const monthVal = (activeMonthFilter || 'all').toLowerCase();

      const rows = document.querySelectorAll('.pub-data-row');
      let visibleCount = 0;
      let kpiUnique = 0;
      let kpiTotal = 0;
      let kpiQ1 = 0;
      let kpiQ2 = 0;
      let kpiQ3Q4 = 0;
      let kpiUic = 0;
      const visibleMonths = new Set();
      const monthRowCounts = {};

      rows.forEach(row => {
        const rowSearch = row.getAttribute('data-search') || '';
        const rowMonth = (row.getAttribute('data-month') || '').toLowerCase();
        const rowYear = (row.getAttribute('data-year') || '').toLowerCase();
        const rowCalYear = (row.getAttribute('data-calendar-year') || '').toLowerCase();
        const rowQuartile = (row.getAttribute('data-quartile') || '').toUpperCase();
        const rowDept = (row.getAttribute('data-department') || '').toLowerCase();
        const isCoAuthor = row.getAttribute('data-is-coauthor') === '1';
        const isUic = row.getAttribute('data-is-uic') === '1';

        // Year Matching
        let matchesYear = true;
        if (yearVal !== 'all') {
          matchesYear = (rowYear === yearVal) || (rowCalYear === yearVal) || rowYear.includes(yearVal);
        }

        const matchesSearch = !searchVal || rowSearch.includes(searchVal);
        const matchesMonth = (monthVal === 'all') || (rowMonth === monthVal);
        const matchesQuartile = (quartileVal === 'ALL') || (rowQuartile === quartileVal);

        let matchesDept = true;
        if (deptVal === 'uic') {
          matchesDept = isUic || rowDept.includes('uic');
        } else if (deptVal === 'other') {
          matchesDept = !isUic && !rowDept.includes('uic');
        } else if (deptVal !== 'all') {
          matchesDept = rowDept.includes(deptVal);
        }

        if (matchesYear && matchesSearch && matchesMonth && matchesQuartile && matchesDept) {
          row.style.display = '';
          visibleCount++;
          kpiTotal++;
          if (!isCoAuthor) kpiUnique++;
          if (rowQuartile === 'Q1') kpiQ1++;
          else if (rowQuartile === 'Q2') kpiQ2++;
          else if (rowQuartile === 'Q3' || rowQuartile === 'Q4') kpiQ3Q4++;
          if (isUic) kpiUic++;

          const rawMonth = row.getAttribute('data-month');
          if (rawMonth) {
            visibleMonths.add(rawMonth);
            monthRowCounts[rawMonth] = (monthRowCounts[rawMonth] || 0) + 1;
          }
        } else {
          row.style.display = 'none';
        }
      });

      // Update month divider headers and counts
      document.querySelectorAll('.month-divider-row').forEach(header => {
        const monthName = header.getAttribute('data-month-name');
        if (visibleMonths.has(monthName) && monthVal === 'all') {
          header.style.display = '';
          const badge = header.querySelector('.month-header-badge');
          if (badge) badge.textContent = `${monthRowCounts[monthName] || 0} Records`;
        } else {
          header.style.display = 'none';
        }
      });

      // Update KPI card figures
      const elUnique = document.getElementById('kpiUniquePapers');
      const elTotal = document.getElementById('kpiTotalRecords');
      const elQ1 = document.getElementById('kpiQ1Count');
      const elQ2 = document.getElementById('kpiQ2Count');
      const elQ3Q4 = document.getElementById('kpiQ3Q4Count');
      const elUic = document.getElementById('kpiUicCount');

      if (elUnique) elUnique.textContent = kpiUnique;
      if (elTotal) elTotal.textContent = kpiTotal;
      if (elQ1) elQ1.textContent = kpiQ1;
      if (elQ2) elQ2.textContent = kpiQ2;
      if (elQ3Q4) elQ3Q4.textContent = kpiQ3Q4;
      if (elUic) elUic.textContent = kpiUic;

      // Update count indicators
      const countDisplay = document.getElementById('visibleCount');
      if (countDisplay) countDisplay.textContent = visibleCount;
      const baseCountDisplay = document.getElementById('totalFilterBaseCount');
      if (baseCountDisplay) baseCountDisplay.textContent = kpiTotal;

      updateSelectionToolbar();
    }

    function clearSearch() {
      document.getElementById('liveSearchInput').value = '';
      filterTable();
    }

    function resetAllFilters() {
      document.getElementById('liveSearchInput').value = '';
      document.getElementById('quartileSelect').value = 'all';
      document.getElementById('deptSelect').value = 'all';
      const allYearBtn = document.querySelector('.year-pill-btn[data-year="all"]');
      if (allYearBtn) selectYearFilter('all', allYearBtn);
      else {
        activeYearFilter = 'all';
        const ySelect = document.getElementById('yearSelect');
        if (ySelect) ySelect.value = 'all';
      }
      const allMonthBtn = document.querySelector('.month-pill-btn[data-month="all"]');
      if (allMonthBtn) {
        selectMonthFilter('all', allMonthBtn);
      } else {
        activeMonthFilter = 'all';
        filterTable();
      }
    }

    // Initial run on page load if preset
    document.addEventListener('DOMContentLoaded', () => {
      if ((activeYearFilter && activeYearFilter !== 'all') || (activeMonthFilter && activeMonthFilter !== 'all')) {
        filterTable();
      }
    });

    // ─── MULTI-SELECT & BULK ACTIONS ──────────────────────────────────
    function toggleSelectAll(masterCheckbox) {
      const isChecked = masterCheckbox.checked;
      const rows = document.querySelectorAll('.pub-data-row');
      rows.forEach(r => {
        if (r.style.display !== 'none') {
          const chk = r.querySelector('.pub-select-check');
          if (chk) chk.checked = isChecked;
        }
      });
      updateSelectionToolbar();
    }

    function onRowSelectChange() {
      updateSelectionToolbar();
    }

    function clearAllSelections() {
      document.querySelectorAll('.pub-select-check').forEach(c => c.checked = false);
      const master = document.getElementById('selectAllCheckbox');
      if (master) master.checked = false;
      updateSelectionToolbar();
    }

    function getSelectedIds() {
      const selected = [];
      document.querySelectorAll('.pub-select-check:checked').forEach(c => {
        selected.push(c.value);
      });
      return selected;
    }

    function updateSelectionToolbar() {
      const selected = getSelectedIds();
      const toolbar = document.getElementById('selectionToolbar');
      const countSpan = document.getElementById('selectedCount');
      if (countSpan) countSpan.textContent = selected.length;
      if (toolbar) {
        if (selected.length > 0) {
          toolbar.classList.remove('d-none');
          toolbar.classList.add('d-flex');
        } else {
          toolbar.classList.add('d-none');
          toolbar.classList.remove('d-flex');
        }
      }
    }

    function openBulkDeleteModal() {
      const selected = getSelectedIds();
      if (selected.length === 0) {
        alert('Please select at least one publication to delete.');
        return;
      }
      document.getElementById('bulkDeleteIdsInput').value = selected.join(',');
      document.getElementById('bulkDeleteCountText').textContent = selected.length;
      bootstrap.Modal.getOrCreateInstance(document.getElementById('bulkDeleteModal')).show();
    }

    // ─── SINGLE ROW EDIT & DELETE MODALS ─────────────────────────────
    async function openEditModal(pubId) {
      try {
        const modalAlert = document.getElementById('editModalAlert');
        if (modalAlert) { modalAlert.classList.add('d-none'); modalAlert.textContent = ''; }

        const res = await fetch('/api/publications/' + pubId);
        const data = await res.json();
        if (!data.ok || !data.publication) {
          alert('Could not load publication details: ' + (data.error || 'Not found'));
          return;
        }
        const p = data.publication;
        document.getElementById('editPubForm').action = '/publications/' + pubId + '/edit';
        document.getElementById('edit_pub_id').value = pubId;
        document.getElementById('edit_id').value = pubId;

        document.getElementById('edit_month_section').value = p.month_section || 'January';
        document.getElementById('edit_sr_no').value = p.sr_no || '';
        document.getElementById('edit_title').value = p.title || '';
        document.getElementById('edit_year').value = p.academic_year || p.year || '2025-26';
        document.getElementById('edit_source_title').value = p.source_title || '';
        document.getElementById('edit_author_name').value = p.author_name || '';
        document.getElementById('edit_scopus_id').value = p.scopus_id || '';
        document.getElementById('edit_cluster').value = p.cluster || 'Engineering';
        document.getElementById('edit_institute').value = p.institute || 'UIC';
        document.getElementById('edit_department').value = p.department || 'UIC';
        document.getElementById('edit_ros').value = p.ros || '';
        document.getElementById('edit_quartile').value = p.quartile || 'Q1';
        document.getElementById('edit_doi').value = p.doi || '';
        document.getElementById('edit_link').value = p.link || '';
        document.getElementById('edit_document_type').value = p.document_type || 'Article';
        document.getElementById('edit_eid').value = p.eid || '';
        document.getElementById('edit_scopus_link').value = p.scopus_link || '';
        document.getElementById('edit_apn').value = p.apn || '';

        const notice = document.getElementById('editCoAuthorNotice');
        if (notice) {
          if (!p.sr_no) {
            notice.classList.remove('d-none');
          } else {
            notice.classList.add('d-none');
          }
        }

        bootstrap.Modal.getOrCreateInstance(document.getElementById('editPubModal')).show();
      } catch (e) {
        alert('Error fetching publication: ' + e.message);
      }
    }

    // Handle AJAX Form Submission for Editing
    document.getElementById('editPubForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      const pubId = document.getElementById('edit_pub_id').value || document.getElementById('edit_id').value;
      const submitBtn = this.querySelector('button[type="submit"]');
      const originalBtnHtml = submitBtn.innerHTML;
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving...';

      const modalAlert = document.getElementById('editModalAlert');
      if (modalAlert) modalAlert.classList.add('d-none');

      try {
        const formData = new FormData(this);
        const dataObj = Object.fromEntries(formData.entries());

        const res = await fetch('/publications/' + pubId + '/edit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(dataObj)
        });

        const result = await res.json();
        if (!result.ok) {
          throw new Error(result.error || 'Server error saving changes');
        }

        const p = result.publication;

        // Hide modal
        bootstrap.Modal.getOrCreateInstance(document.getElementById('editPubModal')).hide();

        // Update DOM row in real-time
        updateRowInDOM(pubId, p);

        // Show toast notification
        showToast('Publication #' + (p.sr_no || p.id) + ' updated and saved successfully!', 'success');

      } catch (err) {
        console.error('Save failed:', err);
        if (modalAlert) {
          modalAlert.textContent = 'Failed to save changes: ' + err.message;
          modalAlert.classList.remove('d-none');
        } else {
          alert('Failed to save changes: ' + err.message);
        }
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalBtnHtml;
      }
    });

    function updateRowInDOM(pubId, p) {
      const tr = document.querySelector('tr[data-pub-id="' + pubId + '"]');
      if (!tr) return;

      // Update data attributes for live filtering
      tr.setAttribute('data-month', p.month_section || '');
      tr.setAttribute('data-quartile', (p.quartile || '').toUpperCase());
      tr.setAttribute('data-department', (p.department || '').toUpperCase());
      tr.setAttribute('data-search', [
        p.title, p.author_name, p.source_title, p.scopus_id, p.doi, p.apn, p.eid, p.department, p.month_section
      ].join(' ').toLowerCase());

      const cells = tr.querySelectorAll('td');
      // cells[0]: Checkbox
      // cells[1]: Actions
      // cells[2]: 1. Sr. No.
      if (cells[2]) {
        cells[2].innerHTML = p.sr_no
          ? '<span class="badge bg-dark bg-opacity-75 text-white px-2 py-1">' + escapeHtml(p.sr_no) + '</span>'
          : '<span class="badge bg-light text-secondary border small" title="Co-author continuation row">↳ Co</span>';
      }
      // cells[3]: 2. Title
      if (cells[3]) {
        cells[3].innerHTML = p.title
          ? '<div class="fw-semibold text-dark" style="line-height: 1.35;">' + escapeHtml(p.title) + '</div>'
          : '<span class="text-muted fst-italic small">↳ (Shared paper continuation row)</span>';
      }
      // cells[4]: 3. Year
      if (cells[4]) {
        cells[4].textContent = p.year || '';
      }
      // cells[5]: 4. Source title
      if (cells[5]) {
        cells[5].innerHTML = '<span class="text-dark small">' + escapeHtml(p.source_title || '—') + '</span>';
      }
      // cells[6]: 5. Author names (CU)
      if (cells[6]) {
        cells[6].innerHTML = '<div class="fw-bold text-dark d-flex align-items-center gap-1"><i class="fas fa-user-circle text-secondary small"></i><span>' + escapeHtml(p.author_name || '—') + '</span></div>';
      }
      // cells[7]: 6. Scopus ID
      if (cells[7]) {
        cells[7].innerHTML = p.scopus_id
          ? '<a href="https://www.scopus.com/authid/detail.uri?authorId=' + encodeURIComponent(p.scopus_id) + '" target="_blank" class="badge bg-light text-dark border text-decoration-none" title="View Scopus Author Profile"><i class="fas fa-id-badge text-warning me-1"></i>' + escapeHtml(p.scopus_id) + '</a>'
          : '<span class="text-muted small">—</span>';
      }
      // cells[8]: 7. Cluster
      if (cells[8]) {
        cells[8].innerHTML = '<span class="small text-muted">' + escapeHtml(p.cluster || 'Engineering') + '</span>';
      }
      // cells[9]: 8. Institute
      if (cells[9]) {
        cells[9].innerHTML = '<span class="badge bg-secondary bg-opacity-10 text-secondary border">' + escapeHtml(p.institute || 'UIC') + '</span>';
      }
      // cells[10]: 9. Department
      if (cells[10]) {
        const isUic = (p.department || '').toUpperCase().includes('UIC');
        cells[10].innerHTML = isUic
          ? '<span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle fw-semibold">UIC</span>'
          : '<span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle fw-semibold">' + escapeHtml(p.department || 'Other') + '</span>';
      }
      // cells[11]: 10. ROS
      if (cells[11]) {
        cells[11].innerHTML = '<span class="badge bg-light text-dark border fw-bold px-2 py-1">' + escapeHtml(p.ros || '0') + '</span>';
      }
      // cells[12]: 11. Quartile
      if (cells[12]) {
        const qUpper = (p.quartile || '').toUpperCase();
        const qClass = 'q-badge-' + (qUpper || 'NA');
        cells[12].innerHTML = qUpper
          ? '<span class="badge ' + qClass + ' fw-bold">' + escapeHtml(qUpper) + '</span>'
          : '<span class="badge bg-light text-muted border">N/A</span>';
      }
      // cells[13]: 12. DOI
      if (cells[13]) {
        if (p.doi && (p.doi.startsWith('10.') || p.doi.startsWith('http'))) {
          const doiUrl = p.doi.startsWith('http') ? p.doi : ('https://doi.org/' + p.doi);
          cells[13].innerHTML = '<a href="' + escapeHtml(doiUrl) + '" target="_blank" class="truncate-text text-decoration-none text-primary small" title="' + escapeHtml(p.doi) + '"><i class="fas fa-external-link-alt me-1 text-muted" style="font-size: 0.7rem;"></i>' + escapeHtml(p.doi) + '</a>';
        } else if (p.doi) {
          cells[13].innerHTML = '<span class="truncate-text small text-muted" title="' + escapeHtml(p.doi) + '">' + escapeHtml(p.doi) + '</span>';
        } else {
          cells[13].innerHTML = '<span class="text-muted small">—</span>';
        }
      }
      // cells[14]: 13. Link
      if (cells[14]) {
        cells[14].innerHTML = (p.link && p.link.startsWith('http'))
          ? '<a href="' + escapeHtml(p.link) + '" target="_blank" class="btn btn-outline-primary btn-sm py-0 px-2" title="Open Scopus Record"><i class="fas fa-link"></i></a>'
          : (p.link ? '<span class="small text-muted">' + escapeHtml(p.link) + '</span>' : '<span class="text-muted small">—</span>');
      }

      // Visual highlight animation
      tr.style.transition = 'background-color 0.4s ease';
      const originalBg = tr.style.backgroundColor;
      tr.style.backgroundColor = '#d1e7dd';
      setTimeout(() => {
        tr.style.backgroundColor = originalBg;
      }, 2500);

      tr.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function showToast(msg, type = 'success') {
      const toastEl = document.getElementById('liveToast');
      const toastMsg = document.getElementById('toastMessage');
      if (!toastEl || !toastMsg) return;
      toastEl.className = 'toast align-items-center text-white border-0 shadow ' + (type === 'success' ? 'bg-success' : 'bg-danger');
      toastMsg.innerHTML = (type === 'success' ? '<i class="fas fa-check-circle me-2"></i>' : '<i class="fas fa-exclamation-triangle me-2"></i>') + msg;
      bootstrap.Toast.getOrCreateInstance(toastEl).show();
    }

    function openDeleteModal(pubId, srNo, encodedTitle) {
      const title = decodeURIComponent(encodedTitle || '');
      document.getElementById('deletePubForm').action = '/publications/' + pubId + '/delete';
      document.getElementById('deletePubMsg').innerHTML = 
        'Are you sure you want to delete publication <strong>#' + srNo + ' &mdash; ' + title + '</strong>?<br><span class="text-danger small">This action will be synchronized with the database and Excel file.</span>';
      bootstrap.Modal.getOrCreateInstance(document.getElementById('deletePubModal')).show();
    }

    // Handle AJAX Form Submission for Delete
    document.getElementById('deletePubForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      const action = this.action;
      const submitBtn = this.querySelector('button[type="submit"]');
      const originalBtnHtml = submitBtn.innerHTML;
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Deleting...';

      try {
        const res = await fetch(action, {
          method: 'POST',
          headers: { 'Accept': 'application/json' }
        });
        const result = await res.json();
        if (!result.ok) throw new Error(result.error || 'Server error deleting entry');

        bootstrap.Modal.getOrCreateInstance(document.getElementById('deletePubModal')).hide();

        // Extract pubId from action URL
        const match = action.match(/\/publications\/(\d+)\/delete/);
        if (match && match[1]) {
          const tr = document.querySelector('tr[data-pub-id="' + match[1] + '"]');
          if (tr) {
            tr.style.transition = 'all 0.4s ease';
            tr.style.opacity = '0';
            tr.style.transform = 'translateX(-30px)';
            setTimeout(() => tr.remove(), 400);
          }
        }
        showToast('Publication entry deleted successfully!', 'success');
      } catch (err) {
        console.error('Delete failed:', err);
        alert('Failed to delete: ' + err.message);
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalBtnHtml;
      }
    });

    function exportCurrentView() {
      const table = document.getElementById('masterTable');
      if (!table) return;

      const wb = XLSX.utils.book_new();
      const exportRows = [];

      // Headers (skip first 2 columns: checkbox & actions)
      const ths = Array.from(table.querySelectorAll('thead th')).slice(2).map(th => th.innerText.trim());
      exportRows.push(ths);

      // Visible rows
      const rows = table.querySelectorAll('tbody tr.pub-data-row');
      rows.forEach(tr => {
        if (tr.style.display !== 'none') {
          const cells = Array.from(tr.querySelectorAll('td')).slice(2).map(td => td.innerText.trim());
          exportRows.push(cells);
        }
      });

      const ws = XLSX.utils.aoa_to_sheet(exportRows);
      XLSX.utils.book_append_sheet(wb, ws, 'Published Papers Filtered');
      XLSX.writeFile(wb, 'UIC_Publications_Export.xlsx');
    }
  </script>

  <!-- Live Toast Container -->
  <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;">
    <div id="liveToast" class="toast align-items-center text-white bg-success border-0 shadow" role="alert" aria-live="assertive" aria-atomic="true">
      <div class="d-flex">
        <div class="toast-body fw-semibold" id="toastMessage">
          <i class="fas fa-check-circle me-2"></i> Action completed successfully!
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
      </div>
    </div>
  </div>
  </script>
</body>
</html>
