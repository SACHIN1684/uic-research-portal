<%
const initials = faculty.name.split(' ').map(w => w[0]).join('').substring(0, 2).toUpperCase();
const rc = rosColor(faculty.ros);
const rl = rosLabel(faculty.ros);
const rosPercent = Math.min(Math.round(faculty.ros * 100), 100);
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= faculty.name %> — UIC Research Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark portal-nav">
  <div class="container-fluid px-4">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/portal">
      <div class="brand-icon"><i class="fas fa-flask"></i></div>
      <div>
        <div class="brand-title">UIC Research Portal</div>
        <div class="brand-sub">University Institute of Computing, Chandigarh University</div>
      </div>
    </a>
    <div class="ms-auto d-flex align-items-center gap-2 flex-wrap">
      <a href="/" class="btn btn-outline-light btn-sm"><i class="fas fa-home me-1"></i>Home</a>
      <a href="/portal" class="nav-link-btn"><i class="fas fa-th-large me-1"></i>Directory</a>
      <% if (isAdmin) { %>
        <div class="btn-group btn-group-sm shadow-sm" role="group" aria-label="Undo Redo">
          <form action="/admin/undo" method="POST" class="d-inline">
            <input type="hidden" name="return_to" value="/faculty/<%= faculty.id %>">
            <button type="submit" class="btn btn-outline-light btn-sm fw-semibold" <%= !historyStatus.canUndo ? 'disabled' : '' %> title="<%= historyStatus.canUndo ? 'Undo: ' + historyStatus.undoLabel : 'Nothing to Undo' %>">
              <i class="fas fa-undo me-1"></i>Undo
            </button>
          </form>
          <form action="/admin/redo" method="POST" class="d-inline">
            <input type="hidden" name="return_to" value="/faculty/<%= faculty.id %>">
            <button type="submit" class="btn btn-outline-light btn-sm fw-semibold" <%= !historyStatus.canRedo ? 'disabled' : '' %> title="<%= historyStatus.canRedo ? 'Redo: ' + historyStatus.redoLabel : 'Nothing to Redo' %>">
              <i class="fas fa-redo me-1"></i>Redo
            </button>
          </form>
        </div>
        <a href="/export/excel" class="btn btn-success btn-sm">
          <i class="fas fa-file-excel me-1"></i>Export Excel
        </a>
        <a href="/faculty/add" class="btn btn-add btn-sm">
          <i class="fas fa-user-plus me-1"></i>Add Faculty
        </a>
        <form action="/admin/logout" method="POST" class="d-inline">
          <input type="hidden" name="return_to" value="/faculty/<%= faculty.id %>">
          <button type="submit" class="btn btn-outline-danger btn-sm fw-semibold" title="Logout Admin">
            <i class="fas fa-sign-out-alt me-1"></i>Logout
          </button>
        </form>
      <% } else { %>
        <span class="badge bg-light text-dark py-2 px-3">
          <i class="fas fa-eye text-primary me-1"></i>Read-Only View
        </span>
        <button type="button" class="btn btn-warning btn-sm fw-bold text-dark" data-bs-toggle="modal" data-bs-target="#detailAdminLoginModal">
          <i class="fas fa-user-shield me-1"></i>Admin Login
        </button>
      <% } %>
    </div>
  </div>
</nav>

<main class="main-content">
  <div class="container" style="max-width:1150px;">

    <!-- Alerts -->
    <% if (query.undo_done) { %>
      <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-undo me-2 fs-5 align-middle"></i>
        <strong>Undo Complete:</strong> Reverted "<%= query.undo_done %>".
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (query.redo_done) { %>
      <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-redo me-2 fs-5 align-middle"></i>
        <strong>Redo Complete:</strong> Re-applied "<%= query.redo_done %>".
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (query.replaced) { %>
      <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-sync-alt me-2 fs-5 align-middle"></i>
        <strong>Faculty Profile Replaced!</strong> The existing faculty details have been updated with your new values.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (query.pub_updated) { %>
      <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2 fs-5 align-middle"></i>
        <strong>Publication Updated!</strong> Changes have been successfully saved.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (query.pub_added) { %>
      <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2 fs-5 align-middle"></i>
        <strong>Publication Record Added!</strong> Record saved to faculty profile.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (query.pub_replaced) { %>
      <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-sync-alt me-2 fs-5 align-middle"></i>
        <strong>Duplicate Publication Replaced!</strong> The existing publication record was updated with your new details.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (query.pub_upload_success) { %>
      <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2 fs-5 align-middle"></i>
        <strong>Excel Upload Processed!</strong> Added <strong><%= query.count %></strong> new<% if (query.replaced > 0) { %>, replaced <strong><%= query.replaced %></strong> existing<% } %><% if (query.skipped > 0) { %>, skipped <strong><%= query.skipped %></strong> duplicate(s)<% } %> for <%= faculty.name %>.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
    <% if (query.pub_err) { %>
      <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle me-2 fs-5 align-middle"></i>
        <strong>Upload Error:</strong> <%= query.pub_err %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
    <% if (query.deleted_multiple) { %>
      <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-trash me-2 fs-5 align-middle"></i>
        Successfully deleted <strong><%= query.deleted_multiple %></strong> publication records.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <% if (typeof pendingDuplicatePub !== 'undefined' && pendingDuplicatePub) { %>
      <div class="alert alert-warning border-warning shadow-sm p-4 rounded-3 mb-4" role="alert">
        <div class="d-flex align-items-start gap-3">
          <i class="fas fa-exclamation-triangle fa-2x text-warning mt-1"></i>
          <div class="flex-grow-1">
            <h5 class="fw-bold text-dark mb-1">
              Duplicate Publication Detected (<%= pendingDuplicatePub.matchReason %>)
            </h5>
            <p class="text-dark mb-3">
              A matching publication already exists for <strong><%= faculty.name %></strong>. Would you like to <strong>replace</strong> the existing record or <strong>add it as a new</strong> record anyway?
            </p>
            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <div class="p-3 bg-white rounded border h-100 small">
                  <div class="fw-bold text-secondary mb-1"><i class="fas fa-database me-1"></i>Existing Record</div>
                  <div class="fw-bold text-dark mb-1"><%= pendingDuplicatePub.existing.title %></div>
                  <div class="text-muted">Source: <%= pendingDuplicatePub.existing.source_title || '—' %></div>
                  <div class="mt-1 d-flex flex-wrap gap-1">
                    <span class="badge bg-primary-subtle text-primary border">ROS: <%= parseFloat(pendingDuplicatePub.existing.ros || 0).toFixed(2) %></span>
                    <span class="badge bg-secondary"><%= pendingDuplicatePub.existing.quartile || 'N/A' %></span>
                    <span class="badge bg-light text-dark border"><%= pendingDuplicatePub.existing.document_type %></span>
                    <span class="text-muted"><%= pendingDuplicatePub.existing.month %></span>
                    <% if (pendingDuplicatePub.existing.eid) { %><span class="font-monospace">EID: <%= pendingDuplicatePub.existing.eid %></span><% } %>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="p-3 bg-white rounded border border-primary h-100 small">
                  <div class="fw-bold text-primary mb-1"><i class="fas fa-file-medical me-1"></i>Your New Entry</div>
                  <div class="fw-bold text-dark mb-1"><%= pendingDuplicatePub.incoming.title %></div>
                  <div class="text-muted">Source: <%= pendingDuplicatePub.incoming.source_title || '—' %></div>
                  <div class="mt-1 d-flex flex-wrap gap-1">
                    <span class="badge bg-success-subtle text-success border">ROS: <%= parseFloat(pendingDuplicatePub.incoming.ros || 0).toFixed(2) %></span>
                    <span class="badge bg-secondary"><%= pendingDuplicatePub.incoming.quartile || 'N/A' %></span>
                    <span class="badge bg-light text-dark border"><%= pendingDuplicatePub.incoming.document_type %></span>
                    <span class="text-muted"><%= pendingDuplicatePub.incoming.month %></span>
                    <% if (pendingDuplicatePub.incoming.eid) { %><span class="font-monospace">EID: <%= pendingDuplicatePub.incoming.eid %></span><% } %>
                  </div>
                </div>
              </div>
            </div>
            <form action="/faculty/<%= faculty.id %>/publications" method="POST" class="d-flex gap-2 flex-wrap">
              <input type="hidden" name="replace_pub_id" value="<%= pendingDuplicatePub.existing.id %>">
              <input type="hidden" name="document_type" value="<%= pendingDuplicatePub.incoming.document_type %>">
              <input type="hidden" name="title" value="<%= pendingDuplicatePub.incoming.title %>">
              <input type="hidden" name="source_title" value="<%= pendingDuplicatePub.incoming.source_title %>">
              <input type="hidden" name="author_name" value="<%= pendingDuplicatePub.incoming.author_name %>">
              <input type="hidden" name="ros" value="<%= pendingDuplicatePub.incoming.ros %>">
              <input type="hidden" name="quartile" value="<%= pendingDuplicatePub.incoming.quartile %>">
              <input type="hidden" name="link" value="<%= pendingDuplicatePub.incoming.link %>">
              <input type="hidden" name="apn" value="<%= pendingDuplicatePub.incoming.apn %>">
              <input type="hidden" name="scopus_link" value="<%= pendingDuplicatePub.incoming.scopus_link %>">
              <input type="hidden" name="eid" value="<%= pendingDuplicatePub.incoming.eid %>">
              <input type="hidden" name="month" value="<%= pendingDuplicatePub.incoming.month %>">

              <button type="submit" name="dup_action" value="replace" class="btn btn-warning fw-bold text-dark shadow-sm">
                <i class="fas fa-sync-alt me-1"></i>Yes, Replace Existing
              </button>
              <button type="submit" name="dup_action" value="add_new" class="btn btn-primary fw-semibold">
                <i class="fas fa-plus me-1"></i>Add as New Anyway
              </button>
              <a href="/faculty/<%= faculty.id %>" class="btn btn-outline-secondary">
                <i class="fas fa-times me-1"></i>Cancel
              </a>
            </form>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Breadcrumb & Action bar -->
    <div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb custom-breadcrumb mb-0">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-item"><a href="/portal">Directory</a></li>
          <li class="breadcrumb-item active"><%= faculty.name %></li>
        </ol>
      </nav>
      <% if (isAdmin) { %>
      <div class="d-flex gap-2 flex-wrap">
        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addPubModal">
          <i class="fas fa-plus-circle me-1"></i>Add Record
        </button>
        <button class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#uploadPubExcelModal">
          <i class="fas fa-file-excel me-1"></i>Upload Faculty Excel
        </button>
        <a href="/faculty/<%= faculty.id %>/edit" class="btn btn-outline-secondary btn-sm">
          <i class="fas fa-edit me-1"></i>Edit Profile
        </a>
      </div>
      <% } %>
    </div>

    <!-- Profile Hero Card -->
    <% const isMemberActive = (faculty.status || 'Active') !== 'Inactive'; %>
    <div class="profile-hero mb-4">
      <div class="profile-hero-left">
        <div class="profile-photo-wrap position-relative">
          <% if (faculty.photo) { %>
            <img src="/uploads/<%= faculty.photo %>" alt="<%= faculty.name %>" class="profile-photo">
          <% } else { %>
            <div class="profile-photo-placeholder">
              <span><%= initials %></span>
            </div>
          <% } %>
          <span title="<%= isMemberActive ? 'Active Member' : 'Inactive / Left Department' %>"
                style="position:absolute; bottom:4px; right:4px; width:18px; height:18px; border-radius:50%; border:3px solid #fff; background:<%= isMemberActive ? '#16a34a' : '#dc2626' %>; box-shadow:0 2px 6px rgba(0,0,0,0.25);"></span>
        </div>
      </div>
      <div class="profile-hero-right">
        <div class="d-flex align-items-center flex-wrap gap-2">
          <h1 class="profile-name mb-0"><%= faculty.name %></h1>
          <span class="badge <%= isMemberActive ? 'bg-success-subtle text-success border border-success' : 'bg-danger-subtle text-danger border border-danger' %> px-2 py-1 d-inline-flex align-items-center gap-1">
            <span style="width:9px; height:9px; border-radius:50%; background:<%= isMemberActive ? '#16a34a' : '#dc2626' %>; display:inline-block;"></span>
            <%= isMemberActive ? 'Active' : 'Inactive / Left' %>
          </span>
          <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
            <%= faculty.member_type || 'Faculty' %>
          </span>
        </div>
        <div class="profile-meta">
          <span class="emp-badge-lg"><i class="fas fa-id-card me-1"></i><%= faculty.employee_code %></span>
          <% if (faculty.scopus_id) { %>
          <a href="https://www.scopus.com/authid/detail.uri?authorId=<%= encodeURIComponent(faculty.scopus_id) %>" target="_blank" class="meta-chip text-decoration-none" style="background:#fef3c7;color:#92400e;font-weight:600">
            <i class="fas fa-fingerprint me-1"></i>Scopus ID: <%= faculty.scopus_id %> <i class="fas fa-external-link-alt ms-1 small"></i>
          </a>
          <% } else { %>
          <span class="meta-chip text-muted"><i class="fas fa-fingerprint me-1"></i>Scopus ID: Not Set</span>
          <% } %>
          <% if (faculty.designation) { %>
          <span class="meta-chip"><i class="fas fa-graduation-cap me-1"></i><%= faculty.designation %></span>
          <% } %>
          <% if (faculty.department) { %>
          <span class="meta-chip"><i class="fas fa-building me-1"></i><%= faculty.department %></span>
          <% } %>
          <span class="meta-chip" style="background:#f1f5f9;font-weight:600">
            <i class="fas fa-layer-group me-1"></i><%= faculty.total_pubs %> Total Publications
          </span>
        </div>

        <!-- ROS & Output Overview -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pt-2 border-top">
          <div class="profile-ros-wrap" style="min-width: 280px; flex: 1;">
            <div class="profile-ros-label-row">
              <span class="profile-ros-title"><i class="fas fa-tachometer-alt me-1 text-primary"></i>Total ROS Points:</span>
              <span class="profile-ros-value text-<%= rc %>"><%= faculty.ros.toFixed(2) %></span>
              <span class="ros-status-chip ros-chip-<%= rc %>"><%= rl %></span>
            </div>
            <div class="ros-bar-bg large">
              <div class="ros-bar-fill ros-fill-<%= rc %>" style="width: <%= rosPercent %>%"></div>
            </div>
          </div>
          <div class="pub-badges d-flex flex-wrap gap-2">
            <span class="pub-badge bg-primary p-2 px-3">Journals: <strong><%= faculty.journal_count %></strong> (Q1:<%= faculty.q1 %> | Q2:<%= faculty.q2 %>)</span>
            <span class="pub-badge bg-warning text-dark p-2 px-3">Conferences: <strong><%= faculty.conf_count %></strong></span>
            <span class="pub-badge bg-success p-2 px-3">Book Chapters: <strong><%= faculty.book_count %></strong></span>
            <span class="pub-badge bg-danger p-2 px-3">Patents: <strong><%= faculty.patent_count %></strong></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-pills mb-3 gap-2" id="profileTabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active fw-bold" id="pubs-tab" data-bs-toggle="tab" data-bs-target="#pubs-tab-pane" type="button" role="tab">
          <i class="fas fa-file-alt me-1"></i>Publications Record (<%= faculty.total_pubs %>)
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold" id="progress-tab" data-bs-toggle="tab" data-bs-target="#progress-tab-pane" type="button" role="tab">
          <i class="fas fa-calendar-alt me-1"></i>Month-wise Progress Report (<%= faculty.month_wise.length %> Months)
        </button>
      </li>
    </ul>

    <!-- Tab Contents -->
    <div class="tab-content" id="profileTabContent">

      <!-- 1. Publications Records Tab -->
      <div class="tab-pane fade show active" id="pubs-tab-pane" role="tabpanel">
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
          
          <form id="multiDeleteForm" action="/faculty/<%= faculty.id %>/publications/delete-multiple" method="POST">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
              <div class="d-flex align-items-center gap-2">
                <h5 class="mb-0 fw-bold text-primary"><i class="fas fa-list-ul me-2"></i>Research Publications</h5>
                <span class="badge bg-light text-dark border"><%= faculty.total_pubs %> Records</span>
              </div>
              <% if (isAdmin) { %>
              <div class="d-flex align-items-center gap-2 flex-wrap">
                <!-- Delete Selected Button -->
                <button type="submit" id="deleteSelectedBtn" class="btn btn-outline-danger btn-sm shadow-sm" disabled
                        onclick="return confirm('Are you sure you want to delete all selected publication records?');">
                  <i class="fas fa-trash-alt me-1"></i>Delete Selected (<span id="selectedCount">0</span>)
                </button>
                <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#uploadPubExcelModal">
                  <i class="fas fa-file-excel me-1"></i>Upload Excel
                </button>
                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addPubModal">
                  <i class="fas fa-plus me-1"></i>Add Record
                </button>
              </div>
              <% } %>
            </div>

            <div class="card-body p-0">
              <% if (faculty.publications.length === 0) { %>
                <div class="text-center py-5 text-muted">
                  <i class="fas fa-file-excel fa-3x mb-3 text-secondary opacity-50"></i>
                  <h6>No publications added yet</h6>
                  <% if (isAdmin) { %>
                  <p class="small mb-3">Upload your Excel file or add records manually using the exact spreadsheet format.</p>
                  <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#uploadPubExcelModal">
                      <i class="fas fa-file-excel me-1"></i>Upload Publications Excel
                    </button>
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addPubModal">
                      <i class="fas fa-plus me-1"></i>Add First Publication
                    </button>
                  </div>
                  <% } else { %>
                  <p class="small mb-0">No publications are recorded for this faculty member yet.</p>
                  <% } %>
                </div>
              <% } else { %>
                <div class="table-responsive">
                  <table class="table table-hover align-middle mb-0" id="publicationsTable">
                    <thead class="table-light">
                      <tr>
                        <% if (isAdmin) { %>
                        <th style="width: 3%;" class="text-center">
                          <input type="checkbox" id="selectAllCheckbox" class="form-check-input" title="Select All">
                        </th>
                        <% } %>
                        <th style="width: 4%;">#</th>
                        <th style="width: 25%;">Title</th>
                        <th style="width: 15%;">Source Title</th>
                        <th style="width: 12%;">Author names (CU)</th>
                        <th style="width: 6%;" class="text-center">ROS</th>
                        <th style="width: 6%;" class="text-center">Quartile</th>
                        <th style="width: 10%;">Document Type</th>
                        <th style="width: 9%;">APN</th>
                        <th style="width: 6%;">EID</th>
                        <th style="width: 12%;" class="text-center"><%= isAdmin ? 'Actions' : 'Links' %></th>
                      </tr>
                    </thead>
                    <tbody>
                      <% faculty.publications.forEach((p, idx) => { %>
                        <%
                          let docBadgeClass = 'bg-primary';
                          if (p.pub_type === 'Conference') docBadgeClass = 'bg-warning text-dark';
                          else if (p.pub_type === 'Book Chapter') docBadgeClass = 'bg-success';
                          else if (p.pub_type === 'Patent') docBadgeClass = 'bg-danger';
                          else if (p.document_type === 'Review') docBadgeClass = 'bg-info text-dark';
                        %>
                        <tr>
                          <% if (isAdmin) { %>
                          <td class="text-center">
                            <input type="checkbox" name="pub_ids" value="<%= p.id %>" class="form-check-input pub-checkbox">
                          </td>
                          <% } %>
                          <td class="text-muted small"><%= idx + 1 %></td>
                          <td>
                            <div class="fw-bold text-dark"><%= p.title %></div>
                            <span class="badge <%= (p.pub_department && p.pub_department.trim().toUpperCase() !== 'UIC') ? 'bg-secondary' : 'bg-info-subtle text-dark border' %>" style="font-size:0.7rem;">
                              Dept: <%= p.pub_department || 'UIC' %>
                            </span>
                          </td>
                          <td>
                            <div class="text-muted small"><%= p.source_title || '—' %></div>
                          </td>
                          <td>
                            <span class="badge bg-light text-dark border"><%= p.author_name || faculty.name %></span>
                          </td>
                          <td class="text-center">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 fs-6 fw-bold">
                              <%= parseFloat(p.ros).toFixed(2) %>
                            </span>
                          </td>
                          <td class="text-center">
                            <% const displayQuartile = (p.pub_type === 'Conference' && (!p.quartile || p.quartile === 'N/A')) ? 'Q4' : p.quartile; %>
                            <% if (displayQuartile && displayQuartile !== 'N/A') { %>
                              <span class="pub-badge pub-<%= displayQuartile.toLowerCase() %> px-2 py-1"><%= displayQuartile %></span>
                            <% } else { %>
                              <span class="text-muted small">—</span>
                            <% } %>
                          </td>
                          <td>
                            <span class="badge <%= docBadgeClass %>"><%= p.document_type %></span>
                            <div class="text-muted" style="font-size:0.7rem;"><%= p.pub_type %></div>
                          </td>
                          <td>
                            <div class="small fw-semibold text-dark"><%= p.apn || '—' %></div>
                            <div class="text-muted" style="font-size:0.7rem;"><%= p.month %></div>
                          </td>
                          <td>
                            <% if (p.eid) { %>
                              <span class="badge bg-light text-secondary border font-monospace" style="font-size:0.75rem;"><%= p.eid %></span>
                            <% } else { %>
                              <span class="text-muted small">—</span>
                            <% } %>
                          </td>
                          <td class="text-center">
                            <div class="d-flex justify-content-center align-items-center gap-1 flex-wrap">
                              <% if (isAdmin) { %>
                              <!-- Edit Button -->
                              <button type="button" class="btn btn-warning btn-sm py-1 px-2 fw-semibold text-dark shadow-sm"
                                      title="Edit Record"
                                      onclick="openEditPubModal(<%= p.id %>)">
                                <i class="fas fa-edit me-1"></i>Edit
                              </button>
                              <% } %>
                              <% if (p.link) { %>
                                <a href="<%= p.link %>" target="_blank" class="btn btn-outline-primary btn-sm py-1 px-2" title="Link">
                                  <i class="fas fa-external-link-alt"></i>
                                </a>
                              <% } %>
                              <% if (p.scopus_link) { %>
                                <a href="<%= p.scopus_link %>" target="_blank" class="btn btn-outline-info btn-sm py-1 px-2" title="Scopus Link">
                                  <i class="fas fa-search"></i>
                                </a>
                              <% } %>
                              <% if (!isAdmin && !p.link && !p.scopus_link) { %>
                                <span class="text-muted small">—</span>
                              <% } %>
                            </div>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                    <tfoot class="table-light">
                      <tr>
                        <td colspan="<%= isAdmin ? 5 : 4 %>" class="text-end fw-bold">Total Accumulated ROS Points:</td>
                        <td class="text-center fw-bold text-primary fs-6"><%= faculty.ros.toFixed(2) %></td>
                        <td colspan="5"></td>
                      </tr>
                    </tfoot>
                  </table>
                </div>
              <% } %>
            </div>
          </form>

        </div>
      </div>

      <!-- 2. Month-Wise Progress Report Tab -->
      <div class="tab-pane fade" id="progress-tab-pane" role="tabpanel">
        <div class="card border-0 shadow-sm rounded-3">
          <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold text-primary">
              <i class="fas fa-chart-line me-2"></i>Month-wise Research Progress Report
            </h5>
            <small class="text-muted">Chronological performance breakdown by publication month and earned ROS points</small>
          </div>
          <div class="card-body">
            <% if (faculty.month_wise.length === 0) { %>
              <div class="text-center py-5 text-muted">
                <i class="fas fa-calendar-times fa-3x mb-3 text-secondary opacity-50"></i>
                <h6>No monthly data to display</h6>
                <p class="small">Add publication records to generate the progress report.</p>
              </div>
            <% } else { %>
              <div class="table-responsive mb-4">
                <table class="table table-bordered align-middle text-center">
                  <thead class="table-primary">
                    <tr>
                      <th class="text-start">Month (YYYY-MM)</th>
                      <th>Total Output</th>
                      <th>Journals (Article/Review)</th>
                      <th>Conferences</th>
                      <th>Book Chapters</th>
                      <th>Patents</th>
                      <th>Monthly ROS Points</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% faculty.month_wise.forEach(mw => { %>
                      <tr>
                        <td class="text-start fw-bold">
                          <i class="fas fa-calendar-check text-primary me-2"></i><%= mw.month %>
                        </td>
                        <td class="fw-bold"><%= mw.count %></td>
                        <td><span class="badge bg-primary"><%= mw.journal %></span></td>
                        <td><span class="badge bg-warning text-dark"><%= mw.conf %></span></td>
                        <td><span class="badge bg-success"><%= mw.book %></span></td>
                        <td><span class="badge bg-danger"><%= mw.patent %></span></td>
                        <td class="fw-bold text-success fs-6">+<%= mw.ros.toFixed(2) %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>

              <!-- Monthly breakdown list -->
              <h6 class="fw-bold text-secondary mb-3">Monthly Publication Lists:</h6>
              <div class="d-flex flex-column gap-3">
                <% faculty.month_wise.forEach(mw => { %>
                  <div class="border rounded-3 p-3 bg-light">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                      <span class="fw-bold fs-6 text-dark">
                        <i class="far fa-calendar-alt me-1 text-primary"></i> Month: <%= mw.month %>
                      </span>
                      <span class="badge bg-success fs-6">Monthly ROS: <%= mw.ros.toFixed(2) %></span>
                    </div>
                    <ul class="list-group list-group-flush rounded-2">
                      <% mw.pubs.forEach(p => { %>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                          <div>
                            <span class="badge bg-secondary me-2"><%= p.document_type %></span>
                            <% if (p.quartile && p.quartile !== 'N/A') { %>
                              <span class="pub-badge pub-<%= p.quartile.toLowerCase() %> me-2"><%= p.quartile %></span>
                            <% } %>
                            <span class="fw-semibold"><%= p.title %></span>
                            <% if (p.source_title) { %>
                              <span class="text-muted small ms-2">— <%= p.source_title %></span>
                            <% } %>
                            <% if (p.apn) { %>
                              <span class="text-muted small ms-2">(APN: <%= p.apn %>)</span>
                            <% } %>
                          </div>
                          <span class="badge bg-primary">ROS: <%= parseFloat(p.ros).toFixed(2) %></span>
                        </li>
                      <% }) %>
                    </ul>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Actions -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
      <a href="/portal" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back to Directory</a>
      <% if (isAdmin) { %>
      <form action="/faculty/<%= faculty.id %>/delete" method="POST"
            onsubmit="return confirm('Delete <%= faculty.name %> and all records? This cannot be undone.');">
        <button type="submit" class="btn btn-outline-danger btn-sm"><i class="fas fa-trash me-1"></i>Delete Faculty Profile</button>
      </form>
      <% } %>
    </div>

  </div>
</main>

