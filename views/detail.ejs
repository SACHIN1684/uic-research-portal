<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<% if (isAdmin) { %>
<script>
const publicationsData = <%- JSON.stringify(faculty.publications) %>;

window.openEditPubModal = function(pubId) {
  const p = publicationsData.find(item => item.id === pubId);
  if (!p) return;

  const form = document.getElementById('editPubForm');
  form.action = `/faculty/<%= faculty.id %>/publications/${p.id}/edit`;

  document.getElementById('edit_document_type').value = p.document_type || 'Article';
  const defaultQuart = (p.pub_type === 'Conference' && (!p.quartile || p.quartile === 'N/A')) ? 'Q4' : (p.quartile || 'N/A');
  document.getElementById('edit_quartile').value = defaultQuart;
  document.getElementById('edit_title').value = p.title || '';
  document.getElementById('edit_source_title').value = p.source_title || '';
  document.getElementById('edit_author_name').value = p.author_name || '';
  document.getElementById('edit_ros').value = parseFloat(p.ros) || 0.0;
  document.getElementById('edit_apn').value = p.apn || '';
  document.getElementById('edit_month').value = p.month || '';
  document.getElementById('edit_link').value = p.link || '';
  document.getElementById('edit_scopus_link').value = p.scopus_link || '';
  document.getElementById('edit_eid').value = p.eid || '';
  document.getElementById('edit_pub_department').value = p.pub_department || 'UIC';

  const modal = new bootstrap.Modal(document.getElementById('editPubModal'));
  modal.show();
};

document.addEventListener('DOMContentLoaded', () => {
  const docTypeSelect = document.getElementById('docTypeSelect');
  const addQuartileSelect = document.getElementById('addQuartileSelect');
  if (docTypeSelect && addQuartileSelect) {
    docTypeSelect.addEventListener('change', function() {
      if (this.value === 'Conference Paper' && addQuartileSelect.value === 'N/A') {
        addQuartileSelect.value = 'Q4';
      }
    });
  }

  const editDocType = document.getElementById('edit_document_type');
  const editQuartile = document.getElementById('edit_quartile');
  if (editDocType && editQuartile) {
    editDocType.addEventListener('change', function() {
      if (this.value === 'Conference Paper' && editQuartile.value === 'N/A') {
        editQuartile.value = 'Q4';
      }
    });
  }

  const selectAll = document.getElementById('selectAllCheckbox');
  const checkboxes = document.querySelectorAll('.pub-checkbox');
  const deleteBtn = document.getElementById('deleteSelectedBtn');
  const selectedCountSpan = document.getElementById('selectedCount');

  function updateDeleteBtn() {
    const checked = document.querySelectorAll('.pub-checkbox:checked');
    const count = checked.length;
    selectedCountSpan.textContent = count;
    deleteBtn.disabled = count === 0;
    if (selectAll) {
      selectAll.checked = checkboxes.length > 0 && count === checkboxes.length;
    }
  }

  if (selectAll) {
    selectAll.addEventListener('change', function() {
      checkboxes.forEach(cb => cb.checked = this.checked);
      updateDeleteBtn();
    });
  }

  checkboxes.forEach(cb => {
    cb.addEventListener('change', updateDeleteBtn);
  });
});
</script>
<% } %>
</body>
</html>
