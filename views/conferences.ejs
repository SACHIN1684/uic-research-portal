<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Upcoming Conferences — UIC Research Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
  <script src="/js/theme.js"></script>
  <style>
    :root {
      --cu-red: #c8102e;
      --cu-red-dark: #960c22;
      --cu-navy: #0b1f3f;
      --cu-navy-light: #163665;
      --cu-gold: #d4af37;
    }
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: #1e293b;
      background-color: #f1f5f9;
      overflow-x: hidden;
    }
    .display-font {
      font-family: 'Space Grotesk', sans-serif;
    }
    .cu-topbar {
      background: var(--cu-navy);
      color: rgba(255, 255, 255, 0.85);
      font-size: 0.8rem;
      padding: 6px 0;
      border-bottom: 2px solid var(--cu-red);
    }
    .home-navbar {
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(12px);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
      position: sticky;
      top: 0;
      z-index: 1030;
    }
    .brand-logo-badge {
      background: linear-gradient(135deg, var(--cu-red), #e63946);
      color: #fff;
      font-weight: 800;
      font-size: 1.25rem;
      padding: 8px 14px;
      border-radius: 10px;
      box-shadow: 0 4px 14px rgba(200, 16, 46, 0.35);
    }
    .conf-banner {
      background: linear-gradient(135deg, #07152b 0%, #0b1f3f 60%, #163665 100%);
      color: white;
      padding: 42px 0 38px;
      position: relative;
      overflow: hidden;
    }
    .conf-banner::before {
      content: "";
      position: absolute;
      top: -40%;
      right: -10%;
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(212, 175, 55, 0.22) 0%, transparent 70%);
      border-radius: 50%;
      pointer-events: none;
    }
    .conf-card {
      background: white;
      border-radius: 18px;
      border: 1px solid #e2e8f0;
      box-shadow: 0 6px 20px rgba(0,0,0,0.04);
      transition: all 0.25s ease;
      height: 100%;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .conf-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 30px rgba(11, 31, 63, 0.1);
      border-color: #cbd5e1;
    }
    .kpi-card {
      background: white;
      border-radius: 16px;
      padding: 20px;
      border: 1px solid #e2e8f0;
      box-shadow: 0 4px 15px rgba(0,0,0,0.03);
      transition: all 0.25s ease;
      height: 100%;
    }
    .kpi-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 25px rgba(11, 31, 63, 0.08);
      border-color: #cbd5e1;
    }
    .kpi-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.3rem;
    }
    .date-badge {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 8px 12px;
    }
    .status-badge-open {
      background-color: #10b981;
      color: white;
    }
    .status-badge-upcoming {
      background-color: #3b82f6;
      color: white;
    }
    .status-badge-extended {
      background-color: #f59e0b;
      color: white;
    }
    .status-badge-completed {
      background-color: #94a3b8;
      color: white;
    }
    .selection-bar {
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      border-radius: 12px;
      padding: 10px 18px;
    }
  </style>
</head>
<body>

  <!-- Top bar -->
  <div class="cu-topbar">
    <div class="container-fluid px-3 px-lg-4 d-flex justify-content-between align-items-center">
      <div class="d-flex align-items-center gap-3">
        <span><i class="fas fa-university me-1 text-danger"></i> Chandigarh University &bull; NAAC A+ Accredited</span>
        <span class="d-none d-md-inline text-secondary">|</span>
        <span class="d-none d-md-inline"><i class="fas fa-calendar-check me-1 text-warning"></i> UIC Upcoming Conferences &amp; CFP Portal</span>
      </div>
      <div class="d-flex align-items-center gap-3">
        <a href="/patents" class="text-white text-decoration-none small"><i class="fas fa-certificate me-1 text-warning"></i> Patents</a>
        <a href="/publications" class="text-white text-decoration-none small"><i class="fas fa-book me-1"></i> Publications Database</a>
        <a href="/portal" class="text-white text-decoration-none small"><i class="fas fa-database me-1"></i> Faculty Directory</a>
        <% if (isAdmin) { %>
          <span class="badge bg-success"><i class="fas fa-user-shield me-1"></i> Admin Logged In</span>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Main Navbar -->
  <nav class="navbar navbar-expand-lg home-navbar py-2">
    <div class="container-fluid px-3 px-lg-4">
      <a class="navbar-brand d-flex align-items-center gap-2 text-nowrap" href="/">
        <div class="brand-logo-badge py-1 px-2 fs-6">
          <i class="fas fa-laptop-code me-1"></i> UIC
        </div>
        <div>
          <div class="fw-bold fs-6 text-dark lh-1 display-font">UIC Research Portal</div>
          <div class="text-muted" style="font-size: 0.68rem; letter-spacing: 0.2px;">
            University Institute of Computing &bull; Chandigarh University
          </div>
        </div>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navConferences">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navConferences">
        <ul class="navbar-nav ms-auto align-items-center gap-1 gap-xl-2 my-2 my-lg-0" style="font-size: 0.88rem;">
          <!-- 1. Research Menu (Dropdown) -->
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle fw-bold text-dark px-2" href="#" id="confResearchDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="fas fa-flask text-danger me-1"></i> Research
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 py-2 rounded-3" aria-labelledby="confResearchDropdown" style="min-width: 250px;">
              <li>
                <a class="dropdown-item py-2 px-3 fw-semibold text-dark" href="/#overview">
                  <i class="fas fa-chart-pie text-secondary me-2 fa-fw"></i> Research Overview
                </a>
              </li>
              <li>
                <a class="dropdown-item py-2 px-3 fw-semibold text-dark" href="/#leadership">
                  <i class="fas fa-users-cog text-danger me-2 fa-fw"></i> My Director and Heads
                </a>
              </li>
              <li>
                <a class="dropdown-item py-2 px-3 fw-semibold text-dark" href="/#coordinator">
                  <i class="fas fa-user-tie text-success me-2 fa-fw"></i> Research Coordinator
                </a>
              </li>
              <li><hr class="dropdown-divider my-1"></li>
              <li>
                <a class="dropdown-item py-2 px-3 fw-bold text-danger d-flex align-items-center justify-content-between" href="/publications">
                  <span><i class="fas fa-book-open text-danger me-2 fa-fw"></i> Publications</span>
                  <span class="badge bg-danger rounded-pill small">Online DB</span>
                </a>
              </li>
              <li>
                <a class="dropdown-item py-2 px-3 fw-bold text-primary active d-flex align-items-center justify-content-between" href="/conferences">
                  <span><i class="fas fa-calendar-alt text-primary me-2 fa-fw"></i> Upcoming Conferences</span>
                  <span class="badge bg-primary text-white rounded-pill small">Current</span>
                </a>
              </li>
              <li>
                <a class="dropdown-item py-2 px-3 fw-bold text-warning d-flex align-items-center justify-content-between" href="/patents">
                  <span><i class="fas fa-certificate text-warning me-2 fa-fw"></i> Patents &amp; Inventions</span>
                  <span class="badge bg-warning text-dark rounded-pill small">57 Patents</span>
                </a>
              </li>
            </ul>
          </li>

          <!-- 2. My Campus Menu (Dropdown) -->
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle fw-bold text-dark px-2" href="#" id="confCampusDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="fas fa-university text-primary me-1"></i> My Campus
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 py-2 rounded-3" aria-labelledby="confCampusDropdown" style="min-width: 230px;">
              <li>
                <a class="dropdown-item py-2 px-3 fw-semibold text-dark" href="/#campus">
                  <i class="fas fa-building text-secondary me-2 fa-fw"></i> Campus Infrastructure
                </a>
              </li>
              <li>
                <a class="dropdown-item py-2 px-3 fw-bold text-danger" href="/#monthly-ros">
                  <i class="fas fa-chart-line text-danger me-2 fa-fw"></i> ROS &amp; Growth
                </a>
              </li>
              <li>
                <a class="dropdown-item py-2 px-3 fw-semibold text-dark" href="/#top-performers">
                  <i class="fas fa-trophy text-warning me-2 fa-fw"></i> Top Performers
                </a>
              </li>
            </ul>
          </li>

          <li class="nav-item">
            <a class="nav-link fw-semibold text-dark text-nowrap px-2" href="/portal">
              <i class="fas fa-users me-1 text-primary"></i>Faculty Directory
            </a>
          </li>
          <li class="nav-item ms-lg-2">
            <% if (isAdmin) { %>
              <div class="d-flex align-items-center gap-1">
                <button type="button" class="btn btn-primary btn-sm fw-bold px-3 py-2 shadow-sm rounded-pill text-nowrap" data-bs-toggle="modal" data-bs-target="#addConferenceModal">
                  <i class="fas fa-plus me-1"></i> Add Conference
                </button>
                <form action="/admin/logout" method="POST" class="d-inline">
                  <input type="hidden" name="return_to" value="/conferences">
                  <button type="submit" class="btn btn-outline-secondary btn-sm py-2 px-2" title="Logout Admin">
                    <i class="fas fa-sign-out-alt"></i>
                  </button>
                </form>
              </div>
            <% } else { %>
              <a href="/?admin_login_required=1" class="btn btn-outline-danger btn-sm fw-bold py-2 px-3 text-nowrap">
                <i class="fas fa-lock me-1"></i> Admin Login
              </a>
            <% } %>
          </li>
          <li class="nav-item ms-lg-1">
            <button type="button" class="btn btn-sm rounded-pill theme-toggle-btn px-2 py-2" title="Toggle Light / Dark Theme" aria-label="Toggle Theme">
              <i class="fas fa-moon theme-icon"></i>
            </button>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Banner Section -->
  <section class="conf-banner">
    <div class="container-fluid px-3 px-lg-4 position-relative" style="z-index: 2;">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
          <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-white bg-opacity-10 text-warning small fw-bold mb-2">
            <i class="fas fa-bullhorn"></i> Call for Papers &bull; Indexed Conferences (2026–2027)
          </div>
          <h1 class="display-font fw-bold text-white mb-2" style="font-size: 2.2rem;">
            Upcoming International Conferences
          </h1>
          <p class="text-white text-opacity-80 mb-0" style="max-width: 820px; font-size: 0.95rem;">
            Curated list of Scopus, IEEE Xplore, Web of Science, and Springer Nature indexed conferences for UIC faculty, research scholars, and students. Check deadlines, submission links, and venues.
          </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <% if (isAdmin) { %>
            <button type="button" class="btn btn-warning fw-bold px-4 py-2 rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#addConferenceModal">
              <i class="fas fa-plus me-1"></i> Add Conference
            </button>
          <% } %>
          <a href="/publications" class="btn btn-outline-light fw-semibold px-3 py-2 rounded-pill">
            <i class="fas fa-book me-1"></i> Publications Database
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Alerts -->
  <div class="container-fluid px-3 px-lg-4 mt-3">
    <% if (query.added) { %>
      <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2"></i><strong>Conference Added!</strong> The new conference details have been published.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (query.edited) { %>
      <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2"></i><strong>Conference Updated!</strong> Changes have been saved successfully.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (query.deleted) { %>
      <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-trash-alt me-2"></i><strong>Conference Deleted!</strong> The conference entry was removed.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (query.deleted_multiple) { %>
      <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-trash-alt me-2"></i><strong>Multiple Conferences Deleted!</strong> Successfully removed <%= query.deleted_multiple %> entries.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (query.err) { %>
      <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i><strong>Notice:</strong> <%= query.err %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
  </div>

  <!-- KPI Cards -->
  <div class="container-fluid px-3 px-lg-4 my-4">
    <div class="row g-3">
      <div class="col-6 col-md-3">
        <div class="kpi-card d-flex align-items-center gap-3">
          <div class="kpi-icon bg-primary bg-opacity-10 text-primary">
            <i class="fas fa-calendar-alt"></i>
          </div>
          <div>
            <div class="fs-4 fw-bold text-dark display-font lh-1"><%= stats.total %></div>
            <div class="text-muted small mt-1">Conferences Listed</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="kpi-card d-flex align-items-center gap-3">
          <div class="kpi-icon bg-success bg-opacity-10 text-success">
            <i class="fas fa-check-double"></i>
          </div>
          <div>
            <div class="fs-4 fw-bold text-success display-font lh-1"><%= stats.scopusCount %></div>
            <div class="text-muted small mt-1">Scopus / IEEE Indexed</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="kpi-card d-flex align-items-center gap-3">
          <div class="kpi-icon bg-warning bg-opacity-10 text-warning">
            <i class="fas fa-envelope-open-text"></i>
          </div>
          <div>
            <div class="fs-4 fw-bold text-dark display-font lh-1"><%= stats.openCfpCount %></div>
            <div class="text-muted small mt-1">Call for Papers Open</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="kpi-card d-flex align-items-center gap-3">
          <div class="kpi-icon bg-danger bg-opacity-10 text-danger">
            <i class="fas fa-award"></i>
          </div>
          <div>
            <div class="fs-4 fw-bold text-danger display-font lh-1">100%</div>
            <div class="text-muted small mt-1">Peer Reviewed Forums</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters & Controls Section -->
  <div class="container-fluid px-3 px-lg-4 mb-4">
    <div class="bg-white p-3 p-lg-4 rounded-4 border shadow-sm">
      <div class="row g-3 align-items-center">
        <!-- Live Search -->
        <div class="col-12 col-md-5 col-lg-4">
          <div class="input-group">
            <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-search"></i></span>
            <input type="text" id="liveSearchConf" class="form-control border-start-0 ps-0" placeholder="Search conference title, acronym, organizer, indexing..." value="<%= filters.search || '' %>" onkeyup="filterConferences()">
          </div>
        </div>

        <!-- Status Filter -->
        <div class="col-6 col-md-3 col-lg-3">
          <select id="statusFilter" class="form-select form-select-sm py-2" onchange="filterConferences()">
            <option value="all">All Statuses</option>
            <option value="Call for Papers Open">Call for Papers Open</option>
            <option value="Upcoming">Upcoming</option>
            <option value="Deadline Extended">Deadline Extended</option>
            <option value="Completed">Completed</option>
          </select>
        </div>

        <!-- Indexing Filter -->
        <div class="col-6 col-md-4 col-lg-3">
          <select id="indexingFilter" class="form-select form-select-sm py-2" onchange="filterConferences()">
            <option value="all">All Indexing</option>
            <option value="Scopus">Scopus</option>
            <option value="IEEE">IEEE Xplore</option>
            <option value="Springer">Springer</option>
            <option value="Web of Science">Web of Science</option>
          </select>
        </div>

        <!-- Counter & Reset -->
        <div class="col-12 col-lg-2 d-flex align-items-center justify-content-lg-end gap-2">
          <span class="badge bg-light text-dark border px-3 py-2 fw-semibold">
            Showing <strong id="visibleConfCount" class="text-primary"><%= conferences.length %></strong> of <%= stats.total %>
          </span>
          <button type="button" class="btn btn-outline-secondary btn-sm py-2 px-3 fw-semibold" onclick="resetConfFilters()">
            <i class="fas fa-redo"></i>
          </button>
        </div>
      </div>

      <!-- Bulk Actions Bar -->
      <div id="confSelectionToolbar" class="selection-bar mt-3 d-none align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
          <i class="fas fa-check-circle text-primary fs-5"></i>
          <span class="fw-bold text-dark"><span id="selectedConfCount">0</span> conferences selected</span>
        </div>
        <div class="d-flex align-items-center gap-2">
          <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearAllConfSelections()">Deselect All</button>
          <% if (isAdmin) { %>
            <button type="button" class="btn btn-sm btn-danger fw-bold" onclick="openBulkDeleteConfModal()">
              <i class="fas fa-trash-alt me-1"></i> Delete Selected Conferences
            </button>
          <% } else { %>
            <button type="button" class="btn btn-sm btn-danger fw-bold" onclick="alert('Please log in as Admin to delete conferences.')">
              <i class="fas fa-lock me-1"></i> Admin Login Required
            </button>
          <% } %>
        </div>
      </div>

    </div>
  </div>

  <!-- Conference Cards Grid -->
  <div class="container-fluid px-3 px-lg-4 mb-5" id="conferenceList">
    <div class="row g-4" id="conferenceCardsContainer">
      <% if (conferences.length === 0) { %>
        <div class="col-12 text-center py-5">
          <div class="p-4 bg-white rounded-4 border shadow-sm">
            <i class="fas fa-calendar-times text-muted display-4 mb-3"></i>
            <h5>No Conferences Found</h5>
            <p class="text-muted small">No upcoming conferences match your selected filter criteria.</p>
            <% if (isAdmin) { %>
              <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addConferenceModal">
                <i class="fas fa-plus me-1"></i> Add First Conference
              </button>
            <% } %>
          </div>
        </div>
      <% } %>

      <% conferences.forEach(c => { 
           let statusClass = 'status-badge-upcoming';
           if (/open/i.test(c.status || '')) statusClass = 'status-badge-open';
           else if (/extended/i.test(c.status || '')) statusClass = 'status-badge-extended';
           else if (/completed/i.test(c.status || '')) statusClass = 'status-badge-completed';
      %>
        <div class="col-md-6 col-xl-6 conf-item-col"
             data-conf-id="<%= c.id %>"
             data-status="<%= (c.status || '').toLowerCase() %>"
             data-indexing="<%= (c.indexing || '').toLowerCase() %>"
             data-search="<%= [c.title, c.acronym, c.organizer, c.venue, c.indexing, c.description].join(' ').toLowerCase() %>">
          
          <div class="conf-card p-4">
            <!-- Header with acronym & status -->
            <div class="d-flex align-items-start justify-content-between gap-2 mb-3">
              <div class="d-flex align-items-center gap-2">
                <% if (isAdmin) { %>
                  <input type="checkbox" class="form-check-input conf-select-check me-1 mt-0" value="<%= c.id %>" onchange="onConfSelectChange()">
                <% } %>
                <span class="badge bg-navy text-white px-3 py-2 fw-bold" style="background: var(--cu-navy); font-size: 0.9rem;">
                  <i class="fas fa-bookmark me-1 text-warning"></i><%= c.acronym || 'CONFERENCE' %>
                </span>
                <span class="badge <%= statusClass %> px-2 py-1 rounded-pill small">
                  <%= c.status || 'Upcoming' %>
                </span>
              </div>
              
              <!-- Admin actions -->
              <% if (isAdmin) { %>
                <div class="btn-group btn-group-sm">
                  <button type="button" class="btn btn-outline-primary py-1 px-2" onclick="openEditConfModal(<%= c.id %>)" title="Edit conference">
                    <i class="fas fa-edit"></i>
                  </button>
                  <button type="button" class="btn btn-outline-danger py-1 px-2" onclick="openDeleteConfModal(<%= c.id %>, '<%= encodeURIComponent(c.title) %>')" title="Delete conference">
                    <i class="fas fa-trash-alt"></i>
                  </button>
                </div>
              <% } %>
            </div>

            <!-- Title & Organizer -->
            <h5 class="fw-bold text-dark mb-2 display-font" style="line-height: 1.35;">
              <%= c.title %>
            </h5>
            <div class="text-muted small mb-3">
              <span><i class="fas fa-university text-danger me-1"></i><%= c.organizer || 'Organizing Committee' %></span>
              <span class="mx-2">&bull;</span>
              <span><i class="fas fa-map-marker-alt text-primary me-1"></i><%= c.venue || 'Hybrid / Virtual' %></span>
            </div>

            <!-- Indexing Badges -->
            <div class="mb-3 d-flex flex-wrap gap-1">
              <% (c.indexing || 'Scopus').split(',').forEach(idxTag => { %>
                <span class="badge bg-light text-dark border small fw-semibold">
                  <i class="fas fa-check-circle text-success me-1"></i><%= idxTag.trim() %>
                </span>
              <% }) %>
            </div>

            <!-- Description -->
            <% if (c.description) { %>
              <p class="text-muted small mb-3 flex-grow-1" style="line-height: 1.5;">
                <%= c.description %>
              </p>
            <% } %>

            <!-- Key Dates Box -->
            <div class="date-badge mb-3">
              <div class="row g-2 text-center text-md-start">
                <div class="col-12 col-md-4">
                  <div class="text-muted" style="font-size: 0.72rem; text-transform: uppercase; font-weight: 700;">Conference Date</div>
                  <div class="fw-bold text-dark small"><%= c.conference_date || 'TBA' %></div>
                </div>
                <div class="col-12 col-md-4">
                  <div class="text-muted" style="font-size: 0.72rem; text-transform: uppercase; font-weight: 700;">Submission Deadline</div>
                  <div class="fw-bold text-danger small"><%= c.submission_deadline || 'TBA' %></div>
                </div>
                <div class="col-12 col-md-4">
                  <div class="text-muted" style="font-size: 0.72rem; text-transform: uppercase; font-weight: 700;">Notification</div>
                  <div class="fw-bold text-success small"><%= c.notification_date || 'TBA' %></div>
                </div>
              </div>
            </div>

            <!-- Footer links -->
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-auto pt-2 border-top">
              <div>
                <% if (c.website_url) { %>
                  <a href="<%= c.website_url %>" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                    <i class="fas fa-globe me-1"></i> Official Website
                  </a>
                <% } %>
              </div>
              <div>
                <% if (c.cfp_link) { %>
                  <a href="<%= c.cfp_link %>" target="_blank" class="btn btn-sm btn-danger rounded-pill px-3 fw-bold">
                    <i class="fas fa-paper-plane me-1"></i> Submit Paper / CFP
                  </a>
                <% } %>
              </div>
            </div>

          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- Add Conference Modal -->
  <div class="modal fade" id="addConferenceModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content border-0 shadow">
        <form action="/conferences/add" method="POST">
          <div class="modal-header bg-navy text-white" style="background: var(--cu-navy); color: white;">
            <h5 class="modal-title fw-bold">
              <i class="fas fa-calendar-plus me-2 text-warning"></i> Add Upcoming Conference
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body p-4">
            <div class="row g-3">
              <div class="col-md-8">
                <label class="form-label fw-bold small">Conference Full Title</label>
                <input type="text" name="title" class="form-control form-control-sm" placeholder="e.g. 2026 IEEE International Conference on Computing..." required>
              </div>
              <div class="col-md-4">
                <label class="form-label fw-bold small">Acronym / Code</label>
                <input type="text" name="acronym" class="form-control form-control-sm" placeholder="e.g. IEEE ICCCA 2026" required>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-bold small">Organizer / University</label>
                <input type="text" name="organizer" class="form-control form-control-sm" placeholder="e.g. IEEE &amp; Chandigarh University">
              </div>
              <div class="col-md-6">
                <label class="form-label fw-bold small">Venue / Mode</label>
                <input type="text" name="venue" class="form-control form-control-sm" placeholder="e.g. Chandigarh University, Mohali (Hybrid)">
              </div>

              <div class="col-md-4">
                <label class="form-label fw-bold small">Conference Dates</label>
                <input type="text" name="conference_date" class="form-control form-control-sm" placeholder="e.g. 18-20 December 2026">
              </div>
              <div class="col-md-4">
                <label class="form-label fw-bold small">Submission Deadline</label>
                <input type="text" name="submission_deadline" class="form-control form-control-sm" placeholder="e.g. 30 October 2026">
              </div>
              <div class="col-md-4">
                <label class="form-label fw-bold small">Acceptance Notification</label>
                <input type="text" name="notification_date" class="form-control form-control-sm" placeholder="e.g. 15 November 2026">
              </div>

              <div class="col-md-6">
                <label class="form-label fw-bold small">Indexing Information</label>
                <input type="text" name="indexing" class="form-control form-control-sm" value="Scopus, IEEE Xplore, Web of Science" placeholder="Comma separated, e.g. Scopus, IEEE Xplore">
              </div>
              <div class="col-md-6">
                <label class="form-label fw-bold small">Status</label>
                <select name="status" class="form-select form-select-sm">
                  <option value="Call for Papers Open">Call for Papers Open</option>
                  <option value="Upcoming" selected>Upcoming</option>
                  <option value="Deadline Extended">Deadline Extended</option>
                  <option value="Completed">Completed</option>
                </select>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-bold small">Official Website Link</label>
                <input type="url" name="website_url" class="form-control form-control-sm" placeholder="https://...">
              </div>
              <div class="col-md-6">
                <label class="form-label fw-bold small">Call for Papers / Submission Portal Link</label>
                <input type="url" name="cfp_link" class="form-control form-control-sm" placeholder="https://easychair.org/...">
              </div>

              <div class="col-12">
                <label class="form-label fw-bold small">Description / Tracks / Highlights</label>
                <textarea name="description" class="form-control form-control-sm" rows="3" placeholder="Key topics: AI, Cybersecurity, Cloud, Big Data, etc."></textarea>
              </div>
            </div>
          </div>
          <div class="modal-footer bg-light">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary btn-sm fw-bold">
              <i class="fas fa-plus-circle me-1"></i> Add Conference
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Edit Conference Modal -->
  <div class="modal fade" id="editConferenceModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content border-0 shadow">
        <form id="editConferenceForm" action="" method="POST">
          <div class="modal-header bg-navy text-white" style="background: var(--cu-navy); color: white;">
            <h5 class="modal-title fw-bold">
              <i class="fas fa-edit me-2 text-warning"></i> Edit Conference Details
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body p-4">
            <div class="row g-3">
              <div class="col-md-8">
                <label class="form-label fw-bold small">Conference Full Title</label>
                <input type="text" name="title" id="edit_conf_title" class="form-control form-control-sm" required>
              </div>
              <div class="col-md-4">
                <label class="form-label fw-bold small">Acronym / Code</label>
                <input type="text" name="acronym" id="edit_conf_acronym" class="form-control form-control-sm" required>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-bold small">Organizer / University</label>
                <input type="text" name="organizer" id="edit_conf_organizer" class="form-control form-control-sm">
              </div>
              <div class="col-md-6">
                <label class="form-label fw-bold small">Venue / Mode</label>
                <input type="text" name="venue" id="edit_conf_venue" class="form-control form-control-sm">
              </div>

              <div class="col-md-4">
                <label class="form-label fw-bold small">Conference Dates</label>
                <input type="text" name="conference_date" id="edit_conf_conference_date" class="form-control form-control-sm">
              </div>
              <div class="col-md-4">
                <label class="form-label fw-bold small">Submission Deadline</label>
                <input type="text" name="submission_deadline" id="edit_conf_submission_deadline" class="form-control form-control-sm">
              </div>
              <div class="col-md-4">
                <label class="form-label fw-bold small">Acceptance Notification</label>
                <input type="text" name="notification_date" id="edit_conf_notification_date" class="form-control form-control-sm">
              </div>

              <div class="col-md-6">
                <label class="form-label fw-bold small">Indexing Information</label>
                <input type="text" name="indexing" id="edit_conf_indexing" class="form-control form-control-sm">
              </div>
              <div class="col-md-6">
                <label class="form-label fw-bold small">Status</label>
                <select name="status" id="edit_conf_status" class="form-select form-select-sm">
                  <option value="Call for Papers Open">Call for Papers Open</option>
                  <option value="Upcoming">Upcoming</option>
                  <option value="Deadline Extended">Deadline Extended</option>
                  <option value="Completed">Completed</option>
                </select>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-bold small">Official Website Link</label>
                <input type="url" name="website_url" id="edit_conf_website_url" class="form-control form-control-sm">
              </div>
              <div class="col-md-6">
                <label class="form-label fw-bold small">CFP / Submission Link</label>
                <input type="url" name="cfp_link" id="edit_conf_cfp_link" class="form-control form-control-sm">
              </div>

              <div class="col-12">
                <label class="form-label fw-bold small">Description / Scope</label>
                <textarea name="description" id="edit_conf_description" class="form-control form-control-sm" rows="3"></textarea>
              </div>
            </div>
          </div>
          <div class="modal-footer bg-light">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary btn-sm fw-bold">
              <i class="fas fa-save me-1"></i> Save Conference
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Delete Single Conference Confirmation Modal -->
  <div class="modal fade" id="deleteConfModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow">
        <form id="deleteConfForm" action="" method="POST">
          <div class="modal-header bg-danger text-white">
            <h5 class="modal-title fw-bold">
              <i class="fas fa-trash-alt me-2"></i> Delete Conference
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body p-4 text-center">
            <div class="p-3 bg-danger bg-opacity-10 text-danger rounded-circle d-inline-flex mb-3 fs-3">
              <i class="fas fa-calendar-times"></i>
            </div>
            <h5 class="fw-bold mb-2">Confirm Delete Conference?</h5>
            <p class="text-muted small mb-0" id="deleteConfMsg">
              Are you sure you want to remove this conference from the upcoming events list?
            </p>
          </div>
          <div class="modal-footer bg-light justify-content-center">
            <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-danger btn-sm px-3 fw-bold">
              <i class="fas fa-trash-alt me-1"></i> Yes, Delete Conference
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Bulk Delete Conferences Modal -->
  <div class="modal fade" id="bulkDeleteConfModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow">
        <form action="/conferences/delete-multiple" method="POST">
          <input type="hidden" name="ids" id="bulkDeleteConfIdsInput" value="">
          <div class="modal-header bg-danger text-white">
            <h5 class="modal-title fw-bold">
              <i class="fas fa-trash-alt me-2"></i> Delete Multiple Conferences
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body p-4 text-center">
            <div class="p-3 bg-danger bg-opacity-10 text-danger rounded-circle d-inline-flex mb-3 fs-3">
              <i class="fas fa-layer-group"></i>
            </div>
            <h5 class="fw-bold mb-2">Delete <span id="bulkDeleteConfCountText">0</span> Conferences?</h5>
            <p class="text-muted small mb-0">
              Are you sure you want to permanently delete the selected conference entries?
            </p>
          </div>
          <div class="modal-footer bg-light justify-content-center">
            <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-danger btn-sm px-4 fw-bold">
              <i class="fas fa-trash-alt me-1"></i> Yes, Delete Selected
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer class="portal-footer bg-white border-top py-4 text-center mt-auto">
    <div class="container-fluid px-4">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span class="text-muted small">
          <i class="fas fa-university me-1 text-danger"></i> UIC Research Portal &bull; Department of Computing, Chandigarh University &copy; <%= new Date().getFullYear() %>
        </span>
        <div class="d-flex align-items-center gap-3 small">
          <a href="/" class="text-muted text-decoration-none">Home</a>
          <a href="/publications" class="text-danger fw-bold text-decoration-none">Publications</a>
          <a href="/conferences" class="text-primary fw-bold text-decoration-none">Conferences</a>
          <a href="/portal" class="text-muted text-decoration-none">Faculty Directory</a>
        </div>
      </div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function filterConferences() {
      const searchVal = (document.getElementById('liveSearchConf').value || '').toLowerCase().trim();
      const statusVal = (document.getElementById('statusFilter').value || 'all').toLowerCase();
      const indexingVal = (document.getElementById('indexingFilter').value || 'all').toLowerCase();

      const items = document.querySelectorAll('.conf-item-col');
      let visible = 0;

      items.forEach(item => {
        const itemSearch = item.getAttribute('data-search') || '';
        const itemStatus = item.getAttribute('data-status') || '';
        const itemIndexing = item.getAttribute('data-indexing') || '';

        const matchesSearch = !searchVal || itemSearch.includes(searchVal);
        const matchesStatus = (statusVal === 'all') || (itemStatus === statusVal);
        const matchesIndexing = (indexingVal === 'all') || itemIndexing.includes(indexingVal);

        if (matchesSearch && matchesStatus && matchesIndexing) {
          item.style.display = '';
          visible++;
        } else {
          item.style.display = 'none';
        }
      });

      const countDisplay = document.getElementById('visibleConfCount');
      if (countDisplay) countDisplay.textContent = visible;
      updateConfSelectionToolbar();
    }

    function resetConfFilters() {
      document.getElementById('liveSearchConf').value = '';
      document.getElementById('statusFilter').value = 'all';
      document.getElementById('indexingFilter').value = 'all';
      filterConferences();
    }

    // Selection & Bulk Delete
    function onConfSelectChange() {
      updateConfSelectionToolbar();
    }

    function getSelectedConfIds() {
      const selected = [];
      document.querySelectorAll('.conf-select-check:checked').forEach(c => selected.push(c.value));
      return selected;
    }

    function clearAllConfSelections() {
      document.querySelectorAll('.conf-select-check').forEach(c => c.checked = false);
      updateConfSelectionToolbar();
    }

    function updateConfSelectionToolbar() {
      const selected = getSelectedConfIds();
      const toolbar = document.getElementById('confSelectionToolbar');
      const countSpan = document.getElementById('selectedConfCount');
      if (countSpan) countSpan.textContent = selected.length;
      if (toolbar) {
        if (selected.length > 0) {
          toolbar.classList.remove('d-none');
          toolbar.classList.add('d-flex');
        } else {
          toolbar.classList.add('d-none');
          toolbar.classList.remove('d-flex');
        }
      }
    }

    function openBulkDeleteConfModal() {
      const selected = getSelectedConfIds();
      if (selected.length === 0) {
        alert('Please select at least one conference to delete.');
        return;
      }
      document.getElementById('bulkDeleteConfIdsInput').value = selected.join(',');
      document.getElementById('bulkDeleteConfCountText').textContent = selected.length;
      new bootstrap.Modal(document.getElementById('bulkDeleteConfModal')).show();
    }

    async function openEditConfModal(confId) {
      try {
        const res = await fetch('/api/conferences/' + confId);
        const data = await res.json();
        if (!data.ok || !data.conference) {
          alert('Could not load conference: ' + (data.error || 'Not found'));
          return;
        }
        const c = data.conference;
        document.getElementById('editConferenceForm').action = '/conferences/' + confId + '/edit';
        document.getElementById('edit_conf_title').value = c.title || '';
        document.getElementById('edit_conf_acronym').value = c.acronym || '';
        document.getElementById('edit_conf_organizer').value = c.organizer || '';
        document.getElementById('edit_conf_venue').value = c.venue || '';
        document.getElementById('edit_conf_conference_date').value = c.conference_date || '';
        document.getElementById('edit_conf_submission_deadline').value = c.submission_deadline || '';
        document.getElementById('edit_conf_notification_date').value = c.notification_date || '';
        document.getElementById('edit_conf_indexing').value = c.indexing || '';
        document.getElementById('edit_conf_status').value = c.status || 'Upcoming';
        document.getElementById('edit_conf_website_url').value = c.website_url || '';
        document.getElementById('edit_conf_cfp_link').value = c.cfp_link || '';
        document.getElementById('edit_conf_description').value = c.description || '';

        new bootstrap.Modal(document.getElementById('editConferenceModal')).show();
      } catch (e) {
        alert('Error: ' + e.message);
      }
    }

    function openDeleteConfModal(confId, encodedTitle) {
      const title = decodeURIComponent(encodedTitle || '');
      document.getElementById('deleteConfForm').action = '/conferences/' + confId + '/delete';
      document.getElementById('deleteConfMsg').innerHTML = 
        'Are you sure you want to remove conference: <strong>' + title + '</strong>?';
      new bootstrap.Modal(document.getElementById('deleteConfModal')).show();
    }
  </script>
</body>
</html>
