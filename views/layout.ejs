<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>UIC Research Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
  <script src="/js/theme.js"></script>
</head>
<body>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark portal-nav">
  <div class="container-fluid px-4">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <div class="brand-icon"><i class="fas fa-flask"></i></div>
      <div>
        <div class="brand-title">UIC Research Portal</div>
        <div class="brand-sub">Department Research Management System</div>
      </div>
    </a>
    <div class="ms-auto d-flex align-items-center gap-2">
      <div class="dropdown">
        <button class="nav-link-btn dropdown-toggle border-0 bg-transparent text-white" type="button" data-bs-toggle="dropdown">
          <i class="fas fa-flask me-1 text-warning"></i>Research
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow border-0 py-2 rounded-3">
          <li><a class="dropdown-item py-2" href="/#overview"><i class="fas fa-chart-pie me-2 text-secondary"></i>Research Overview</a></li>
          <li><a class="dropdown-item py-2" href="/#leadership"><i class="fas fa-users-cog me-2 text-danger"></i>My Director &amp; Heads</a></li>
          <li><a class="dropdown-item py-2" href="/#coordinator"><i class="fas fa-user-tie me-2 text-success"></i>Research Coordinator</a></li>
          <li><hr class="dropdown-divider my-1"></li>
          <li><a class="dropdown-item py-2 fw-bold text-danger" href="/publications"><i class="fas fa-book-open me-2 text-danger"></i>Publications Database</a></li>
          <li><a class="dropdown-item py-2 text-primary" href="/conferences"><i class="fas fa-calendar-alt me-2 text-primary"></i>Upcoming Conferences</a></li>
        </ul>
      </div>
      <div class="dropdown">
        <button class="nav-link-btn dropdown-toggle border-0 bg-transparent text-white" type="button" data-bs-toggle="dropdown">
          <i class="fas fa-university me-1 text-info"></i>My Campus
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow border-0 py-2 rounded-3">
          <li><a class="dropdown-item py-2" href="/#campus"><i class="fas fa-building me-2 text-secondary"></i>Campus Infrastructure</a></li>
          <li><a class="dropdown-item py-2 fw-bold text-danger" href="/#monthly-ros"><i class="fas fa-chart-line me-2 text-danger"></i>ROS &amp; Growth</a></li>
          <li><a class="dropdown-item py-2" href="/#top-performers"><i class="fas fa-trophy me-2 text-warning"></i>Top Performers</a></li>
        </ul>
      </div>
      <a href="/portal" class="nav-link-btn"><i class="fas fa-users me-1"></i>Faculty Directory</a>
      <a href="/faculty/add" class="btn btn-add">
        <i class="fas fa-user-plus me-1"></i>Add Faculty
      </a>
    </div>
  </div>
</nav>

<!-- Main Content -->
<main class="main-content">
  <div class="container-fluid px-4">

    <%- body %>

  </div>
</main>

<!-- Footer -->
<footer class="portal-footer">
  <div class="container-fluid px-4 text-center">
    <span><i class="fas fa-university me-1"></i>UIC Research Portal &copy; <%= new Date().getFullYear() %> &mdash; Department Research Management System</span>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/app.js"></script>
</body>
</html>
