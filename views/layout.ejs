<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>UIC Research Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark portal-nav">
  <div class="container-fluid px-4">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <div class="brand-icon"><i class="fas fa-flask"></i></div>
      <div>
        <div class="brand-title">UIC Research Portal</div>
        <div class="brand-sub">Department Research Management System</div>
      </div>
    </a>
    <div class="ms-auto d-flex align-items-center gap-3">
      <a href="/" class="nav-link-btn"><i class="fas fa-home me-1"></i>Dashboard</a>
      <a href="/faculty/add" class="btn btn-add">
        <i class="fas fa-user-plus me-1"></i>Add Faculty
      </a>
    </div>
  </div>
</nav>

<!-- Main Content -->
<main class="main-content">
  <div class="container-fluid px-4">

    <%- body %>

  </div>
</main>

<!-- Footer -->
<footer class="portal-footer">
  <div class="container-fluid px-4 text-center">
    <span><i class="fas fa-university me-1"></i>UIC Research Portal &copy; <%= new Date().getFullYear() %> &mdash; Department Research Management System</span>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/app.js"></script>
</body>
</html>
