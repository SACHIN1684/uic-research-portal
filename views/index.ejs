<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — UIC Research Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark portal-nav">
  <div class="container-fluid px-4">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/portal">
      <div class="brand-icon"><i class="fas fa-flask"></i></div>
      <div>
        <div class="brand-title">UIC Research Portal</div>
        <div class="brand-sub">University Institute of Computing, Chandigarh University</div>
      </div>
    </a>
    <div class="ms-auto d-flex align-items-center gap-2 flex-wrap">
      <div class="dropdown">
        <button class="btn btn-outline-light btn-sm fw-semibold dropdown-toggle" type="button" data-bs-toggle="dropdown">
          <i class="fas fa-flask me-1 text-warning"></i>Research
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow border-0 py-2 rounded-3">
          <li><a class="dropdown-item py-2" href="/#overview"><i class="fas fa-chart-pie me-2 text-secondary"></i>Research Overview</a></li>
          <li><a class="dropdown-item py-2" href="/#leadership"><i class="fas fa-users-cog me-2 text-danger"></i>My Director &amp; Heads</a></li>
          <li><a class="dropdown-item py-2" href="/#coordinator"><i class="fas fa-user-tie me-2 text-success"></i>Research Coordinator</a></li>
          <li><hr class="dropdown-divider my-1"></li>
          <li><a class="dropdown-item py-2 fw-bold text-danger" href="/publications"><i class="fas fa-book-open me-2 text-danger"></i>Publications Database</a></li>
          <li><a class="dropdown-item py-2 text-primary" href="/conferences"><i class="fas fa-calendar-alt me-2 text-primary"></i>Upcoming Conferences</a></li>
          <li><a class="dropdown-item py-2 fw-bold text-warning" href="/patents"><i class="fas fa-certificate me-2 text-warning"></i>Patents &amp; Inventions</a></li>
        </ul>
      </div>
      <div class="dropdown">
        <button class="btn btn-outline-light btn-sm fw-semibold dropdown-toggle" type="button" data-bs-toggle="dropdown">
          <i class="fas fa-university me-1 text-info"></i>My Campus
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow border-0 py-2 rounded-3">
          <li><a class="dropdown-item py-2" href="/#campus"><i class="fas fa-building me-2 text-secondary"></i>Campus Infrastructure</a></li>
          <li><a class="dropdown-item py-2 fw-bold text-danger" href="/#monthly-ros"><i class="fas fa-chart-line me-2 text-danger"></i>ROS &amp; Growth</a></li>
          <li><a class="dropdown-item py-2" href="/#top-performers"><i class="fas fa-trophy me-2 text-warning"></i>Top Performers</a></li>
        </ul>
      </div>
      <a href="/" class="btn btn-outline-light btn-sm fw-semibold">
        <i class="fas fa-home me-1"></i>Home & About
      </a>
      <% if (isAdmin) { %>
        <!-- Saturday Roster Off Eligibility Modal Trigger -->
        <button class="btn btn-info btn-sm fw-bold text-dark shadow-sm" data-bs-toggle="modal" data-bs-target="#saturdayRosterModal">
          <i class="fas fa-calendar-check me-1"></i>Saturday Roster Off
        </button>

        <!-- 1. Master Excel Upload (Directly adds papers by Author Name Column D) -->
        <button class="btn btn-warning btn-sm fw-bold text-dark shadow-sm" data-bs-toggle="modal" data-bs-target="#masterUploadModal">
          <i class="fas fa-file-import me-1"></i>Upload Master Publications Excel
        </button>

        <!-- 2. Excel Export Button -->
        <a href="/export/excel" class="btn btn-success btn-sm fw-semibold shadow-sm">
          <i class="fas fa-file-excel me-1"></i>Export Tracking Excel
        </a>

        <!-- 3. Bulk Faculty List Upload -->
        <button class="btn btn-light btn-sm fw-semibold text-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#bulkUploadModal">
          <i class="fas fa-users me-1"></i>Upload Faculty List
        </button>

        <!-- 4. Add Single Faculty -->
        <a href="/faculty/add" class="btn btn-add btn-sm">
          <i class="fas fa-user-plus me-1"></i>Add Faculty
        </a>

        <!-- Admin Undo / Redo Controls -->
        <div class="btn-group btn-group-sm shadow-sm" role="group" aria-label="Undo Redo">
          <form action="/admin/undo" method="POST" class="d-inline">
            <input type="hidden" name="return_to" value="/portal">
            <button type="submit" class="btn btn-outline-light btn-sm fw-semibold" <%= !historyStatus.canUndo ? 'disabled' : '' %> title="<%= historyStatus.canUndo ? 'Undo: ' + historyStatus.undoLabel : 'Nothing to Undo' %>">
              <i class="fas fa-undo me-1"></i>Undo
            </button>
          </form>
          <form action="/admin/redo" method="POST" class="d-inline">
            <input type="hidden" name="return_to" value="/portal">
            <button type="submit" class="btn btn-outline-light btn-sm fw-semibold" <%= !historyStatus.canRedo ? 'disabled' : '' %> title="<%= historyStatus.canRedo ? 'Redo: ' + historyStatus.redoLabel : 'Nothing to Redo' %>">
              <i class="fas fa-redo me-1"></i>Redo
            </button>
          </form>
        </div>

        <!-- Admin Badge & Logout -->
        <div class="position-relative">
          <a href="/admin/profile-requests" class="btn btn-warning btn-sm fw-semibold text-dark" title="Profile Visibility Requests">
            <i class="fas fa-user-lock me-1"></i>Requests
          </a>
          <% if (typeof pendingProfileReqCount !== 'undefined' && pendingProfileReqCount > 0) { %>
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:0.6rem;z-index:10;">
              <%= pendingProfileReqCount %>
            </span>
          <% } %>
        </div>
        <div class="position-relative">
          <a href="/admin/documents" class="btn btn-warning btn-sm fw-semibold text-dark" title="Research Documents">
            <i class="fas fa-file-shield me-1"></i>Docs
          </a>
          <% if (typeof pendingDocCount !== 'undefined' && pendingDocCount > 0) { %>
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:0.6rem;z-index:10;">
              <%= pendingDocCount %>
            </span>
          <% } %>
        </div>
        <button type="button" class="btn btn-outline-warning btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#portalAdminSettingsModal" title="Admin Credentials">
          <i class="fas fa-user-shield me-1"></i><%= adminUsername %>
        </button>
        <form action="/admin/logout" method="POST" class="d-inline">
          <input type="hidden" name="return_to" value="/portal">
          <button type="submit" class="btn btn-outline-danger btn-sm fw-semibold" title="Logout Admin">
            <i class="fas fa-sign-out-alt me-1"></i>Logout
          </button>
        </form>
      <% } else { %>
        <span class="badge bg-light text-dark py-2 px-3">
          <i class="fas fa-eye text-primary me-1"></i>Visitor View (Read-Only)
        </span>
        <button type="button" class="btn btn-warning btn-sm fw-bold text-dark shadow-sm" data-bs-toggle="modal" data-bs-target="#portalAdminLoginModal">
          <i class="fas fa-user-shield me-1"></i>Admin Login
        </button>
      <% } %>
    </div>
  </div>
</nav>

<main class="main-content">
  <div class="container-fluid px-4">

    <!-- Page Header & View Toggle -->
    <div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
      <div>
        <h1 class="page-title"><i class="fas fa-users me-2"></i>Faculty Research Directory</h1>
        <p class="page-sub">
          <% if (isAdmin) { %>
            Admin Mode &mdash; Upload papers, edit faculty profiles, manage publications, and track ROS scores.
          <% } else { %>
            University Institute of Computing, Chandigarh University &mdash; Browse faculty profiles, search by name or employee code, and view publications.
          <% } %>
        </p>
      </div>
      <div class="btn-group shadow-sm" role="group">
        <button type="button" id="gridViewBtn" onclick="setPortalViewMode('grid')" class="btn btn-sm <%= viewMode !== 'list' ? 'btn-primary' : 'btn-outline-primary' %>" title="Switch to Grid View">
          <i class="fas fa-th-large me-1"></i>Grid View
        </button>
        <button type="button" id="listViewBtn" onclick="setPortalViewMode('list')" class="btn btn-sm <%= viewMode === 'list' ? 'btn-primary' : 'btn-outline-primary' %>" title="Switch to List View">
          <i class="fas fa-list me-1"></i>List View
        </button>
      </div>
    </div>

    <!-- Alert notifications -->
    <% if (query.admin_logged_in) { %>
      <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-user-shield me-2 fs-5 align-middle"></i>
        <strong>Admin Mode Active (<%= adminUsername %>)!</strong> You now have full rights to add, edit, upload, and delete records.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (query.login_err) { %>
      <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle me-2 fs-5 align-middle"></i>
        <strong>Admin Login Failed:</strong> <%= query.login_err %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (query.cred_updated) { %>
      <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-key me-2 fs-5 align-middle"></i>
        <strong>Admin Credentials Updated!</strong> Username and password have been saved.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (query.vis_updated) { %>
      <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-<%= query.vis === 'private' ? 'lock' : 'lock-open' %> me-2 fs-5 align-middle"></i>
        <strong>Visibility Updated!</strong> Successfully set <strong><%= query.vis_updated %></strong> faculty profile(s) to <strong><%= (query.vis || 'public').toUpperCase() %></strong>.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (query.cred_err) { %>
      <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle me-2 fs-5 align-middle"></i>
        <strong>Credential Update Failed:</strong> <%= query.cred_err %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (query.undo_done) { %>
      <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-undo me-2 fs-5 align-middle"></i>
        <strong>Undo Complete:</strong> Reverted "<%= query.undo_done %>".
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (query.redo_done) { %>
      <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-redo me-2 fs-5 align-middle"></i>
        <strong>Redo Complete:</strong> Re-applied "<%= query.redo_done %>".
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (query.history_err) { %>
      <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-info-circle me-2 fs-5 align-middle"></i>
        <%= query.history_err %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (query.master_success) { %>
      <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2 fs-5 align-middle"></i>
        <strong>Master Publication Excel Processed!</strong> Uploaded <strong><%= query.matched %></strong> matched publication(s)<% if (query.replaced > 0) { %>, replaced <strong><%= query.replaced %></strong> existing<% } %><% if (query.skipped > 0) { %>, skipped <strong><%= query.skipped %></strong> duplicate(s)<% } %>.
        <% if (query.unmatched > 0) { %>
          <div class="mt-1 small text-dark">
            <i class="fas fa-exclamation-triangle text-danger me-1"></i>
            <strong class="text-danger"><%= query.unmatched %> row(s) moved to Pending</strong> because the faculty name was not found in the directory (see highlighted Pending section below).
          </div>
        <% } %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <% if (isAdmin && ((typeof pendingReport !== 'undefined' && pendingReport && pendingReport.pendingRows && pendingReport.pendingRows.length > 0) || query.unmatched > 0)) { %>
      <div class="card border-danger border-2 shadow-sm rounded-3 mb-4 overflow-hidden" style="background-color: #fffbeb;">
        <div class="card-header bg-danger text-white py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
          <div>
            <h5 class="mb-0 fw-bold">
              <i class="fas fa-user-clock me-2"></i>
              Pending Faculty Publications &mdash; Names Not Found (<%= (pendingReport && pendingReport.pendingRows) ? pendingReport.pendingRows.length : query.unmatched %> row(s))
            </h5>
            <div class="small text-white-50">
              Matched faculty rows have been uploaded above. Add these missing faculty members to the directory, then upload the pending sheet.
            </div>
          </div>
          <div class="d-flex gap-2 flex-wrap">
            <% if (pendingReport && pendingReport.id) { %>
              <a href="/dashboard/download-pending-master?pending_id=<%= encodeURIComponent(pendingReport.id) %>" class="btn btn-light btn-sm fw-bold text-danger shadow-sm">
                <i class="fas fa-file-excel me-1"></i>Download Pending Rows Excel
              </a>
            <% } %>
            <a href="/faculty/add" class="btn btn-warning btn-sm fw-bold text-dark shadow-sm">
              <i class="fas fa-user-plus me-1"></i>Add Missing Faculty
            </a>
          </div>
        </div>
        <div class="card-body p-4">
          <% if (pendingReport && pendingReport.uniquePendingNames && pendingReport.uniquePendingNames.length > 0) { %>
            <div class="mb-3">
              <div class="fw-bold small text-dark mb-2">
                <i class="fas fa-highlighter text-danger me-1"></i>
                Highlighted Pending Faculty Names (<%= pendingReport.uniquePendingNames.length %> not found):
              </div>
              <div class="d-flex flex-wrap gap-2">
                <% pendingReport.uniquePendingNames.forEach(item => { %>
                  <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-3 bg-white border border-danger shadow-sm">
                    <span class="fw-bold text-danger"><%= item.name %></span>
                    <span class="badge bg-secondary"><%= item.department %></span>
                    <span class="badge bg-warning text-dark"><%= item.count %> <%= item.count === 1 ? 'paper' : 'papers' %></span>
                    <a href="/faculty/add?name=<%= encodeURIComponent(item.name) %>&department=<%= encodeURIComponent(item.department) %>" class="btn btn-outline-primary btn-sm py-0 px-2 fw-semibold" title="Add this faculty to directory">
                      <i class="fas fa-plus me-1"></i>Add
                    </a>
                  </div>
                <% }) %>
              </div>
            </div>
          <% } else if (query.unmatched_names) { %>
            <div class="mb-2">
              <span class="fw-bold text-danger">Pending Faculty Names:</span>
              <mark class="fw-bold px-2 py-1 rounded"><%= query.unmatched_names %></mark>
            </div>
          <% } %>

          <% if (pendingReport && pendingReport.pendingRows && pendingReport.pendingRows.length > 0) { %>
            <div class="table-responsive bg-white rounded-3 border" style="max-height: 320px;">
              <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-warning sticky-top">
                  <tr>
                    <th>Row #</th>
                    <th>Pending Faculty Name</th>
                    <th>Department</th>
                    <th>Publication Title</th>
                    <th class="text-center">Quartile</th>
                    <th class="text-center">ROS</th>
                    <th class="text-center">Month</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% pendingReport.pendingRows.forEach(pr => { %>
                    <tr>
                      <td class="fw-bold text-muted">#<%= pr.rowNo %></td>
                      <td>
                        <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1 fs-6 fw-bold">
                          <%= pr.authorName %>
                        </span>
                      </td>
                      <td><span class="badge bg-light text-dark border"><%= pr.pubDepartment %></span></td>
                      <td class="small text-dark" style="max-width: 340px;"><%= pr.title %></td>
                      <td class="text-center"><span class="badge bg-secondary"><%= pr.quartile %></span></td>
                      <td class="text-center fw-bold"><%= parseFloat(pr.ros || 0).toFixed(2) %></td>
                      <td class="text-center small text-muted"><%= pr.month %></td>
                      <td><span class="badge bg-warning text-dark">Pending (<%= pr.reason %>)</span></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    <% } %>
    <% if (query.master_err) { %>
      <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle me-2 fs-5 align-middle"></i>
        <strong>Master Upload Error:</strong> <%= query.master_err %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
    <% if (query.upload_success) { %>
      <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2 fs-5 align-middle"></i>
        <strong>Faculty List Processed!</strong> Added <strong><%= query.added %></strong> new<% if (query.replaced > 0) { %>, replaced/updated <strong><%= query.replaced %></strong> existing<% } %><% if (query.skipped > 0) { %>, skipped <strong><%= query.skipped %></strong><% } %>.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
    <% if (query.upload_err) { %>
      <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle me-2 fs-5 align-middle"></i>
        <strong>Faculty Upload Error:</strong> <%= query.upload_err %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
    <% if (query.bulk_deleted) { %>
      <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-trash-alt me-2 fs-5 align-middle"></i>
        Successfully deleted <strong><%= query.bulk_deleted %></strong> selected faculty profile(s) and their associated records.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
    <% if (query.all_deleted) { %>
      <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-trash-alt me-2 fs-5 align-middle"></i>
        All <strong><%= query.all_deleted %></strong> faculty profiles and records have been deleted.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
    <% if (query.deleted) { %>
      <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-info-circle me-2 fs-5 align-middle"></i>
        Faculty member profile successfully removed.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <% if (query.counting_updated) { %>
      <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2 fs-5 align-middle"></i>
        <strong>Home ROS Table Counting Mode Updated:</strong>
        <%= pubCountingMode === 'separate' ? 'Each author row is now counted separately in the Department ROS table.' : 'Shared papers across multiple CU faculty are now counted as 1 unique publication in the Department ROS table.' %>
        <a href="/#monthly-ros" class="btn btn-sm btn-primary ms-2 fw-bold">
          <i class="fas fa-table me-1"></i>View Live ROS Table on Home Page &rarr;
        </a>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <% if (isAdmin) { %>
    <!-- Home Page ROS Table Paper Counting Setting & Direct Link (Admin Control) -->
    <div class="card border-0 shadow-sm rounded-3 mb-4" style="background: linear-gradient(90deg, #fffbeb 0%, #fef2f2 100%); border-left: 4px solid #c8102e !important;">
      <div class="card-body p-3 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
          <div class="p-2 rounded bg-danger text-white"><i class="fas fa-sliders-h fs-4"></i></div>
          <div>
            <div class="fw-bold text-dark">
              Home ROS Table: Multi-Author Publication Counting Setting
              <span class="badge <%= pubCountingMode === 'separate' ? 'bg-warning text-dark' : 'bg-success' %> ms-2">
                Active: <%= pubCountingMode === 'separate' ? 'Separate per Author' : '1 Paper (Unique Publication)' %>
              </span>
            </div>
            <div class="text-muted small">
              Choose whether a paper co-authored by multiple CU faculty counts as <strong>1 publication</strong> or <strong>separate entries</strong> in the Home Page ROS table &amp; growth chart.
            </div>
          </div>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <form action="/admin/settings/counting-mode" method="POST" class="d-inline">
            <input type="hidden" name="return_to" value="/portal">
            <input type="hidden" name="mode" value="unique">
            <button type="submit" class="btn btn-sm fw-bold <%= pubCountingMode !== 'separate' ? 'btn-success shadow-sm' : 'btn-outline-success' %>">
              <i class="fas fa-check-double me-1"></i>Count as 1 Paper (Unique)
            </button>
          </form>
          <form action="/admin/settings/counting-mode" method="POST" class="d-inline">
            <input type="hidden" name="return_to" value="/portal">
            <input type="hidden" name="mode" value="separate">
            <button type="submit" class="btn btn-sm fw-bold <%= pubCountingMode === 'separate' ? 'btn-warning text-dark shadow-sm' : 'btn-outline-secondary' %>">
              <i class="fas fa-users me-1"></i>Count Separately
            </button>
          </form>
          <a href="/#monthly-ros" class="btn btn-primary btn-sm fw-bold shadow-sm">
            <i class="fas fa-table me-1"></i>Direct Link: Home ROS Table
          </a>
        </div>
      </div>
    </div>

    <!-- Master Upload Banner -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-light">
      <div class="card-body p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
          <div class="p-2 rounded bg-warning text-dark"><i class="fas fa-bolt fs-4"></i></div>
          <div>
            <div class="fw-bold text-dark">Direct Excel Publication Import</div>
            <div class="text-muted small">Upload your spreadsheet with <strong>Author names (CU)</strong> (Col D) and <strong>Document Type</strong> (Col H). The system matches the faculty name and auto-sorts each entry into <strong>Journal</strong> (Article/Review), <strong>Conference</strong>, <strong>Book Chapter</strong>, or <strong>Patent</strong>.</div>
          </div>
        </div>
        <div class="d-flex gap-2">
          <a href="/download-master-publications-template" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-download me-1"></i>Download Template
          </a>
          <button class="btn btn-warning btn-sm fw-bold text-dark" data-bs-toggle="modal" data-bs-target="#masterUploadModal">
            <i class="fas fa-upload me-1"></i>Upload Master Excel
          </button>
        </div>
      </div>
    </div>

    <!-- Saturday Roster Off Eligibility Quick Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4" style="background: linear-gradient(90deg, #eff6ff 0%, #f0fdf4 100%); border-left: 4px solid #0d6efd !important;">
      <div class="card-body p-3 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
          <div class="p-2 rounded bg-primary text-white"><i class="fas fa-calendar-check fs-4"></i></div>
          <div>
            <div class="fw-bold text-dark">Saturday Roster Off Eligibility (Variable ROS Threshold)</div>
            <div class="text-muted small">
              Set a threshold ROS score (e.g., <strong>0.50</strong>). Faculty with <strong>ROS &ge; Threshold</strong> qualify for Saturday roster off.
            </div>
          </div>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <div class="input-group input-group-sm shadow-sm" style="width: 175px;">
            <span class="input-group-text fw-bold bg-white text-primary">ROS &ge;</span>
            <input type="number" id="quickRosterThreshold" class="form-control fw-bold" step="0.01" min="0" value="0.50">
          </div>
          <button type="button" class="btn btn-primary btn-sm fw-semibold shadow-sm" onclick="openRosterModal()">
            <i class="fas fa-list-check me-1"></i>View Eligible (<span id="quickEligibleCount">0</span>)
          </button>
          <a href="/export/saturday-roster?threshold=0.50" id="quickRosterDownloadBtn" class="btn btn-success btn-sm fw-semibold shadow-sm">
            <i class="fas fa-file-excel me-1"></i>Download Eligible Excel
          </a>
        </div>
      </div>
    </div>
    <% } %>

    <!-- Stats Bar -->
    <div class="stats-row row g-3 mb-3">
      <div class="col-6 col-md-2">
        <div class="stat-card stat-total">
          <div class="stat-icon"><i class="fas fa-chalkboard-teacher"></i></div>
          <div class="stat-num"><%= memberStats.facultyCount %></div>
          <div class="stat-label">Faculty Members</div>
        </div>
      </div>
      <div class="col-6 col-md-2">
        <div class="stat-card stat-avg">
          <div class="stat-icon"><i class="fas fa-microscope"></i></div>
          <div class="stat-num"><%= memberStats.fellowCount %></div>
          <div class="stat-label">Research Fellows</div>
        </div>
      </div>
      <div class="col-6 col-md-2">
        <div class="stat-card" style="border-top: 3px solid #0891b2;">
          <div class="stat-icon" style="background: #cffafe; color: #0891b2;"><i class="fas fa-user-graduate"></i></div>
          <div class="stat-num"><%= memberStats.studentCount %></div>
          <div class="stat-label">Students</div>
        </div>
      </div>
      <div class="col-6 col-md-2">
        <div class="stat-card stat-avg">
          <div class="stat-icon"><i class="fas fa-chart-line"></i></div>
          <div class="stat-num"><%= avgROS %></div>
          <div class="stat-label">Average Dept ROS</div>
        </div>
      </div>
      <div class="col-6 col-md-2">
        <div class="stat-card stat-zero">
          <div class="stat-icon"><i class="fas fa-exclamation-circle"></i></div>
          <div class="stat-num"><%= zeroCount %></div>
          <div class="stat-label">Zero Pubs / ROS</div>
        </div>
      </div>
      <div class="col-6 col-md-2">
        <div class="stat-card stat-active">
          <div class="stat-icon"><i class="fas fa-award"></i></div>
          <div class="stat-num"><%= activeCount %></div>
          <div class="stat-label">Active Contributors</div>
        </div>
      </div>
    </div>

    <!-- Bifurcation & Active/Inactive Filter Bar -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 p-3 bg-white rounded-3 shadow-sm border">
      <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="small fw-bold text-muted me-1"><i class="fas fa-users-cog me-1 text-primary"></i>Category:</span>
        <button type="button" class="btn btn-sm btn-primary text-white fw-semibold cat-filter-btn active" data-cat="all">
          All (<%= totalFaculty %>)
        </button>
        <button type="button" class="btn btn-sm btn-outline-primary fw-semibold cat-filter-btn" data-cat="Faculty">
          <i class="fas fa-chalkboard-teacher me-1"></i>Faculty (<%= memberStats.facultyCount %>)
        </button>
        <button type="button" class="btn btn-sm btn-outline-primary fw-semibold cat-filter-btn" data-cat="Research Fellow" style="border-color:#7c3aed;color:#7c3aed;">
          <i class="fas fa-microscope me-1"></i>Research Fellows (<%= memberStats.fellowCount %>)
        </button>
        <button type="button" class="btn btn-sm btn-outline-success fw-semibold cat-filter-btn" data-cat="Student">
          <i class="fas fa-user-graduate me-1"></i>Students (<%= memberStats.studentCount %>)
        </button>
        <button type="button" class="btn btn-sm btn-outline-warning fw-semibold cat-filter-btn text-dark" data-cat="Other">
          <i class="fas fa-user-tag me-1"></i>Other (<%= memberStats.otherCount || 0 %>)
        </button>
      </div>
      <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="small fw-bold text-muted me-1"><i class="fas fa-circle me-1 text-success"></i>Status:</span>
        <div class="btn-group btn-group-sm" role="group">
          <button type="button" class="btn btn-outline-secondary fw-semibold status-filter-btn active" data-status-filter="all">
            All (<%= totalFaculty %>)
          </button>
          <button type="button" class="btn btn-outline-success fw-semibold status-filter-btn" data-status-filter="Active">
            <span style="width:9px;height:9px;border-radius:50%;background:#16a34a;display:inline-block;margin-right:4px;"></span>Active (<%= memberStats.activeStatusCount %>)
          </button>
          <button type="button" class="btn btn-outline-danger fw-semibold status-filter-btn" data-status-filter="Inactive">
            <span style="width:9px;height:9px;border-radius:50%;background:#dc2626;display:inline-block;margin-right:4px;"></span>Left / Inactive (<%= memberStats.inactiveStatusCount %>)
          </button>
        </div>
      </div>
      <% if (isAdmin) { %>
      <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="small fw-bold text-muted me-1"><i class="fas fa-eye me-1 text-warning"></i>Visibility:</span>
        <div class="btn-group btn-group-sm" role="group">
          <button type="button" class="btn btn-outline-secondary fw-semibold visibility-filter-btn active" data-visibility-filter="all">
            All (<%= totalFaculty %>)
          </button>
          <button type="button" class="btn btn-outline-success fw-semibold visibility-filter-btn" data-visibility-filter="public">
            <i class="fas fa-globe me-1"></i>Public (<%= memberStats.publicCount %>)
          </button>
          <button type="button" class="btn btn-outline-warning fw-semibold visibility-filter-btn text-dark" data-visibility-filter="private">
            <i class="fas fa-lock me-1"></i>Private (<%= memberStats.privateCount %>)
          </button>
        </div>
      </div>
      <% } %>
    </div>

    <!-- Filter, Sort & Search Bar -->
    <div class="filter-bar mb-4">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex flex-wrap align-items-center gap-2">
          <span class="filter-label"><i class="fas fa-filter me-1"></i>Filter by ROS:</span>
          <button class="filter-btn active" data-filter="all">
            <i class="fas fa-th me-1"></i>All Faculty (<%= totalFaculty %>)
          </button>
          <button class="filter-btn filter-zero" data-filter="zero">
            <i class="fas fa-times-circle me-1"></i>Zero ROS (<%= zeroCount %>)
          </button>
          <button class="filter-btn filter-low" data-filter="low">
            <i class="fas fa-arrow-down me-1"></i>Low ROS &lt; 0.3
          </button>
          <button class="filter-btn filter-moderate" data-filter="moderate">
            <i class="fas fa-minus me-1"></i>Moderate 0.3–0.6
          </button>
          <button class="filter-btn filter-good" data-filter="good">
            <i class="fas fa-arrow-up me-1"></i>Good &gt; 0.6
          </button>
        </div>

        <div class="d-flex align-items-center gap-3 flex-wrap">
          <div class="d-flex align-items-center gap-2">
            <label for="sortFacultySelect" class="small fw-bold text-muted text-nowrap mb-0">
              <i class="fas fa-sort-alpha-down me-1 text-primary"></i>Sort by:
            </label>
            <select id="sortFacultySelect" class="form-select form-select-sm fw-semibold border-primary shadow-sm" style="width: auto; min-width: 215px;">
              <option value="name_asc" <%= sortMode === 'name_asc' ? 'selected' : '' %>>Name (A &rarr; Z)</option>
              <option value="emp_asc" <%= sortMode === 'emp_asc' ? 'selected' : '' %>>Employee Code (Low &rarr; High)</option>
              <option value="emp_desc" <%= sortMode === 'emp_desc' ? 'selected' : '' %>>Employee Code (High &rarr; Low)</option>
              <option value="ros_desc" <%= sortMode === 'ros_desc' ? 'selected' : '' %>>ROS Score (High &rarr; Low)</option>
              <option value="ros_asc" <%= sortMode === 'ros_asc' ? 'selected' : '' %>>ROS Score (Low &rarr; High)</option>
            </select>
          </div>

          <% if (isAdmin) { %>
          <a href="/export/excel" class="text-success small fw-bold text-decoration-none d-flex align-items-center gap-1">
            <i class="fas fa-file-excel fs-6"></i> Download Excel (.xlsx)
          </a>
          <% } %>
        </div>
      </div>

      <div class="mt-3">
        <div class="search-wrap">
          <i class="fas fa-search search-icon"></i>
          <input type="text" id="searchInput" class="search-input" placeholder="Search by faculty name or employee code...">
          <button class="search-clear" id="clearSearch" title="Clear"><i class="fas fa-times"></i></button>
        </div>
      </div>
    </div>

    <!-- No results state -->
    <div id="noResults" class="text-center py-5" style="display:none;">
      <i class="fas fa-search fa-3x text-muted mb-3"></i>
      <h5 class="text-muted">No faculty found</h5>
      <p class="text-muted">Try a different search or filter option.</p>
    </div>

    <!-- Faculty List / Grid Views -->
    <% if (faculty.length === 0) { %>
      <div class="text-center py-5 bg-white rounded-3 shadow-sm p-4">
        <i class="fas fa-users-slash fa-4x text-muted mb-3 opacity-25"></i>
        <h4 class="text-dark">No faculty records found</h4>
        <% if (isAdmin) { %>
        <p class="text-muted mb-3">Upload your faculty list Excel sheet or add single records manually.</p>
        <div class="d-flex justify-content-center gap-2">
          <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#bulkUploadModal">
            <i class="fas fa-file-upload me-1"></i>Upload Faculty Excel
          </button>
          <a href="/faculty/add" class="btn btn-primary">
            <i class="fas fa-user-plus me-1"></i>Add Individual Faculty
          </a>
        </div>
        <% } else { %>
        <p class="text-muted mb-0">No faculty profiles have been published yet.</p>
        <% } %>
      </div>
    <% } else { %>

      <% if (isAdmin) { %>
      <!-- Unified Bulk Action Form (Visibility Public/Private & Delete) -->
      <form id="bulkFacultyForm" action="/faculty/bulk-action" method="POST">
        <input type="hidden" name="return_to" id="bulkFacultyReturnTo" value="/portal<%= viewMode === 'list' ? '?view=list' : '' %>">
        <input type="hidden" name="bulk_action" id="bulkFacultyActionInput" value="">
      </form>
      <div class="card border-0 shadow-sm rounded-3 mb-3 bg-white">
        <div class="card-body py-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
          <div class="d-flex align-items-center gap-3">
            <div class="form-check mb-0">
              <input type="checkbox" class="form-check-input" id="selectAllFaculty" style="cursor:pointer; transform: scale(1.15);">
              <label class="form-check-label fw-bold text-dark ms-1" for="selectAllFaculty" style="cursor:pointer;">
                Select All Visible (<span id="visibleFacultyCount"><%= faculty.length %></span>)
              </label>
            </div>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
              <span id="selectedFacultyCount">0</span> Selected
            </span>
          </div>
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <button type="button" id="makePublicFacultyBtn" class="btn btn-outline-success btn-sm fw-semibold" disabled>
              <i class="fas fa-globe me-1"></i>Make Public (<span id="publicBtnCount">0</span>)
            </button>
            <button type="button" id="makePrivateFacultyBtn" class="btn btn-outline-warning btn-sm text-dark fw-semibold" disabled>
              <i class="fas fa-lock me-1"></i>Make Private (<span id="privateBtnCount">0</span>)
            </button>
            <button type="button" id="deleteSelectedFacultyBtn" class="btn btn-outline-danger btn-sm fw-semibold" disabled>
              <i class="fas fa-trash-alt me-1"></i>Delete Selected (<span id="deleteBtnCount">0</span>)
            </button>
            <a href="/admin/documents" class="btn btn-outline-primary btn-sm fw-semibold" title="Manage Research Proof Documents">
              <i class="fas fa-file-shield me-1"></i>Research Docs Panel
            </a>
            <form action="/faculty/delete-all" method="POST" class="d-inline"
                  onsubmit="return confirm('WARNING: This will permanently delete ALL <%= faculty.length %> faculty members and ALL their publication records! Are you absolutely sure?');">
              <button type="submit" class="btn btn-danger btn-sm fw-semibold shadow-sm">
                <i class="fas fa-exclamation-triangle me-1"></i>Delete All (<%= faculty.length %>)
              </button>
            </form>
          </div>
        </div>
      </div>
      <% } %>

      <!-- 1. TABLE / LIST VIEW -->
      <div id="facultyListViewWrap" style="<%= viewMode === 'list' ? '' : 'display:none;' %>">
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-4">
          <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="mb-0 fw-bold text-primary"><i class="fas fa-list me-2"></i>Faculty Records (List View)</h5>
            <span class="badge bg-light text-dark border"><%= faculty.length %> Entries</span>
          </div>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="facultyTable">
              <thead class="table-light">
                <tr>
                  <% if (isAdmin) { %>
                  <th style="width: 3%;" class="text-center">
                    <input type="checkbox" id="tableSelectAll" class="form-check-input" title="Select All Visible" style="cursor:pointer;">
                  </th>
                  <% } %>
                  <th style="width: 3%;">#</th>
                  <th style="width: 20%;">Faculty Name & Details</th>
                  <th style="width: 10%;">Category</th>
                  <th style="width: 11%;">Employee Code / Scopus</th>
                  <th style="width: 10%;">Department</th>
                  <th style="width: 10%;" class="text-center">Visibility</th>
                  <th style="width: 10%;" class="text-center">Research Docs</th>
                  <th style="width: 11%;" class="text-center">Publications</th>
                  <th style="width: 6%;" class="text-center">ROS</th>
                  <th style="width: 6%;" class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody id="facultyTableBody">
                <% faculty.forEach((f, idx) => { %>
                  <%
                    const rc = rosColor(f.ros);
                    const rl = rosLabel(f.ros);
                    const initials = f.name.split(' ').map(w => w[0]).join('').substring(0, 2).toUpperCase();
                    const isMemberActive = (f.status || 'Active') !== 'Inactive';
                    const memberType = f.member_type || 'Faculty';
                    const theme = getMemberTypeTheme(memberType);
                    const isPriv = (f.visibility || 'public') === 'private';
                  %>
                  <tr class="faculty-card-wrap"
                      data-id="<%= f.id %>"
                      data-ros="<%= f.ros %>"
                      data-name="<%= f.name.toLowerCase() %>"
                      data-code="<%= f.employee_code.toLowerCase() %>"
                      data-scopus="<%= (f.scopus_id || '').toLowerCase() %>"
                      data-member-type="<%= memberType %>"
                      data-status="<%= isMemberActive ? 'Active' : 'Inactive' %>"
                      data-visibility="<%= isPriv ? 'private' : 'public' %>"
                      style="border-left: 3px solid <%= theme.color %>;">
                    <% if (isAdmin) { %>
                    <td class="text-center">
                      <input type="checkbox" name="faculty_ids" value="<%= f.id %>" form="bulkFacultyForm" class="form-check-input faculty-select-cb" data-faculty-id="<%= f.id %>" style="cursor:pointer;">
                    </td>
                    <% } %>
                    <td class="text-muted fw-bold serial-col"><%= idx + 1 %></td>
                    <td>
                      <div class="d-flex align-items-center gap-2">
                        <div class="position-relative flex-shrink-0">
                          <% if (f.photo) { %>
                            <img src="/uploads/<%= f.photo %>" class="rounded-circle border" style="width: 38px; height: 38px; object-fit: cover; border-color: <%= theme.borderColor %> !important;">
                          <% } else { %>
                            <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px; font-size: 0.8rem; background: <%= theme.avatarBg %>;">
                              <%= initials %>
                            </div>
                          <% } %>
                          <span title="<%= isMemberActive ? 'Active Member' : 'Inactive / Left Department' %>"
                                style="position:absolute; bottom:-1px; right:-1px; width:11px; height:11px; border-radius:50%; border:2px solid #fff; background:<%= isMemberActive ? '#16a34a' : '#dc2626' %>;"></span>
                        </div>
                        <div>
                          <div class="fw-bold text-dark d-flex align-items-center gap-1 flex-wrap">
                            <a href="/faculty/<%= f.id %>" class="text-dark text-decoration-none"><%= f.name %></a>
                            <% if (!isMemberActive) { %><span class="badge bg-danger-subtle text-danger border border-danger" style="font-size:0.62rem;">Left</span><% } %>
                          </div>
                          <div class="text-muted small" style="font-size:0.75rem;">
                            <%= f.designation || memberType %>
                          </div>
                          <div class="mt-1"><%- renderStarsHtml(f.ros, 'sm') %></div>
                        </div>
                      </div>
                    </td>
                    <td>
                      <span class="badge <%= theme.badgeClass %>" style="<%= theme.badgeStyle %>; font-size:0.72rem;">
                        <i class="<%= theme.icon %> me-1"></i><%= memberType %>
                      </span>
                    </td>
                    <td>
                      <span class="badge bg-light text-primary border font-monospace px-2 py-1 fs-6">
                        <%= f.employee_code %>
                      </span>
                      <% if (f.scopus_id) { %>
                        <div class="small text-muted font-monospace mt-1" style="font-size:0.72rem;">
                          <i class="fas fa-fingerprint me-1 text-warning"></i><%= f.scopus_id %>
                        </div>
                      <% } %>
                    </td>
                    <td><%= f.department || '—' %></td>
                    <td class="text-center">
                      <span class="badge <%= isPriv ? 'bg-warning text-dark border border-warning' : 'bg-success-subtle text-success border border-success' %> px-2 py-1" style="font-size:0.72rem;">
                        <i class="fas fa-<%= isPriv ? 'lock' : 'globe' %> me-1"></i><%= isPriv ? 'Private' : 'Public' %>
                      </span>
                      <% if (isAdmin) { %>
                        <div class="mt-1">
                          <form action="/faculty/<%= f.id %>/visibility" method="POST" class="d-inline">
                            <input type="hidden" name="return_to" value="/portal?view=list">
                            <button type="submit" class="btn btn-xs <%= isPriv ? 'btn-outline-success' : 'btn-outline-warning text-dark' %> py-0 px-2 fw-semibold" style="font-size:0.68rem;" title="Click to make <%= isPriv ? 'Public' : 'Private' %>">
                              <i class="fas fa-<%= isPriv ? 'lock-open' : 'lock' %> me-1"></i>Set <%= isPriv ? 'Public' : 'Private' %>
                            </button>
                          </form>
                        </div>
                      <% } %>
                    </td>
                    <td class="text-center">
                      <a href="/faculty/<%= f.id %>#documents" class="badge <%= f.pending_doc_count > 0 ? 'bg-danger text-white' : (f.doc_count > 0 ? 'bg-info-subtle text-info border border-info' : 'bg-light text-muted border') %> text-decoration-none px-2 py-1" style="font-size:0.72rem;" title="View & Manage Research Proof Documents">
                        <i class="fas fa-file-shield me-1"></i><%= f.doc_count %> Docs
                        <% if (f.pending_doc_count > 0) { %>
                          <span class="badge bg-warning text-dark ms-1"><%= f.pending_doc_count %> new</span>
                        <% } %>
                      </a>
                    </td>
                    <td class="text-center">
                      <% if (f.total_pubs === 0) { %>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size:0.68rem;">0 Papers</span>
                      <% } else { %>
                        <div class="d-flex justify-content-center flex-wrap gap-1">
                          <span class="badge bg-primary" style="font-size:0.68rem;">J: <%= f.journal_count %></span>
                          <% if (f.conf_count > 0) { %><span class="badge bg-warning text-dark" style="font-size:0.68rem;">C: <%= f.conf_count %></span><% } %>
                          <% if (f.book_count > 0) { %><span class="badge bg-success" style="font-size:0.68rem;">B: <%= f.book_count %></span><% } %>
                          <% if (f.patent_count > 0) { %><span class="badge bg-danger" style="font-size:0.68rem;">P: <%= f.patent_count %></span><% } %>
                        </div>
                        <small class="text-muted" style="font-size:0.72rem;">(<%= f.total_pubs %> Total)</small>
                      <% } %>
                    </td>
                    <td class="text-center">
                      <span class="badge bg-<%= rc %>-subtle text-<%= rc %> border border-<%= rc %>-subtle px-2 py-1 fs-6 fw-bold">
                        <%= f.ros.toFixed(2) %>
                      </span>
                      <div class="small text-muted" style="font-size:0.7rem;"><%= rl %></div>
                    </td>
                    <td class="text-end text-nowrap">
                      <a href="/faculty/<%= f.id %>" class="btn btn-sm btn-primary py-0 px-2" style="font-size:0.78rem;" title="Open Record">
                        <i class="fas fa-folder-open me-1"></i><%= isAdmin ? 'Open' : 'View' %>
                      </a>
                      <% if (isAdmin) { %>
                      <a href="/faculty/<%= f.id %>/edit" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size:0.78rem;" title="Edit Profile">
                        <i class="fas fa-edit"></i>
                      </a>
                      <form action="/faculty/<%= f.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete <%= f.name %>? This cannot be undone.');">
                        <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size:0.78rem;" title="Delete Profile"><i class="fas fa-trash"></i></button>
                      </form>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- 2. GRID CARDS VIEW -->
      <div id="facultyGridViewWrap" style="<%= viewMode === 'list' ? 'display:none;' : '' %>">
        <div class="row g-4" id="facultyGrid">
          <% faculty.forEach(f => { %>
          <%
            const rc = rosColor(f.ros);
            const rl = rosLabel(f.ros);
            const rosPercent = Math.min(Math.round(f.ros * 100), 100);
            const initials = f.name.split(' ').map(w => w[0]).join('').substring(0, 2).toUpperCase();
            const isMemberActive = (f.status || 'Active') !== 'Inactive';
            const memberType = f.member_type || 'Faculty';
            const theme = getMemberTypeTheme(memberType);
            const isPriv = (f.visibility || 'public') === 'private';
          %>
          <div class="col-12 col-md-6 col-lg-4 faculty-card-wrap"
               data-id="<%= f.id %>"
               data-ros="<%= f.ros %>"
               data-name="<%= f.name.toLowerCase() %>"
               data-code="<%= f.employee_code.toLowerCase() %>"
               data-scopus="<%= (f.scopus_id || '').toLowerCase() %>"
               data-member-type="<%= memberType %>"
               data-status="<%= isMemberActive ? 'Active' : 'Inactive' %>"
               data-visibility="<%= isPriv ? 'private' : 'public' %>">
            <div class="faculty-card position-relative role-<%= memberType.toLowerCase().replace(/\s+/g, '-') %>" style="border-top: 3px solid <%= theme.color %>;">
              <% if (isAdmin) { %>
              <div class="position-absolute" style="top: 14px; right: 14px; z-index: 5;">
                <input type="checkbox" name="faculty_ids" value="<%= f.id %>" form="bulkFacultyForm"
                       class="form-check-input faculty-select-cb shadow-sm border-secondary"
                       data-faculty-id="<%= f.id %>"
                       style="width: 20px; height: 20px; cursor: pointer;" title="Select profile for bulk actions">
              </div>
              <% } %>
              <div class="card-top-accent" style="background: <%= theme.cardAccent %>;"></div>
              <div class="faculty-card-inner">
                <div class="faculty-header">
                  <div class="faculty-photo-wrap position-relative">
                    <% if (f.photo) { %>
                      <img src="/uploads/<%= f.photo %>" alt="<%= f.name %>" class="faculty-photo" style="border-color: <%= theme.borderColor %>;">
                    <% } else { %>
                      <div class="faculty-photo-placeholder" style="background: <%= theme.avatarBg %>; border-color: <%= theme.borderColor %>;">
                        <span><%= initials %></span>
                      </div>
                    <% } %>
                    <span title="<%= isMemberActive ? 'Active Member' : 'Inactive / Left Department' %>"
                          style="position:absolute; top:-3px; left:-3px; width:14px; height:14px; border-radius:50%; border:2px solid #fff; background:<%= isMemberActive ? '#16a34a' : '#dc2626' %>; box-shadow:0 2px 5px rgba(0,0,0,0.2);"></span>
                    <div class="ros-badge ros-badge-<%= rc %>"><%= f.ros.toFixed(2) %></div>
                  </div>
                  <div class="faculty-info">
                    <h3 class="faculty-name d-flex align-items-center gap-2 flex-wrap">
                      <span><%= f.name %></span>
                      <span title="<%= isMemberActive ? 'Active' : 'Inactive / Left' %>"
                            style="width:10px; height:10px; border-radius:50%; background:<%= isMemberActive ? '#16a34a' : '#dc2626' %>; display:inline-block; flex-shrink:0;"></span>
                    </h3>
                    <div class="d-flex flex-wrap align-items-center gap-1 mb-1">
                      <span class="emp-badge"><i class="fas fa-id-card me-1"></i><%= f.employee_code %></span>
                      <span class="badge <%= theme.badgeClass %>" style="<%= theme.badgeStyle %>; font-size:0.72rem;">
                        <i class="<%= theme.icon %> me-1"></i><%= memberType %>
                      </span>
                      <% if (!isMemberActive) { %>
                        <span class="badge bg-danger-subtle text-danger border border-danger" style="font-size:0.68rem;">Left / Inactive</span>
                      <% } %>
                      <span class="badge <%= isPriv ? 'bg-warning text-dark border border-warning' : 'bg-success-subtle text-success border border-success' %>" style="font-size:0.68rem;">
                        <i class="fas fa-<%= isPriv ? 'lock' : 'globe' %> me-1"></i><%= isPriv ? 'Private' : 'Public' %>
                      </span>
                      <% if (isAdmin) { %>
                        <form action="/faculty/<%= f.id %>/visibility" method="POST" class="d-inline">
                          <input type="hidden" name="return_to" value="/portal">
                          <button type="submit" class="btn btn-xs <%= isPriv ? 'btn-outline-success' : 'btn-outline-warning text-dark' %> py-0 px-1 fw-semibold" style="font-size:0.65rem;" title="Click to make <%= isPriv ? 'Public' : 'Private' %>">
                            <i class="fas fa-<%= isPriv ? 'lock-open' : 'lock' %> me-1"></i><%= isPriv ? 'Make Public' : 'Make Private' %>
                          </button>
                        </form>
                      <% } %>
                    </div>
                    <% if (f.designation) { %><div class="faculty-desig"><%= f.designation %></div><% } %>
                    <% if (f.department) { %><div class="faculty-dept"><i class="fas fa-building me-1"></i><%= f.department %></div><% } %>
                    <% if (f.scopus_id) { %><div class="small text-muted font-monospace" style="font-size:0.72rem;"><i class="fas fa-fingerprint me-1 text-warning"></i>Scopus: <%= f.scopus_id %></div><% } %>
                  </div>
                </div>

                <!-- Star Rating & Research Docs Quick Link Row -->
                <div class="d-flex align-items-center justify-content-between px-2 py-1 rounded-2 mb-2 flex-wrap gap-1" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                  <div class="d-flex align-items-center gap-1">
                    <span class="small fw-semibold text-muted" style="font-size:0.72rem;"><i class="fas fa-star text-warning me-1"></i>Rating:</span>
                    <%- renderStarsHtml(f.ros, 'sm') %>
                  </div>
                  <a href="/faculty/<%= f.id %>#documents" class="badge <%= f.pending_doc_count > 0 ? 'bg-danger text-white' : (f.doc_count > 0 ? 'bg-info-subtle text-info border border-info' : 'bg-light text-muted border') %> text-decoration-none" style="font-size:0.68rem;" title="View & Manage Research Proof Documents">
                    <i class="fas fa-file-shield me-1"></i><%= f.doc_count %> Docs
                    <% if (f.pending_doc_count > 0) { %>(<%= f.pending_doc_count %> new)<% } %>
                  </a>
                </div>

                <!-- ROS Bar -->
                <div class="ros-section">
                  <div class="ros-label-row">
                    <span class="ros-title">Total ROS Score</span>
                    <span class="ros-value text-<%= rc %>"><%= f.ros.toFixed(2) %> <span class="ros-status"><%= rl %></span></span>
                  </div>
                  <div class="ros-bar-bg">
                    <div class="ros-bar-fill ros-fill-<%= rc %>" style="width: <%= rosPercent %>%"></div>
                  </div>
                </div>

                <!-- Badges -->
                <div class="pub-badges">
                  <% if (f.journal_count > 0) { %><span class="pub-badge bg-primary">Journals: <%= f.journal_count %></span><% } %>
                  <% if (f.conf_count > 0) { %><span class="pub-badge bg-warning text-dark">Conf: <%= f.conf_count %></span><% } %>
                  <% if (f.book_count > 0) { %><span class="pub-badge bg-success">Book: <%= f.book_count %></span><% } %>
                  <% if (f.patent_count > 0) { %><span class="pub-badge bg-danger">Patent: <%= f.patent_count %></span><% } %>
                  <% if (f.total_pubs === 0) { %><span class="pub-badge pub-none"><i class="fas fa-ban"></i> 0 Publications</span><% } %>
                </div>

                <!-- Actions -->
                <div class="card-actions">
                  <a href="/faculty/<%= f.id %>" class="btn btn-view">
                    <i class="fas fa-folder-open me-1"></i><%= isAdmin ? 'Open Record' : 'View Details' %> (<%= f.total_pubs %>)
                  </a>
                  <% if (isAdmin) { %>
                  <a href="/faculty/<%= f.id %>/edit" class="btn btn-edit-sm" title="Edit Profile"><i class="fas fa-edit"></i></a>
                  <form action="/faculty/<%= f.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete <%= f.name %>? This cannot be undone.');">
                    <button type="submit" class="btn btn-del-sm" title="Delete Profile"><i class="fas fa-trash"></i></button>
                  </form>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
          <% }) %>
        </div>
      </div>

    <% } %>

  </div>
</main>

