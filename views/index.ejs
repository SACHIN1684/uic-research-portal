<script>
document.addEventListener('DOMContentLoaded', () => {
  // ── Instant Sort (Employee Code / Name / ROS) ──────────────────────
  const sortSelect = document.getElementById('sortFacultySelect');
  const gridContainer = document.getElementById('facultyGrid');
  const tableBody = document.getElementById('facultyTableBody');
  const gridViewLink = document.getElementById('gridViewLink');
  const listViewLink = document.getElementById('listViewLink');

  function sortFacultyItems(mode) {
    const container = gridContainer || tableBody;
    if (!container) return;
    const items = Array.from(container.querySelectorAll('.faculty-card-wrap'));

    items.sort((a, b) => {
      const codeA = a.dataset.code || '';
      const codeB = b.dataset.code || '';
      const nameA = a.dataset.name || '';
      const nameB = b.dataset.name || '';
      const rosA = parseFloat(a.dataset.ros) || 0;
      const rosB = parseFloat(b.dataset.ros) || 0;

      if (mode === 'emp_asc') {
        return codeA.localeCompare(codeB, undefined, { numeric: true, sensitivity: 'base' });
      }
      if (mode === 'emp_desc') {
        return codeB.localeCompare(codeA, undefined, { numeric: true, sensitivity: 'base' });
      }
      if (mode === 'ros_desc') {
        return (rosB - rosA) || nameA.localeCompare(nameB);
      }
      if (mode === 'ros_asc') {
        return (rosA - rosB) || nameA.localeCompare(nameB);
      }
      return nameA.localeCompare(nameB);
    });

    items.forEach((el, idx) => {
      container.appendChild(el);
      const snoCell = el.querySelector('.serial-col');
      if (snoCell) snoCell.textContent = idx + 1;
    });

    if (gridViewLink) gridViewLink.href = `/portal?view=grid&sort=${encodeURIComponent(mode)}`;
    if (listViewLink) listViewLink.href = `/portal?view=list&sort=${encodeURIComponent(mode)}`;
    if (window.history && window.history.replaceState) {
      const url = new URL(window.location);
      url.searchParams.set('sort', mode);
      window.history.replaceState({}, '', url);
    }
  }

  if (sortSelect) {
    sortSelect.addEventListener('change', function() {
      sortFacultyItems(this.value);
    });
  }

  // ── Saturday Roster Off Eligibility Logic ──────────────────────────
  const allFacultyList = JSON.parse(document.getElementById('portalFacultyDataJson').textContent || '[]');
  const quickInput = document.getElementById('quickRosterThreshold');
  const modalInput = document.getElementById('modalRosterThreshold');
  const quickCountEl = document.getElementById('quickEligibleCount');
  const quickDlBtn = document.getElementById('quickRosterDownloadBtn');
  const modalEligibleCountEl = document.getElementById('modalEligibleCount');
  const modalNotEligibleCountEl = document.getElementById('modalNotEligibleCount');
  const modalThresholdLabelEl = document.getElementById('modalThresholdLabel');
  const modalDlBtn = document.getElementById('modalRosterDownloadBtn');
  const rosterBodyEl = document.getElementById('rosterPreviewBody');

  function escapeHtml(str) {
    return String(str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function updateRosterPreview(rawVal, sourceEl) {
    const parsed = parseFloat(rawVal);
    const threshold = isNaN(parsed) || parsed < 0 ? 0 : parsed;
    const thresholdFixed = threshold.toFixed(2);
    const thresholdScaled = Math.round(threshold * 10000);

    if (quickInput && sourceEl !== quickInput) quickInput.value = threshold;
    if (modalInput && sourceEl !== modalInput) modalInput.value = threshold;

    const eligible = allFacultyList
      .filter(f => Math.round((parseFloat(f.ros) || 0) * 10000) >= thresholdScaled)
      .sort((a, b) => (b.ros - a.ros) || a.name.localeCompare(b.name));
    const notEligibleCount = allFacultyList.length - eligible.length;

    if (quickCountEl) quickCountEl.textContent = eligible.length;
    if (modalEligibleCountEl) modalEligibleCountEl.textContent = eligible.length;
    if (modalNotEligibleCountEl) modalNotEligibleCountEl.textContent = notEligibleCount;
    if (modalThresholdLabelEl) modalThresholdLabelEl.textContent = thresholdFixed;

    const dlUrl = `/export/saturday-roster?threshold=${encodeURIComponent(threshold)}`;
    if (quickDlBtn) quickDlBtn.href = dlUrl;
    if (modalDlBtn) modalDlBtn.href = dlUrl;

    if (rosterBodyEl) {
      if (eligible.length === 0) {
        rosterBodyEl.innerHTML = `
          <tr>
            <td colspan="7" class="text-center py-4 text-muted">
              <i class="fas fa-info-circle me-1"></i>No faculty members meet the threshold of <strong>ROS &ge; ${thresholdFixed}</strong>.
            </td>
          </tr>`;
      } else {
        rosterBodyEl.innerHTML = eligible.map((f, idx) => `
          <tr>
            <td class="ps-3 fw-bold text-muted">${idx + 1}</td>
            <td><span class="badge bg-light text-primary border font-monospace">${escapeHtml(f.employee_code)}</span></td>
            <td><a href="/faculty/${f.id}" class="fw-bold text-dark text-decoration-none">${escapeHtml(f.name)}</a></td>
            <td class="small text-muted">${escapeHtml(f.designation) || '—'}</td>
            <td class="small">${escapeHtml(f.department) || '—'}</td>
            <td class="text-center fw-semibold">${f.total_pubs}</td>
            <td class="text-center">
              <span class="badge bg-success px-2 py-1 fs-6">${parseFloat(f.ros).toFixed(2)}</span>
            </td>
          </tr>`).join('');
      }
    }
  }

  window.setRosterThreshold = function(val) {
    updateRosterPreview(val, null);
  };

  window.openRosterModal = function() {
    updateRosterPreview(quickInput ? quickInput.value : 0.5, null);
    const modal = new bootstrap.Modal(document.getElementById('saturdayRosterModal'));
    modal.show();
  };

  if (quickInput) {
    quickInput.addEventListener('input', function() {
      updateRosterPreview(this.value, quickInput);
    });
  }
  if (modalInput) {
    modalInput.addEventListener('input', function() {
      updateRosterPreview(this.value, modalInput);
    });
  }
  // Initialize with default 0.50
  updateRosterPreview(0.50, null);

  // ── Bulk Selection & Delete Logic ──────────────────────────────────
  const selectAllTop = document.getElementById('selectAllFaculty');
  const selectAllTable = document.getElementById('tableSelectAll');
  const deleteSelectedBtn = document.getElementById('deleteSelectedFacultyBtn');
  const selectedCountSpan = document.getElementById('selectedFacultyCount');
  const deleteBtnCountSpan = document.getElementById('deleteBtnCount');

  function getCheckboxes() {
    return Array.from(document.querySelectorAll('.faculty-select-cb'));
  }

  function getVisibleCheckboxes() {
    return getCheckboxes().filter(cb => {
      const wrap = cb.closest('.faculty-card-wrap');
      return !wrap || wrap.style.display !== 'none';
    });
  }

  function updateFacultySelectionUI() {
    const allChecked = getCheckboxes().filter(cb => cb.checked);
    const count = allChecked.length;

    if (selectedCountSpan) selectedCountSpan.textContent = count;
    if (deleteBtnCountSpan) deleteBtnCountSpan.textContent = count;
    if (deleteSelectedBtn) deleteSelectedBtn.disabled = count === 0;

    const visibleCbs = getVisibleCheckboxes();
    const allVisibleChecked = visibleCbs.length > 0 && visibleCbs.every(cb => cb.checked);
    if (selectAllTop) selectAllTop.checked = allVisibleChecked;
    if (selectAllTable) selectAllTable.checked = allVisibleChecked;
  }
  window.updateFacultySelectionUI = updateFacultySelectionUI;

  function toggleAllVisible(checked) {
    const visibleCbs = getVisibleCheckboxes();
    visibleCbs.forEach(cb => cb.checked = checked);
    updateFacultySelectionUI();
  }

  if (selectAllTop) {
    selectAllTop.addEventListener('change', function() {
      toggleAllVisible(this.checked);
    });
  }

  if (selectAllTable) {
    selectAllTable.addEventListener('change', function() {
      toggleAllVisible(this.checked);
    });
  }

  getCheckboxes().forEach(cb => {
    cb.addEventListener('change', updateFacultySelectionUI);
  });
});
</script>
</body>
</html>
