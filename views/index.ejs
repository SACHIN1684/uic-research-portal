<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — UIC Research Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark portal-nav">
  <div class="container-fluid px-4">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/portal">
      <div class="brand-icon"><i class="fas fa-flask"></i></div>
      <div>
        <div class="brand-title">UIC Research Portal</div>
        <div class="brand-sub">University Institute of Computing, Chandigarh University</div>
      </div>
    </a>
    <div class="ms-auto d-flex align-items-center gap-2 flex-wrap">
      <a href="/" class="btn btn-outline-light btn-sm fw-semibold">
        <i class="fas fa-home me-1"></i>Home & About
      </a>
      <a href="/#monthly-ros" class="btn btn-info btn-sm fw-bold text-dark shadow-sm">
        <i class="fas fa-table me-1"></i>ROS Table (Home)
      </a>
      <a href="/#top-performers" class="btn btn-outline-warning btn-sm fw-semibold">
        <i class="fas fa-trophy me-1"></i>Top Performers & Growth
      </a>
      <% if (isAdmin) { %>
        <!-- Saturday Roster Off Eligibility Modal Trigger -->
        <button class="btn btn-info btn-sm fw-bold text-dark shadow-sm" data-bs-toggle="modal" data-bs-target="#saturdayRosterModal">
          <i class="fas fa-calendar-check me-1"></i>Saturday Roster Off
        </button>

        <!-- 1. Master Excel Upload (Directly adds papers by Author Name Column D) -->
        <button class="btn btn-warning btn-sm fw-bold text-dark shadow-sm" data-bs-toggle="modal" data-bs-target="#masterUploadModal">
          <i class="fas fa-file-import me-1"></i>Upload Master Publications Excel
        </button>

        <!-- 2. Excel Export Button -->
        <a href="/export/excel" class="btn btn-success btn-sm fw-semibold shadow-sm">
          <i class="fas fa-file-excel me-1"></i>Export Tracking Excel
        </a>

        <!-- 3. Bulk Faculty List Upload -->
        <button class="btn btn-light btn-sm fw-semibold text-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#bulkUploadModal">
          <i class="fas fa-users me-1"></i>Upload Faculty List
        </button>

        <!-- 4. Add Single Faculty -->
        <a href="/faculty/add" class="btn btn-add btn-sm">
          <i class="fas fa-user-plus me-1"></i>Add Faculty
        </a>

        <!-- Admin Badge & Logout -->
        <button type="button" class="btn btn-outline-warning btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#portalAdminSettingsModal" title="Admin Credentials">
          <i class="fas fa-user-shield me-1"></i><%= adminUsername %>
        </button>
        <form action="/admin/logout" method="POST" class="d-inline">
          <input type="hidden" name="return_to" value="/portal">
          <button type="submit" class="btn btn-outline-danger btn-sm fw-semibold" title="Logout Admin">
            <i class="fas fa-sign-out-alt me-1"></i>Logout
          </button>
        </form>
      <% } else { %>
        <span class="badge bg-light text-dark py-2 px-3">
          <i class="fas fa-eye text-primary me-1"></i>Visitor View (Read-Only)
        </span>
        <button type="button" class="btn btn-warning btn-sm fw-bold text-dark shadow-sm" data-bs-toggle="modal" data-bs-target="#portalAdminLoginModal">
          <i class="fas fa-user-shield me-1"></i>Admin Login
        </button>
      <% } %>
    </div>
  </div>
</nav>

<main class="main-content">
  <div class="container-fluid px-4">

    <!-- Page Header & View Toggle -->
    <div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
      <div>
        <h1 class="page-title"><i class="fas fa-users me-2"></i>Faculty Research Directory</h1>
        <p class="page-sub">
          <% if (isAdmin) { %>
            Admin Mode &mdash; Upload papers, edit faculty profiles, manage publications, and track ROS scores.
          <% } else { %>
            University Institute of Computing, Chandigarh University &mdash; Browse faculty profiles, search by name or employee code, and view publications.
          <% } %>
        </p>
      </div>
      <div class="btn-group shadow-sm" role="group">
        <a href="/portal?view=grid&sort=<%= sortMode %>" id="gridViewLink" class="btn btn-sm <%= viewMode !== 'list' ? 'btn-primary' : 'btn-outline-primary' %>">
          <i class="fas fa-th-large me-1"></i>Grid View
        </a>
        <a href="/portal?view=list&sort=<%= sortMode %>" id="listViewLink" class="btn btn-sm <%= viewMode === 'list' ? 'btn-primary' : 'btn-outline-primary' %>">
          <i class="fas fa-list me-1"></i>List View
        </a>
      </div>
    </div>

    <!-- Alert notifications -->
    <% if (query.admin_logged_in) { %>
      <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-user-shield me-2 fs-5 align-middle"></i>
        <strong>Admin Mode Active (<%= adminUsername %>)!</strong> You now have full rights to add, edit, upload, and delete records.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (query.login_err) { %>
      <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle me-2 fs-5 align-middle"></i>
        <strong>Admin Login Failed:</strong> <%= query.login_err %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (query.cred_updated) { %>
      <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-key me-2 fs-5 align-middle"></i>
        <strong>Admin Credentials Updated!</strong> Username and password have been saved.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (query.cred_err) { %>
      <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle me-2 fs-5 align-middle"></i>
        <strong>Credential Update Failed:</strong> <%= query.cred_err %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (query.master_success) { %>
      <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2 fs-5 align-middle"></i>
        <strong>Master Publication Excel Processed!</strong> Added <strong><%= query.matched %></strong> new<% if (query.replaced > 0) { %>, replaced <strong><%= query.replaced %></strong> existing<% } %><% if (query.skipped > 0) { %>, skipped <strong><%= query.skipped %></strong> duplicate(s)<% } %>.
        <% if (query.unmatched > 0) { %>
          <div class="mt-1 small text-dark">
            <i class="fas fa-info-circle text-warning me-1"></i> <strong><%= query.unmatched %></strong> rows could not be mapped to any registered faculty name (e.g. <%= query.unmatched_names %>). Please make sure the faculty members exist.
          </div>
        <% } %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
    <% if (query.master_err) { %>
      <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle me-2 fs-5 align-middle"></i>
        <strong>Master Upload Error:</strong> <%= query.master_err %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
    <% if (query.upload_success) { %>
      <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2 fs-5 align-middle"></i>
        <strong>Faculty List Processed!</strong> Added <strong><%= query.added %></strong> new<% if (query.replaced > 0) { %>, replaced/updated <strong><%= query.replaced %></strong> existing<% } %><% if (query.skipped > 0) { %>, skipped <strong><%= query.skipped %></strong><% } %>.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
    <% if (query.upload_err) { %>
      <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle me-2 fs-5 align-middle"></i>
        <strong>Faculty Upload Error:</strong> <%= query.upload_err %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
    <% if (query.bulk_deleted) { %>
      <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-trash-alt me-2 fs-5 align-middle"></i>
        Successfully deleted <strong><%= query.bulk_deleted %></strong> selected faculty profile(s) and their associated records.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
    <% if (query.all_deleted) { %>
      <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-trash-alt me-2 fs-5 align-middle"></i>
        All <strong><%= query.all_deleted %></strong> faculty profiles and records have been deleted.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
    <% if (query.deleted) { %>
      <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-info-circle me-2 fs-5 align-middle"></i>
        Faculty member profile successfully removed.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <% if (query.counting_updated) { %>
      <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2 fs-5 align-middle"></i>
        <strong>Home ROS Table Counting Mode Updated:</strong>
        <%= pubCountingMode === 'separate' ? 'Each author row is now counted separately in the Department ROS table.' : 'Shared papers across multiple CU faculty are now counted as 1 unique publication in the Department ROS table.' %>
        <a href="/#monthly-ros" class="btn btn-sm btn-primary ms-2 fw-bold">
          <i class="fas fa-table me-1"></i>View Live ROS Table on Home Page &rarr;
        </a>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <% if (isAdmin) { %>
    <!-- Home Page ROS Table Paper Counting Setting & Direct Link (Admin Control) -->
    <div class="card border-0 shadow-sm rounded-3 mb-4" style="background: linear-gradient(90deg, #fffbeb 0%, #fef2f2 100%); border-left: 4px solid #c8102e !important;">
      <div class="card-body p-3 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
          <div class="p-2 rounded bg-danger text-white"><i class="fas fa-sliders-h fs-4"></i></div>
          <div>
            <div class="fw-bold text-dark">
              Home ROS Table: Multi-Author Publication Counting Setting
              <span class="badge <%= pubCountingMode === 'separate' ? 'bg-warning text-dark' : 'bg-success' %> ms-2">
                Active: <%= pubCountingMode === 'separate' ? 'Separate per Author' : '1 Paper (Unique Publication)' %>
              </span>
            </div>
            <div class="text-muted small">
              Choose whether a paper co-authored by multiple CU faculty counts as <strong>1 publication</strong> or <strong>separate entries</strong> in the Home Page ROS table &amp; growth chart.
            </div>
          </div>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <form action="/admin/settings/counting-mode" method="POST" class="d-inline">
            <input type="hidden" name="return_to" value="/portal">
            <input type="hidden" name="mode" value="unique">
            <button type="submit" class="btn btn-sm fw-bold <%= pubCountingMode !== 'separate' ? 'btn-success shadow-sm' : 'btn-outline-success' %>">
              <i class="fas fa-check-double me-1"></i>Count as 1 Paper (Unique)
            </button>
          </form>
          <form action="/admin/settings/counting-mode" method="POST" class="d-inline">
            <input type="hidden" name="return_to" value="/portal">
            <input type="hidden" name="mode" value="separate">
            <button type="submit" class="btn btn-sm fw-bold <%= pubCountingMode === 'separate' ? 'btn-warning text-dark shadow-sm' : 'btn-outline-secondary' %>">
              <i class="fas fa-users me-1"></i>Count Separately
            </button>
          </form>
          <a href="/#monthly-ros" class="btn btn-primary btn-sm fw-bold shadow-sm">
            <i class="fas fa-table me-1"></i>Direct Link: Home ROS Table
          </a>
        </div>
      </div>
    </div>

    <!-- Master Upload Banner -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-light">
      <div class="card-body p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
          <div class="p-2 rounded bg-warning text-dark"><i class="fas fa-bolt fs-4"></i></div>
          <div>
            <div class="fw-bold text-dark">Direct Excel Publication Import</div>
            <div class="text-muted small">Upload your spreadsheet with <strong>Author names (CU)</strong> (Col D) and <strong>Document Type</strong> (Col H). The system matches the faculty name and auto-sorts each entry into <strong>Journal</strong> (Article/Review), <strong>Conference</strong>, <strong>Book Chapter</strong>, or <strong>Patent</strong>.</div>
          </div>
        </div>
        <div class="d-flex gap-2">
          <a href="/download-master-publications-template" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-download me-1"></i>Download Template
          </a>
          <button class="btn btn-warning btn-sm fw-bold text-dark" data-bs-toggle="modal" data-bs-target="#masterUploadModal">
            <i class="fas fa-upload me-1"></i>Upload Master Excel
          </button>
        </div>
      </div>
    </div>

    <!-- Saturday Roster Off Eligibility Quick Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4" style="background: linear-gradient(90deg, #eff6ff 0%, #f0fdf4 100%); border-left: 4px solid #0d6efd !important;">
      <div class="card-body p-3 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
          <div class="p-2 rounded bg-primary text-white"><i class="fas fa-calendar-check fs-4"></i></div>
          <div>
            <div class="fw-bold text-dark">Saturday Roster Off Eligibility (Variable ROS Threshold)</div>
            <div class="text-muted small">
              Set a threshold ROS score (e.g., <strong>0.50</strong>). Faculty with <strong>ROS &ge; Threshold</strong> qualify for Saturday roster off.
            </div>
          </div>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <div class="input-group input-group-sm shadow-sm" style="width: 175px;">
            <span class="input-group-text fw-bold bg-white text-primary">ROS &ge;</span>
            <input type="number" id="quickRosterThreshold" class="form-control fw-bold" step="0.01" min="0" value="0.50">
          </div>
          <button type="button" class="btn btn-primary btn-sm fw-semibold shadow-sm" onclick="openRosterModal()">
            <i class="fas fa-list-check me-1"></i>View Eligible (<span id="quickEligibleCount">0</span>)
          </button>
          <a href="/export/saturday-roster?threshold=0.50" id="quickRosterDownloadBtn" class="btn btn-success btn-sm fw-semibold shadow-sm">
            <i class="fas fa-file-excel me-1"></i>Download Eligible Excel
          </a>
        </div>
      </div>
    </div>
    <% } %>

    <!-- Stats Bar -->
    <div class="stats-row row g-3 mb-4">
      <div class="col-6 col-md-3">
        <div class="stat-card stat-total">
          <div class="stat-icon"><i class="fas fa-users"></i></div>
          <div class="stat-num"><%= totalFaculty %></div>
          <div class="stat-label">Total Faculty Registered</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-card stat-avg">
          <div class="stat-icon"><i class="fas fa-chart-line"></i></div>
          <div class="stat-num"><%= avgROS %></div>
          <div class="stat-label">Average Department ROS</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-card stat-zero">
          <div class="stat-icon"><i class="fas fa-exclamation-circle"></i></div>
          <div class="stat-num"><%= zeroCount %></div>
          <div class="stat-label">Zero Publications / ROS</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-card stat-active">
          <div class="stat-icon"><i class="fas fa-award"></i></div>
          <div class="stat-num"><%= activeCount %></div>
          <div class="stat-label">Active Research Contributors</div>
        </div>
      </div>
    </div>

    <!-- Filter, Sort & Search Bar -->
    <div class="filter-bar mb-4">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex flex-wrap align-items-center gap-2">
          <span class="filter-label"><i class="fas fa-filter me-1"></i>Filter by ROS:</span>
          <button class="filter-btn active" data-filter="all">
            <i class="fas fa-th me-1"></i>All Faculty (<%= totalFaculty %>)
          </button>
          <button class="filter-btn filter-zero" data-filter="zero">
            <i class="fas fa-times-circle me-1"></i>Zero ROS (<%= zeroCount %>)
          </button>
          <button class="filter-btn filter-low" data-filter="low">
            <i class="fas fa-arrow-down me-1"></i>Low ROS &lt; 0.3
          </button>
          <button class="filter-btn filter-moderate" data-filter="moderate">
            <i class="fas fa-minus me-1"></i>Moderate 0.3–0.6
          </button>
          <button class="filter-btn filter-good" data-filter="good">
            <i class="fas fa-arrow-up me-1"></i>Good &gt; 0.6
          </button>
        </div>

        <div class="d-flex align-items-center gap-3 flex-wrap">
          <div class="d-flex align-items-center gap-2">
            <label for="sortFacultySelect" class="small fw-bold text-muted text-nowrap mb-0">
              <i class="fas fa-sort-alpha-down me-1 text-primary"></i>Sort by:
            </label>
            <select id="sortFacultySelect" class="form-select form-select-sm fw-semibold border-primary shadow-sm" style="width: auto; min-width: 215px;">
              <option value="name_asc" <%= sortMode === 'name_asc' ? 'selected' : '' %>>Name (A &rarr; Z)</option>
              <option value="emp_asc" <%= sortMode === 'emp_asc' ? 'selected' : '' %>>Employee Code (Low &rarr; High)</option>
              <option value="emp_desc" <%= sortMode === 'emp_desc' ? 'selected' : '' %>>Employee Code (High &rarr; Low)</option>
              <option value="ros_desc" <%= sortMode === 'ros_desc' ? 'selected' : '' %>>ROS Score (High &rarr; Low)</option>
              <option value="ros_asc" <%= sortMode === 'ros_asc' ? 'selected' : '' %>>ROS Score (Low &rarr; High)</option>
            </select>
          </div>

          <% if (isAdmin) { %>
          <a href="/export/excel" class="text-success small fw-bold text-decoration-none d-flex align-items-center gap-1">
            <i class="fas fa-file-excel fs-6"></i> Download Excel (.xlsx)
          </a>
          <% } %>
        </div>
      </div>

      <div class="mt-3">
        <div class="search-wrap">
          <i class="fas fa-search search-icon"></i>
          <input type="text" id="searchInput" class="search-input" placeholder="Search by faculty name or employee code...">
          <button class="search-clear" id="clearSearch" title="Clear"><i class="fas fa-times"></i></button>
        </div>
      </div>
    </div>

    <!-- No results state -->
    <div id="noResults" class="text-center py-5" style="display:none;">
      <i class="fas fa-search fa-3x text-muted mb-3"></i>
      <h5 class="text-muted">No faculty found</h5>
      <p class="text-muted">Try a different search or filter option.</p>
    </div>

    <!-- Faculty List / Grid Views -->
    <% if (faculty.length === 0) { %>
      <div class="text-center py-5 bg-white rounded-3 shadow-sm p-4">
        <i class="fas fa-users-slash fa-4x text-muted mb-3 opacity-25"></i>
        <h4 class="text-dark">No faculty records found</h4>
        <% if (isAdmin) { %>
        <p class="text-muted mb-3">Upload your faculty list Excel sheet or add single records manually.</p>
        <div class="d-flex justify-content-center gap-2">
          <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#bulkUploadModal">
            <i class="fas fa-file-upload me-1"></i>Upload Faculty Excel
          </button>
          <a href="/faculty/add" class="btn btn-primary">
            <i class="fas fa-user-plus me-1"></i>Add Individual Faculty
          </a>
        </div>
        <% } else { %>
        <p class="text-muted mb-0">No faculty profiles have been published yet.</p>
        <% } %>
      </div>
    <% } else { %>

      <% if (isAdmin) { %>
      <!-- Bulk Selection & Delete Action Bar -->
      <form id="bulkDeleteForm" action="/faculty/delete-multiple" method="POST"></form>
      <div class="card border-0 shadow-sm rounded-3 mb-3 bg-white">
        <div class="card-body py-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
          <div class="d-flex align-items-center gap-3">
            <div class="form-check mb-0">
              <input type="checkbox" class="form-check-input" id="selectAllFaculty" style="cursor:pointer; transform: scale(1.15);">
              <label class="form-check-label fw-bold text-dark ms-1" for="selectAllFaculty" style="cursor:pointer;">
                Select All Visible Faculty
              </label>
            </div>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
              <span id="selectedFacultyCount">0</span> Selected
            </span>
          </div>
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <button type="submit" form="bulkDeleteForm" id="deleteSelectedFacultyBtn" class="btn btn-outline-danger btn-sm fw-semibold" disabled
                    onclick="return confirm('Are you sure you want to delete all selected faculty profiles and their publications? This cannot be undone.');">
              <i class="fas fa-trash-alt me-1"></i>Delete Selected (<span id="deleteBtnCount">0</span>)
            </button>
            <form action="/faculty/delete-all" method="POST" class="d-inline"
                  onsubmit="return confirm('WARNING: This will permanently delete ALL <%= faculty.length %> faculty members and ALL their publication records! Are you absolutely sure?');">
              <button type="submit" class="btn btn-danger btn-sm fw-semibold shadow-sm">
                <i class="fas fa-exclamation-triangle me-1"></i>Delete All (<%= faculty.length %>)
              </button>
            </form>
          </div>
        </div>
      </div>
      <% } %>

      <!-- 1. TABLE / LIST VIEW -->
      <% if (viewMode === 'list') { %>
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-4">
          <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-primary"><i class="fas fa-table me-2"></i>Faculty Records (List View)</h5>
            <span class="badge bg-light text-dark border"><%= faculty.length %> Entries</span>
          </div>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="facultyTable">
              <thead class="table-light">
                <tr>
                  <% if (isAdmin) { %>
                  <th style="width: 3%;" class="text-center">
                    <input type="checkbox" id="tableSelectAll" class="form-check-input" title="Select All">
                  </th>
                  <% } %>
                  <th style="width: 4%;">S.No</th>
                  <th style="width: 24%;">Faculty Name & Details</th>
                  <th style="width: 13%;">Employee Code</th>
                  <th style="width: 12%;">Department</th>
                  <th style="width: 18%;" class="text-center">Publications Breakdown</th>
                  <th style="width: 12%;" class="text-center">Total ROS</th>
                  <th style="width: 14%;" class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody id="facultyTableBody">
                <% faculty.forEach((f, idx) => { %>
                  <%
                    const rc = rosColor(f.ros);
                    const rl = rosLabel(f.ros);
                    const initials = f.name.split(' ').map(w => w[0]).join('').substring(0, 2).toUpperCase();
                  %>
                  <tr class="faculty-card-wrap"
                      data-ros="<%= f.ros %>"
                      data-name="<%= f.name.toLowerCase() %>"
                      data-code="<%= f.employee_code.toLowerCase() %>">
                    <% if (isAdmin) { %>
                    <td class="text-center">
                      <input type="checkbox" name="faculty_ids" value="<%= f.id %>" form="bulkDeleteForm" class="form-check-input faculty-select-cb" style="cursor:pointer;">
                    </td>
                    <% } %>
                    <td class="text-muted fw-bold serial-col"><%= idx + 1 %></td>
                    <td>
                      <div class="d-flex align-items-center gap-2">
                        <% if (f.photo) { %>
                          <img src="/uploads/<%= f.photo %>" class="rounded-circle border" style="width: 40px; height: 40px; object-fit: cover;">
                        <% } else { %>
                          <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; font-size: 0.85rem;">
                            <%= initials %>
                          </div>
                        <% } %>
                        <div>
                          <div class="fw-bold text-dark"><%= f.name %></div>
                          <div class="text-muted small"><%= f.designation || 'Faculty' %></div>
                        </div>
                      </div>
                    </td>
                    <td>
                      <span class="badge bg-light text-primary border font-monospace px-2 py-1 fs-6">
                        <%= f.employee_code %>
                      </span>
                    </td>
                    <td><%= f.department || '—' %></td>
                    <td class="text-center">
                      <% if (f.total_pubs === 0) { %>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Zero Publications</span>
                      <% } else { %>
                        <div class="d-flex justify-content-center flex-wrap gap-1">
                          <span class="badge bg-primary">Journals: <%= f.journal_count %></span>
                          <% if (f.conf_count > 0) { %><span class="badge bg-warning text-dark">Conf: <%= f.conf_count %></span><% } %>
                          <% if (f.book_count > 0) { %><span class="badge bg-success">Book: <%= f.book_count %></span><% } %>
                          <% if (f.patent_count > 0) { %><span class="badge bg-danger">Patent: <%= f.patent_count %></span><% } %>
                        </div>
                        <small class="text-muted">(<%= f.total_pubs %> Total)</small>
                      <% } %>
                    </td>
                    <td class="text-center">
                      <span class="badge bg-<%= rc %>-subtle text-<%= rc %> border border-<%= rc %>-subtle px-2 py-1 fs-6 fw-bold">
                        <%= f.ros.toFixed(2) %>
                      </span>
                      <div class="small text-muted"><%= rl %></div>
                    </td>
                    <td class="text-end">
                      <a href="/faculty/<%= f.id %>" class="btn btn-sm btn-primary">
                        <i class="fas fa-folder-open me-1"></i><%= isAdmin ? 'Open' : 'View Details' %>
                      </a>
                      <% if (isAdmin) { %>
                      <a href="/faculty/<%= f.id %>/edit" class="btn btn-sm btn-outline-secondary" title="Edit">
                        <i class="fas fa-edit"></i>
                      </a>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

      <!-- 2. GRID CARDS VIEW -->
      <% } else { %>
        <div class="row g-4" id="facultyGrid">
          <% faculty.forEach(f => { %>
          <%
            const rc = rosColor(f.ros);
            const rl = rosLabel(f.ros);
            const rosPercent = Math.min(Math.round(f.ros * 100), 100);
            const initials = f.name.split(' ').map(w => w[0]).join('').substring(0, 2).toUpperCase();
          %>
          <div class="col-12 col-md-6 col-lg-4 faculty-card-wrap"
               data-ros="<%= f.ros %>"
               data-name="<%= f.name.toLowerCase() %>"
               data-code="<%= f.employee_code.toLowerCase() %>">
            <div class="faculty-card position-relative">
              <% if (isAdmin) { %>
              <div class="position-absolute" style="top: 14px; right: 14px; z-index: 5;">
                <input type="checkbox" name="faculty_ids" value="<%= f.id %>" form="bulkDeleteForm"
                       class="form-check-input faculty-select-cb shadow-sm border-secondary"
                       style="width: 20px; height: 20px; cursor: pointer;" title="Select for bulk delete">
              </div>
              <% } %>
              <div class="card-top-accent"></div>
              <div class="faculty-card-inner">
                <div class="faculty-header">
                  <div class="faculty-photo-wrap">
                    <% if (f.photo) { %>
                      <img src="/uploads/<%= f.photo %>" alt="<%= f.name %>" class="faculty-photo">
                    <% } else { %>
                      <div class="faculty-photo-placeholder">
                        <span><%= initials %></span>
                      </div>
                    <% } %>
                    <div class="ros-badge ros-badge-<%= rc %>"><%= f.ros.toFixed(2) %></div>
                  </div>
                  <div class="faculty-info">
                    <h3 class="faculty-name"><%= f.name %></h3>
                    <span class="emp-badge"><i class="fas fa-id-card me-1"></i><%= f.employee_code %></span>
                    <% if (f.designation) { %><div class="faculty-desig"><%= f.designation %></div><% } %>
                    <% if (f.department) { %><div class="faculty-dept"><i class="fas fa-building me-1"></i><%= f.department %></div><% } %>
                  </div>
                </div>

                <!-- ROS Bar -->
                <div class="ros-section">
                  <div class="ros-label-row">
                    <span class="ros-title">Total ROS Score</span>
                    <span class="ros-value text-<%= rc %>"><%= f.ros.toFixed(2) %> <span class="ros-status"><%= rl %></span></span>
                  </div>
                  <div class="ros-bar-bg">
                    <div class="ros-bar-fill ros-fill-<%= rc %>" style="width: <%= rosPercent %>%"></div>
                  </div>
                </div>

                <!-- Badges -->
                <div class="pub-badges">
                  <% if (f.journal_count > 0) { %><span class="pub-badge bg-primary">Journals: <%= f.journal_count %></span><% } %>
                  <% if (f.conf_count > 0) { %><span class="pub-badge bg-warning text-dark">Conf: <%= f.conf_count %></span><% } %>
                  <% if (f.book_count > 0) { %><span class="pub-badge bg-success">Book: <%= f.book_count %></span><% } %>
                  <% if (f.patent_count > 0) { %><span class="pub-badge bg-danger">Patent: <%= f.patent_count %></span><% } %>
                  <% if (f.total_pubs === 0) { %><span class="pub-badge pub-none"><i class="fas fa-ban"></i> 0 Publications</span><% } %>
                </div>

                <!-- Actions -->
                <div class="card-actions">
                  <a href="/faculty/<%= f.id %>" class="btn btn-view">
                    <i class="fas fa-folder-open me-1"></i><%= isAdmin ? 'Open Record' : 'View Details' %> (<%= f.total_pubs %>)
                  </a>
                  <% if (isAdmin) { %>
                  <a href="/faculty/<%= f.id %>/edit" class="btn btn-edit-sm" title="Edit Profile"><i class="fas fa-edit"></i></a>
                  <form action="/faculty/<%= f.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete <%= f.name %>? This cannot be undone.');">
                    <button type="submit" class="btn btn-del-sm" title="Delete Profile"><i class="fas fa-trash"></i></button>
                  </form>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
          <% }) %>
        </div>
      <% } %>

    <% } %>

  </div>
</main>

