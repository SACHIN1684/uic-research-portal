  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/app.js"></script>
<script id="portalFacultyDataJson" type="application/json">
  <%- JSON.stringify(faculty.map(f => ({
    id: f.id,
    name: f.name,
    employee_code: f.employee_code,
    designation: f.designation || '',
    department: f.department || '',
    total_pubs: f.total_pubs || 0,
    ros: f.ros || 0
  }))) %>
</script>
<script>
document.addEventListener('DOMContentLoaded', () => {
  // ── Instant Sort (Employee Code / Name / ROS) ──────────────────────
  const sortSelect = document.getElementById('sortFacultySelect');
  const gridContainer = document.getElementById('facultyGrid');
  const tableBody = document.getElementById('facultyTableBody');
  const gridViewLink = document.getElementById('gridViewLink');
  const listViewLink = document.getElementById('listViewLink');

  function sortFacultyItems(mode) {
    const container = gridContainer || tableBody;
    if (!container) return;
    const items = Array.from(container.querySelectorAll('.faculty-card-wrap'));

    items.sort((a, b) => {
      const codeA = a.dataset.code || '';
      const codeB = b.dataset.code || '';
      const nameA = a.dataset.name || '';
      const nameB = b.dataset.name || '';
      const rosA = parseFloat(a.dataset.ros) || 0;
      const rosB = parseFloat(b.dataset.ros) || 0;

      if (mode === 'emp_asc') {
        return codeA.localeCompare(codeB, undefined, { numeric: true, sensitivity: 'base' });
      }
      if (mode === 'emp_desc') {
        return codeB.localeCompare(codeA, undefined, { numeric: true, sensitivity: 'base' });
      }
      if (mode === 'ros_desc') {
        return (rosB - rosA) || nameA.localeCompare(nameB);
      }
      if (mode === 'ros_asc') {
        return (rosA - rosB) || nameA.localeCompare(nameB);
      }
      return nameA.localeCompare(nameB);
    });

    items.forEach((el, idx) => {
      container.appendChild(el);
      const snoCell = el.querySelector('.serial-col');
      if (snoCell) snoCell.textContent = idx + 1;
    });

    if (gridViewLink) gridViewLink.href = `/portal?view=grid&sort=${encodeURIComponent(mode)}`;
    if (listViewLink) listViewLink.href = `/portal?view=list&sort=${encodeURIComponent(mode)}`;
    if (window.history && window.history.replaceState) {
      const url = new URL(window.location);
      url.searchParams.set('sort', mode);
      window.history.replaceState({}, '', url);
    }
  }

  if (sortSelect) {
    sortSelect.addEventListener('change', function() {
      sortFacultyItems(this.value);
    });
  }

  // ── Saturday Roster Off Eligibility Logic ──────────────────────────
  const allFacultyList = JSON.parse(document.getElementById('portalFacultyDataJson').textContent || '[]');
  const quickInput = document.getElementById('quickRosterThreshold');
  const modalInput = document.getElementById('modalRosterThreshold');
  const quickCountEl = document.getElementById('quickEligibleCount');
  const quickDlBtn = document.getElementById('quickRosterDownloadBtn');
  const modalEligibleCountEl = document.getElementById('modalEligibleCount');
  const modalNotEligibleCountEl = document.getElementById('modalNotEligibleCount');
  const modalThresholdLabelEl = document.getElementById('modalThresholdLabel');
  const modalDlBtn = document.getElementById('modalRosterDownloadBtn');
  const rosterBodyEl = document.getElementById('rosterPreviewBody');

  function escapeHtml(str) {
    return String(str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function updateRosterPreview(rawVal, sourceEl) {
    const parsed = parseFloat(rawVal);
    const threshold = isNaN(parsed) || parsed < 0 ? 0 : parsed;
    const thresholdFixed = threshold.toFixed(2);
    const thresholdScaled = Math.round(threshold * 10000);

    if (quickInput && sourceEl !== quickInput) quickInput.value = threshold;
    if (modalInput && sourceEl !== modalInput) modalInput.value = threshold;

    const eligible = allFacultyList
      .filter(f => Math.round((parseFloat(f.ros) || 0) * 10000) >= thresholdScaled)
      .sort((a, b) => (b.ros - a.ros) || a.name.localeCompare(b.name));
    const notEligibleCount = allFacultyList.length - eligible.length;

    if (quickCountEl) quickCountEl.textContent = eligible.length;
    if (modalEligibleCountEl) modalEligibleCountEl.textContent = eligible.length;
    if (modalNotEligibleCountEl) modalNotEligibleCountEl.textContent = notEligibleCount;
    if (modalThresholdLabelEl) modalThresholdLabelEl.textContent = thresholdFixed;

    const dlUrl = `/export/saturday-roster?threshold=${encodeURIComponent(threshold)}`;
    if (quickDlBtn) quickDlBtn.href = dlUrl;
    if (modalDlBtn) modalDlBtn.href = dlUrl;

    if (rosterBodyEl) {
      if (eligible.length === 0) {
        rosterBodyEl.innerHTML = `
          <tr>
            <td colspan="7" class="text-center py-4 text-muted">
              <i class="fas fa-info-circle me-1"></i>No faculty members meet the threshold of <strong>ROS &ge; ${thresholdFixed}</strong>.
            </td>
          </tr>`;
      } else {
        rosterBodyEl.innerHTML = eligible.map((f, idx) => `
          <tr>
            <td class="ps-3 fw-bold text-muted">${idx + 1}</td>
            <td><span class="badge bg-light text-primary border font-monospace">${escapeHtml(f.employee_code)}</span></td>
            <td><a href="/faculty/${f.id}" class="fw-bold text-dark text-decoration-none">${escapeHtml(f.name)}</a></td>
            <td class="small text-muted">${escapeHtml(f.designation) || '—'}</td>
            <td class="small">${escapeHtml(f.department) || '—'}</td>
            <td class="text-center fw-semibold">${f.total_pubs}</td>
            <td class="text-center">
              <span class="badge bg-success px-2 py-1 fs-6">${parseFloat(f.ros).toFixed(2)}</span>
            </td>
          </tr>`).join('');
      }
    }
  }

  window.setRosterThreshold = function(val) {
    updateRosterPreview(val, null);
  };

  window.openRosterModal = function() {
    updateRosterPreview(quickInput ? quickInput.value : 0.5, null);
    const modal = new bootstrap.Modal(document.getElementById('saturdayRosterModal'));
    modal.show();
  };

  if (quickInput) {
    quickInput.addEventListener('input', function() {
      updateRosterPreview(this.value, quickInput);
    });
  }
  if (modalInput) {
    modalInput.addEventListener('input', function() {
      updateRosterPreview(this.value, modalInput);
    });
  }
  // Initialize with default 0.50
  updateRosterPreview(0.50, null);

  // ── Portal View Switching (Grid vs List) ──────────────────────────
  window.setPortalViewMode = function(mode) {
    const listWrap = document.getElementById('facultyListViewWrap');
    const gridWrap = document.getElementById('facultyGridViewWrap');
    const listBtn = document.getElementById('listViewBtn');
    const gridBtn = document.getElementById('gridViewBtn');
    const returnToInputs = document.querySelectorAll('#bulkFacultyReturnTo');

    if (mode === 'list') {
      if (listWrap) listWrap.style.display = '';
      if (gridWrap) gridWrap.style.display = 'none';
      if (listBtn) { listBtn.classList.remove('btn-outline-primary'); listBtn.classList.add('btn-primary'); }
      if (gridBtn) { gridBtn.classList.remove('btn-primary'); gridBtn.classList.add('btn-outline-primary'); }
      returnToInputs.forEach(i => i.value = '/portal?view=list');
      localStorage.setItem('uic_portal_view', 'list');
      try {
        const u = new URL(window.location);
        u.searchParams.set('view', 'list');
        window.history.replaceState({}, '', u);
      } catch (_) {}
    } else {
      if (listWrap) listWrap.style.display = 'none';
      if (gridWrap) gridWrap.style.display = '';
      if (listBtn) { listBtn.classList.remove('btn-primary'); listBtn.classList.add('btn-outline-primary'); }
      if (gridBtn) { gridBtn.classList.remove('btn-outline-primary'); gridBtn.classList.add('btn-primary'); }
      returnToInputs.forEach(i => i.value = '/portal?view=grid');
      localStorage.setItem('uic_portal_view', 'grid');
      try {
        const u = new URL(window.location);
        u.searchParams.set('view', 'grid');
        window.history.replaceState({}, '', u);
      } catch (_) {}
    }

    if (typeof window.applyFilters === 'function') window.applyFilters();
    if (typeof window.updateFacultySelectionUI === 'function') window.updateFacultySelectionUI();
  };

  // Restore preferred view mode from URL param or localStorage
  const urlParams = new URLSearchParams(window.location.search);
  const preferredView = urlParams.get('view') || localStorage.getItem('uic_portal_view') || '<%= viewMode %>';
  if (preferredView === 'list') {
    window.setPortalViewMode('list');
  } else {
    window.setPortalViewMode('grid');
  }

  // ── Bulk Selection & Visibility / Delete Logic ────────────────────────
  const bulkFacultyForm = document.getElementById('bulkFacultyForm');
  const bulkFacultyActionInput = document.getElementById('bulkFacultyActionInput');
  const makePublicBtn = document.getElementById('makePublicFacultyBtn');
  const makePrivateBtn = document.getElementById('makePrivateFacultyBtn');
  const deleteSelectedBtn = document.getElementById('deleteSelectedFacultyBtn');
  const selectAllTop = document.getElementById('selectAllFaculty');
  const selectAllTable = document.getElementById('tableSelectAll');
  const selectedCountSpan = document.getElementById('selectedFacultyCount');
  const publicBtnCountSpan = document.getElementById('publicBtnCount');
  const privateBtnCountSpan = document.getElementById('privateBtnCount');
  const deleteBtnCountSpan = document.getElementById('deleteBtnCount');
  const visibleCountSpan = document.getElementById('visibleFacultyCount');

  function getActiveViewWrap() {
    const listWrap = document.getElementById('facultyListViewWrap');
    if (listWrap && listWrap.style.display !== 'none') return listWrap;
    return document.getElementById('facultyGridViewWrap');
  }

  function getActiveCheckboxes() {
    const activeWrap = getActiveViewWrap();
    if (!activeWrap) return Array.from(document.querySelectorAll('.faculty-select-cb'));
    return Array.from(activeWrap.querySelectorAll('.faculty-select-cb'));
  }

  function getVisibleCheckboxes() {
    return getActiveCheckboxes().filter(cb => {
      const wrap = cb.closest('.faculty-card-wrap');
      return !wrap || wrap.style.display !== 'none';
    });
  }

  function getSelectedUniqueIds() {
    const checked = Array.from(document.querySelectorAll('.faculty-select-cb:checked'));
    return Array.from(new Set(checked.map(cb => cb.value)));
  }

  function updateFacultySelectionUI() {
    const uniqueIds = getSelectedUniqueIds();
    const count = uniqueIds.length;

    if (selectedCountSpan) selectedCountSpan.textContent = count;
    if (publicBtnCountSpan) publicBtnCountSpan.textContent = count;
    if (privateBtnCountSpan) privateBtnCountSpan.textContent = count;
    if (deleteBtnCountSpan) deleteBtnCountSpan.textContent = count;

    if (makePublicBtn) makePublicBtn.disabled = count === 0;
    if (makePrivateBtn) makePrivateBtn.disabled = count === 0;
    if (deleteSelectedBtn) deleteSelectedBtn.disabled = count === 0;

    const visibleCbs = getVisibleCheckboxes();
    if (visibleCountSpan) visibleCountSpan.textContent = visibleCbs.length;

    const allVisibleChecked = visibleCbs.length > 0 && visibleCbs.every(cb => cb.checked);
    if (selectAllTop) selectAllTop.checked = allVisibleChecked;
    if (selectAllTable) selectAllTable.checked = allVisibleChecked;
  }
  window.updateFacultySelectionUI = updateFacultySelectionUI;

  function toggleAllVisible(checked) {
    const visibleCbs = getVisibleCheckboxes();
    visibleCbs.forEach(cb => {
      cb.checked = checked;
      const fid = cb.dataset.facultyId || cb.value;
      const syncMatch = document.querySelectorAll(`.faculty-select-cb[data-faculty-id="${fid}"]`);
      syncMatch.forEach(m => { m.checked = checked; });
    });
    updateFacultySelectionUI();
  }

  function submitBulkAction(action) {
    const uniqueIds = getSelectedUniqueIds();
    if (!bulkFacultyForm || uniqueIds.length === 0) return;

    if (bulkFacultyActionInput) bulkFacultyActionInput.value = action;

    // Clear existing dynamic inputs and re-add unique checked IDs
    bulkFacultyForm.querySelectorAll('input[name="faculty_ids"]').forEach(el => el.remove());
    uniqueIds.forEach(id => {
      const hidden = document.createElement('input');
      hidden.type = 'hidden';
      hidden.name = 'faculty_ids';
      hidden.value = id;
      bulkFacultyForm.appendChild(hidden);
    });

    bulkFacultyForm.submit();
  }

  if (makePublicBtn) {
    makePublicBtn.addEventListener('click', function() {
      const count = getSelectedUniqueIds().length;
      if (count === 0) return;
      if (confirm(`Make ${count} selected faculty profile(s) PUBLIC? Public profiles will be accessible to faculty.`)) {
        submitBulkAction('set_public');
      }
    });
  }

  if (makePrivateBtn) {
    makePrivateBtn.addEventListener('click', function() {
      const count = getSelectedUniqueIds().length;
      if (count === 0) return;
      if (confirm(`Make ${count} selected faculty profile(s) PRIVATE? Private profiles can only be accessed by admin.`)) {
        submitBulkAction('set_private');
      }
    });
  }

  if (deleteSelectedBtn) {
    deleteSelectedBtn.addEventListener('click', function() {
      const count = getSelectedUniqueIds().length;
      if (count === 0) return;
      if (confirm(`WARNING: Are you sure you want to permanently delete ${count} selected faculty profile(s) and all their publications? This cannot be undone.`)) {
        submitBulkAction('delete');
      }
    });
  }

  if (selectAllTop) {
    selectAllTop.addEventListener('change', function() {
      toggleAllVisible(this.checked);
    });
  }

  if (selectAllTable) {
    selectAllTable.addEventListener('change', function() {
      toggleAllVisible(this.checked);
    });
  }

  document.querySelectorAll('.faculty-select-cb').forEach(cb => {
    cb.addEventListener('change', function() {
      const fid = this.dataset.facultyId || this.value;
      const matching = document.querySelectorAll(`.faculty-select-cb[data-faculty-id="${fid}"]`);
      matching.forEach(m => { m.checked = this.checked; });
      updateFacultySelectionUI();
    });
  });
});
</script>
</body>
</html>
