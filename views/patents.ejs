                <input type="text" name="assignee" id="edit_assignee" class="form-control form-control-sm">
              </div>

              <div class="col-12">
                <label class="form-label fw-bold small">Patent Title <span class="text-danger">*</span></label>
                <input type="text" name="title" id="edit_title" class="form-control" required>
              </div>

              <div class="col-md-4">
                <label class="form-label fw-bold small">Application Number</label>
                <input type="text" name="application_number" id="edit_application_number" class="form-control form-control-sm">
              </div>
              <div class="col-md-4">
                <label class="form-label fw-bold small">Patent Number</label>
