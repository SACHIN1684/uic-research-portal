              <div class="col-md-4">
                <label class="form-label fw-bold small">Patent Office / Country</label>
                <input type="text" name="country_office" id="edit_country_office" class="form-control form-control-sm">
              </div>

              <div class="col-md-3">
                <label class="form-label fw-bold small">Filing Date</label>
                <input type="text" name="filing_date" id="edit_filing_date" class="form-control form-control-sm">
              </div>
              <div class="col-md-3">
                <label class="form-label fw-bold small">Published Date</label>
                <input type="text" name="published_date" id="edit_published_date" class="form-control form-control-sm">
              </div>
              <div class="col-md-3">
                <label class="form-label fw-bold small">Grant Date / Issue Date</label>
                <input type="text" name="grant_date" id="edit_grant_date" class="form-control form-control-sm">
              </div>
              <div class="col-md-3">
                <label class="form-label fw-bold small">Legal Status</label>
                <input type="text" name="legal_status" id="edit_legal_status" class="form-control form-control-sm" placeholder="Published, Filed, etc.">
              </div>

              <div class="col-md-3">
                <label class="form-label fw-bold small">Inventor(s)</label>
                <input type="text" name="inventors" id="edit_inventors" class="form-control form-control-sm">
              </div>
              <div class="col-md-3">
                <label class="form-label fw-bold small">IPC/CPC Classification</label>
                <input type="text" name="ipc_classification" id="edit_ipc_classification" class="form-control form-control-sm">
              </div>
              <div class="col-md-6">
                <label class="form-label fw-bold small">Proof Link</label>
                <input type="text" name="proof_link" id="edit_proof_link" class="form-control form-control-sm">
              </div>

              <div class="col-12">
                <label class="form-label fw-bold small">Abstract / Summary</label>
                <textarea name="abstract" id="edit_abstract" class="form-control" rows="3"></textarea>
              </div>
            </div>
          </div>
          <div class="modal-footer bg-light">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary fw-bold"><i class="fas fa-save me-1"></i>Update Patent Record</button>
          </div>
        </form>
      </div>
    </div>
  </div>
  <% } %>

