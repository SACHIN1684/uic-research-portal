  </div>

  <% if (isAdmin) { %>
  <!-- Modal 2: Upload Patents Sheet Modal -->
  <div class="modal fade" id="uploadPatentsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow">
        <form action="/patents/upload" method="POST" enctype="multipart/form-data">
          <div class="modal-header bg-warning text-dark">
            <h5 class="modal-title fw-bold"><i class="fas fa-file-import me-2"></i>Upload Patents Spreadsheet</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body p-4">
            <p class="text-muted small mb-3">
              Upload an Excel (.xlsx, .xls) or CSV spreadsheet containing UIC patent details. The columns should match the official sheet format.
            </p>
            <div class="mb-3">
              <label class="form-label fw-bold">Select Spreadsheet File <span class="text-danger">*</span></label>
              <input type="file" name="patents_file" class="form-control" accept=".xlsx, .xls, .csv" required>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold">Upload Action Mode</label>
              <div class="form-check p-3 bg-light rounded-3 border mb-2">
                <input class="form-check-input ms-0 me-2" type="radio" name="upload_mode" id="modeAppend" value="append" checked>
                <label class="form-check-label ps-1" for="modeAppend">
                  <strong class="text-primary"><i class="fas fa-shield-alt me-1"></i> Smart Sync &amp; Add New (Recommended)</strong>
                  <div class="text-muted small mt-1">
                    Automatically checks for duplicate entries using patent titles, application numbers, and faculty details. <strong>Only new records are added</strong>; all existing patent records are kept completely intact without creating duplicates.
                  </div>
                </label>
              </div>
              <div class="form-check p-3 bg-white rounded-3 border">
                <input class="form-check-input ms-0 me-2" type="radio" name="upload_mode" id="modeReplace" value="replace">
                <label class="form-check-label ps-1" for="modeReplace">
                  <strong class="text-danger"><i class="fas fa-exclamation-triangle me-1"></i> Replace Entire Table</strong>
                  <div class="text-muted small mt-1">
                    Erases the current table and re-imports all records fresh from the uploaded spreadsheet.
                  </div>
                </label>
              </div>
            </div>
            <div class="p-3 bg-light rounded-3 border small text-muted">
              <i class="fas fa-info-circle text-primary me-1"></i>
              You can download the template or current dataset using the <strong>Download Excel</strong> button anytime.
            </div>
          </div>
          <div class="modal-footer bg-light">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-warning fw-bold text-dark"><i class="fas fa-upload me-1"></i>Process &amp; Upload Sheet</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Modal 3: Add Single Patent Modal -->
  <div class="modal fade" id="addPatentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-xl">
      <div class="modal-content border-0 shadow">
        <form action="/patents/add" method="POST">
          <div class="modal-header bg-primary text-white">
            <h5 class="modal-title fw-bold"><i class="fas fa-plus-circle me-2"></i>Add New Patent Entry</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body p-4">
            <div class="row g-3">
              <div class="col-md-2">
                <label class="form-label fw-bold small">Sr. No.</label>
                <input type="number" name="sr_no" class="form-control form-control-sm" placeholder="Auto" value="<%= stats.total + 1 %>">
              </div>
              <div class="col-md-3">
                <label class="form-label fw-bold small">Employee Code (E-Code)</label>
                <input type="text" name="employee_code" class="form-control form-control-sm" placeholder="e.g. E19025">
              </div>
              <div class="col-md-4">
                <label class="form-label fw-bold small">Faculty Name <span class="text-danger">*</span></label>
                <input type="text" name="faculty_name" class="form-control form-control-sm" placeholder="e.g. Prabhat Kumar Ravi" required>
              </div>
              <div class="col-md-3">
                <label class="form-label fw-bold small">Assignee / Owner</label>
                <input type="text" name="assignee" class="form-control form-control-sm" placeholder="e.g. Chandigarh University">
              </div>

              <div class="col-12">
                <label class="form-label fw-bold small">Patent Title <span class="text-danger">*</span></label>
                <input type="text" name="title" class="form-control" placeholder="Enter complete patent invention title" required>
              </div>

              <div class="col-md-4">
                <label class="form-label fw-bold small">Application Number</label>
                <input type="text" name="application_number" class="form-control form-control-sm" placeholder="e.g. 202611064615">
              </div>
              <div class="col-md-4">
                <label class="form-label fw-bold small">Patent Number (if granted)</label>
                <input type="text" name="patent_number" class="form-control form-control-sm" placeholder="e.g. US1234567B2 or Ongoing">
              </div>
              <div class="col-md-4">
                <label class="form-label fw-bold small">Patent Office / Country</label>
                <input type="text" name="country_office" class="form-control form-control-sm" placeholder="e.g. INDIA, UK, USA" value="INDIA">
              </div>

              <div class="col-md-3">
                <label class="form-label fw-bold small">Filing Date</label>
                <input type="text" name="filing_date" class="form-control form-control-sm" placeholder="YYYY-MM-DD or DD/MM/YYYY">
              </div>
              <div class="col-md-3">
                <label class="form-label fw-bold small">Published Date</label>
                <input type="text" name="published_date" class="form-control form-control-sm" placeholder="DD/MM/YYYY or YYYY-MM-DD">
              </div>
              <div class="col-md-3">
                <label class="form-label fw-bold small">Grant Date / Issue Date</label>
                <input type="text" name="grant_date" class="form-control form-control-sm" placeholder="Ongoing or Date">
              </div>
              <div class="col-md-3">
                <label class="form-label fw-bold small">Legal Status</label>
                <select name="legal_status" class="form-select form-select-sm">
                  <option value="Published">Published</option>
                  <option value="Filed">Filed</option>
                  <option value="Waiting for UCRD PATENT CELL Confirmation">Waiting for UCRD Confirmation</option>
                  <option value="Published and Granted">Published and Granted</option>
                  <option value="Granted">Granted</option>
                  <option value="Ongoing">Ongoing</option>
                </select>
              </div>

              <div class="col-md-3">
                <label class="form-label fw-bold small">Inventor(s) Count / Details</label>
                <input type="text" name="inventors" class="form-control form-control-sm" placeholder="e.g. 1 or names">
              </div>
              <div class="col-md-3">
                <label class="form-label fw-bold small">IPC/CPC Classification</label>
                <input type="text" name="ipc_classification" class="form-control form-control-sm" placeholder="e.g. IPC, Design patent" value="IPC">
              </div>
              <div class="col-md-6">
                <label class="form-label fw-bold small">Proof Link (Google Drive / Official Portal URL)</label>
                <input type="url" name="proof_link" class="form-control form-control-sm" placeholder="https://drive.google.com/...">
              </div>

              <div class="col-12">
                <label class="form-label fw-bold small">Abstract / Invention Summary</label>
                <textarea name="abstract" class="form-control" rows="3" placeholder="Enter abstract or description of the patent"></textarea>
              </div>
            </div>
          </div>
          <div class="modal-footer bg-light">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary fw-bold"><i class="fas fa-save me-1"></i>Save Patent Entry</button>
          </div>
        </form>
      </div>
    </div>
  </div>

