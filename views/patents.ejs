    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    let currentStatusFilter = 'all';

    function filterPatentsTable() {
      const q = (document.getElementById('liveSearchPatents').value || '').toLowerCase().trim();
      const rows = document.querySelectorAll('.patent-row-item');
      let visible = 0;

      rows.forEach(row => {
        const title = row.dataset.title || '';
        const faculty = row.dataset.faculty || '';
        const ecode = row.dataset.ecode || '';
        const app = row.dataset.app || '';
        const patno = row.dataset.patno || '';
        const country = row.dataset.country || '';
        const status = row.dataset.status || '';
        const isPub = row.dataset.ispub === '1';

        const matchesSearch = !q ||
          title.includes(q) ||
          faculty.includes(q) ||
          ecode.includes(q) ||
          app.includes(q) ||
          patno.includes(q) ||
          country.includes(q) ||
          status.includes(q);

        let matchesStatus = true;
        if (currentStatusFilter === 'published') {
          matchesStatus = isPub;
        } else if (currentStatusFilter === 'filed') {
          matchesStatus = !isPub;
        } else if (currentStatusFilter === 'waiting') {
          matchesStatus = status.includes('wait') || status.includes('confirm');
        }

        const show = matchesSearch && matchesStatus;
        row.style.display = show ? '' : 'none';
        if (show) visible++;
      });

      const countEl = document.getElementById('visibleCountText');
      if (countEl) countEl.textContent = visible;

      const noRow = document.getElementById('noPatentsRow');
      if (noRow) noRow.style.display = (visible === 0 && rows.length > 0) ? '' : 'none';

      // Renumber visible serial index
      let sNo = 1;
      rows.forEach(r => {
        if (r.style.display !== 'none') {
          const sCol = r.querySelector('.serial-index-col');
          if (sCol) sCol.textContent = sNo++;
        }
      });
    }

    function setPatentStatusFilter(status, btnEl) {
      currentStatusFilter = status;
      document.querySelectorAll('.filter-pill-btn').forEach(b => b.classList.remove('active'));
      if (btnEl) btnEl.classList.add('active');
      filterPatentsTable();
    }

    function clearPatentSearch() {
      document.getElementById('liveSearchPatents').value = '';
      filterPatentsTable();
    }

    function resetAllPatentFilters() {
      document.getElementById('liveSearchPatents').value = '';
      currentStatusFilter = 'all';
      document.querySelectorAll('.filter-pill-btn').forEach((b, i) => b.classList.toggle('active', i === 0));
      filterPatentsTable();
    }

    function viewPatentAbstract(id) {
      const abstractEl = document.getElementById('abstract_data_' + id);
      const titleEl = document.getElementById('title_data_' + id);
      if (abstractEl && titleEl) {
        document.getElementById('abstractPatentTitleDisplay').textContent = titleEl.textContent;
        document.getElementById('abstractModalBody').textContent = abstractEl.textContent;
        const modal = new bootstrap.Modal(document.getElementById('abstractModal'));
        modal.show();
      }
    }

    // ── Bulk Selections ──
    function updatePatentSelectionCount() {
      const cbs = document.querySelectorAll('.patent-select-cb:checked');
      const count = cbs.length;
      const countSpan = document.getElementById('selectedPatentsCount');
      const btnCountSpan = document.getElementById('deleteSelectedBtnCount');
      const bar = document.getElementById('patentBulkBar');

      if (countSpan) countSpan.textContent = count;
      if (btnCountSpan) btnCountSpan.textContent = count;
      if (bar) bar.style.display = count > 0 ? '' : 'none';

      const allCbs = document.querySelectorAll('.patent-select-cb');
      const selectAll = document.getElementById('selectAllPatents');
      if (selectAll) selectAll.checked = allCbs.length > 0 && count === allCbs.length;
    }

    const selectAllTop = document.getElementById('selectAllPatents');
    if (selectAllTop) {
      selectAllTop.addEventListener('change', function() {
        const rows = document.querySelectorAll('.patent-row-item');
        rows.forEach(r => {
          if (r.style.display !== 'none') {
            const cb = r.querySelector('.patent-select-cb');
            if (cb) cb.checked = selectAllTop.checked;
          }
        });
        updatePatentSelectionCount();
      });
    }

    function clearPatentSelections() {
      document.querySelectorAll('.patent-select-cb').forEach(cb => cb.checked = false);
      if (selectAllTop) selectAllTop.checked = false;
      updatePatentSelectionCount();
    }

    function executeBulkDeletePatents() {
      const checked = Array.from(document.querySelectorAll('.patent-select-cb:checked')).map(cb => cb.value);
      if (checked.length === 0) return;
      if (!confirm(`Are you sure you want to permanently delete ${checked.length} selected patent entries? This cannot be undone.`)) return;

      document.getElementById('bulkDeletePatentsIdsInput').value = checked.join(',');
      document.getElementById('bulkDeletePatentsForm').submit();
    }

    // ── Edit Patent Modal AJAX Loader ──
    async function openEditPatentModal(id) {
      try {
        const res = await fetch('/api/patents/' + id);
        const data = await res.json();
        if (!data.ok || !data.patent) {
          alert('Could not load patent details: ' + (data.error || 'Unknown error'));
          return;
        }
        const p = data.patent;
        document.getElementById('editPatentForm').action = '/patents/' + p.id + '/edit';
        document.getElementById('edit_sr_no').value = p.sr_no || '';
        document.getElementById('edit_employee_code').value = p.employee_code || '';
        document.getElementById('edit_faculty_name').value = p.faculty_name || '';
        document.getElementById('edit_title').value = p.title || '';
        document.getElementById('edit_patent_number').value = p.patent_number || '';
        document.getElementById('edit_application_number').value = p.application_number || '';
        document.getElementById('edit_filing_date').value = p.filing_date || '';
        document.getElementById('edit_published_date').value = p.published_date || '';
        document.getElementById('edit_grant_date').value = p.grant_date || '';
        document.getElementById('edit_inventors').value = p.inventors || '';
        document.getElementById('edit_assignee').value = p.assignee || '';
        document.getElementById('edit_country_office').value = p.country_office || '';
        document.getElementById('edit_ipc_classification').value = p.ipc_classification || '';
        document.getElementById('edit_abstract').value = p.abstract || '';
        document.getElementById('edit_legal_status').value = p.legal_status || '';
        document.getElementById('edit_proof_link').value = p.proof_link || '';

        const modal = new bootstrap.Modal(document.getElementById('editPatentModal'));
        modal.show();
      } catch (err) {
        alert('Network error loading patent: ' + err.message);
      }
    }

    // ── Export Filtered Table ──
    function exportFilteredPatentsTable() {
      const q = encodeURIComponent(document.getElementById('liveSearchPatents').value.trim());
      const status = encodeURIComponent(currentStatusFilter);
      window.location.href = `/patents/download?filtered=1&search=${q}&status=${status}`;
    }
  </script>
</body>
</html>
