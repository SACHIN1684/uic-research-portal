<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Research Documents � UIC Admin Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
  <script src="/js/theme.js"></script>
  <style>
    body { font-family: "Inter", sans-serif; background: #0d1117; color: #e6edf3; }
    .docs-nav { background: linear-gradient(135deg, #161b22 0%, #0d1117 100%); border-bottom: 1px solid #30363d; padding: 0.75rem 1.5rem; }
    .brand-icon { width:38px;height:38px;border-radius:10px;background:linear-gradient(135deg,#58a6ff,#1f6feb);display:flex;align-items:center;justify-content:center;color:#fff;font-size:1rem; }
    .brand-title { font-size:1.1rem;font-weight:700;color:#e6edf3; }
    .brand-sub { font-size:0.68rem;color:#8b949e; }
    .page-header { background: linear-gradient(135deg, #1a2744 0%, #0d1b35 100%); border-bottom: 1px solid #1f6feb44; padding: 1.5rem 2rem; }
    .page-title { font-size: 1.6rem; font-weight: 700; color: #58a6ff; }
    .page-sub { color: #8b949e; font-size: 0.9rem; }
    .stat-card { background: #161b22; border: 1px solid #30363d; border-radius: 14px; padding: 1.2rem 1.5rem; transition: border-color 0.2s; }
    .stat-card:hover { border-color: #58a6ff55; }
    .stat-num { font-size: 2rem; font-weight: 700; }
    .stat-label { font-size: 0.8rem; color: #8b949e; text-transform: uppercase; letter-spacing: 0.05em; }
    .filter-bar { background: #161b22; border: 1px solid #30363d; border-radius: 12px; padding: 1rem 1.25rem; }
    .filter-bar .form-control, .filter-bar .form-select { background: #0d1117; border-color: #30363d; color: #e6edf3; font-size: 0.875rem; }
    .filter-bar .form-control:focus, .filter-bar .form-select:focus { border-color: #58a6ff; box-shadow: 0 0 0 3px rgba(88,166,255,0.15); background: #0d1117; color: #e6edf3; }
    .filter-bar .form-select option { background: #161b22; color: #e6edf3; }
    .docs-table-wrap { background: #161b22; border: 1px solid #30363d; border-radius: 14px; overflow: hidden; }
    .docs-table thead th { background: #1c2128; color: #8b949e; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.85rem 1rem; border-color: #30363d; font-weight: 600; }
    .docs-table tbody tr { border-color: #30363d; transition: background 0.15s; }
    .docs-table tbody tr:hover { background: #1c2128; }
    .docs-table td { padding: 0.9rem 1rem; vertical-align: middle; border-color: #30363d; color: #c9d1d9; font-size: 0.875rem; }
    .badge-pending { background: linear-gradient(135deg,#b45309,#d97706); color:#fff; }
    .badge-reviewed { background: linear-gradient(135deg,#166534,#16a34a); color:#fff; }
    .badge-faculty-uploader { background: #1f4e8c22; color: #58a6ff; border: 1px solid #1f6feb44; }
    .badge-admin-uploader { background: #3d1f5222; color: #d2a8ff; border: 1px solid #8957e544; }
    .file-icon-pdf { color: #f85149; font-size: 1.3rem; }
    .file-icon-docx { color: #58a6ff; font-size: 1.3rem; }
    .faculty-name-link { color: #58a6ff; font-weight: 600; text-decoration: none; }
    .faculty-name-link:hover { color: #79c0ff; text-decoration: underline; }
    .btn-dl { background: linear-gradient(135deg,#1f6feb,#388bfd); color:#fff; border:none; font-size:0.8rem; padding:0.3rem 0.7rem; border-radius:7px; }
    .btn-dl:hover { background: linear-gradient(135deg,#388bfd,#58a6ff); color:#fff; }
    .btn-review { background: #1c2b1c; color: #3fb950; border: 1px solid #3fb95044; font-size:0.8rem; padding:0.3rem 0.7rem; border-radius:7px; }
    .btn-review:hover { background: #3fb95022; color: #3fb950; }
    .btn-del { background: #2d1515; color: #f85149; border: 1px solid #f8514944; font-size:0.8rem; padding:0.3rem 0.7rem; border-radius:7px; }
    .btn-del:hover { background: #f8514922; color: #f85149; }
    .empty-state { padding: 4rem 2rem; text-align: center; color: #484f58; }
    .empty-state i { font-size: 3rem; display:block; margin-bottom:1rem; }
    .alert-success-dark { background: #1c2b1c; border: 1px solid #3fb95044; color: #3fb950; border-radius: 10px; }
    .alert-danger-dark { background: #2d1515; border: 1px solid #f8514944; color: #f85149; border-radius: 10px; }
    .notif-badge { position:absolute; top:-5px; right:-5px; background:#f85149; color:#fff; border-radius:50%; width:18px; height:18px; font-size:0.65rem; display:flex; align-items:center; justify-content:center; font-weight:700; }
  </style>
</head>
<body>

<nav class="docs-nav d-flex align-items-center justify-content-between flex-wrap gap-2">
  <a class="d-flex align-items-center gap-2 text-decoration-none" href="/">
    <div class="brand-icon"><i class="fas fa-flask"></i></div>
    <div>
      <div class="brand-title">UIC Research Portal</div>
      <div class="brand-sub">Admin � Research Documents</div>
    </div>
  </a>
  <div class="d-flex align-items-center gap-2 flex-wrap">
    <a href="/" class="btn btn-sm btn-outline-secondary"><i class="fas fa-home me-1"></i>Home</a>
    <a href="/portal" class="btn btn-sm btn-outline-secondary"><i class="fas fa-th-large me-1"></i>Directory</a>
    <div class="position-relative">
      <a href="/admin/profile-requests" class="btn btn-sm btn-outline-secondary">
        <i class="fas fa-user-lock me-1"></i>Profile Requests
      </a>
      <% if (typeof pendingProfileReqCount !== 'undefined' && pendingProfileReqCount > 0) { %>
        <span class="notif-badge"><%= pendingProfileReqCount %></span>
      <% } %>
    </div>
    <div class="position-relative">
      <a href="/admin/documents" class="btn btn-sm" style="background:linear-gradient(135deg,#1f6feb,#388bfd);color:#fff;">
        <i class="fas fa-file-shield me-1"></i>Documents
      </a>
      <% if (pendingCount > 0) { %>
        <span class="notif-badge"><%= pendingCount %></span>
      <% } %>
    </div>
    <form action="/admin/logout" method="POST" class="d-inline">
      <input type="hidden" name="return_to" value="/admin/documents">
      <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-sign-out-alt me-1"></i>Logout</button>
    </form>
  </div>
</nav>

<div class="page-header">
  <div class="container-fluid px-3">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
      <div>
        <div class="page-title"><i class="fas fa-file-shield me-2"></i>Research Proof Documents</div>
        <div class="page-sub">Faculty-submitted and admin-uploaded research proof documents</div>
      </div>
      <div>
        <% if (pendingCount > 0) { %>
          <span class="badge fs-6 px-3 py-2" style="background:linear-gradient(135deg,#b45309,#d97706);color:#fff;">
            <i class="fas fa-bell me-1"></i><%= pendingCount %> Pending Review
          </span>
        <% } else { %>
          <span class="badge bg-success fs-6 px-3 py-2">
            <i class="fas fa-check-circle me-1"></i>All Reviewed
          </span>
        <% } %>
      </div>
    </div>
  </div>
</div>

<main class="container-fluid px-3 py-4" style="max-width:1300px;">

  <% if (success) { %>
    <div class="alert alert-success-dark mb-3 d-flex align-items-center gap-2">
      <i class="fas fa-check-circle fs-5"></i>
      <span><%= success %></span>
      <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-danger-dark mb-3 d-flex align-items-center gap-2">
      <i class="fas fa-exclamation-triangle fs-5"></i>
      <span><%= error %></span>
      <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <%
    const totalShown = documents.length;
    const pendingShown = documents.filter(d => d.status === 'pending').length;
    const reviewedShown = documents.filter(d => d.status === 'reviewed').length;
    const facultyUploaded = documents.filter(d => d.uploader_type === 'faculty').length;
  %>
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="stat-card">
        <div class="stat-num text-info"><%= totalShown %></div>
        <div class="stat-label"><i class="fas fa-file me-1"></i>Total Shown</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card">
        <div class="stat-num" style="color:#d97706"><%= pendingCount %></div>
        <div class="stat-label"><i class="fas fa-clock me-1"></i>Pending Review</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card">
        <div class="stat-num text-success"><%= reviewedShown %></div>
        <div class="stat-label"><i class="fas fa-check me-1"></i>Reviewed</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card">
        <div class="stat-num" style="color:#58a6ff"><%= facultyUploaded %></div>
        <div class="stat-label"><i class="fas fa-chalkboard-teacher me-1"></i>Faculty Uploaded</div>
      </div>
    </div>
  </div>

  <form method="GET" action="/admin/documents" class="filter-bar mb-4">
    <div class="row g-2 align-items-end">
      <div class="col-12 col-md-5">
        <label class="form-label small text-secondary mb-1"><i class="fas fa-search me-1"></i>Search</label>
        <input type="text" name="search" class="form-control" placeholder="Faculty name, file name, description..."
          value="<%= filters.search %>">
      </div>
      <div class="col-6 col-md-3">
        <label class="form-label small text-secondary mb-1"><i class="fas fa-filter me-1"></i>Status</label>
        <select name="status" class="form-select">
          <option value="all" <%= filters.status === "all" ? "selected" : "" %>>All Status</option>
          <option value="pending" <%= filters.status === "pending" ? "selected" : "" %>>Pending</option>
          <option value="reviewed" <%= filters.status === "reviewed" ? "selected" : "" %>>Reviewed</option>
        </select>
      </div>
      <div class="col-6 col-md-2">
        <label class="form-label small text-secondary mb-1"><i class="fas fa-user me-1"></i>Uploader</label>
        <select name="uploader_type" class="form-select">
          <option value="all" <%= filters.uploader_type === "all" ? "selected" : "" %>>All</option>
          <option value="faculty" <%= filters.uploader_type === "faculty" ? "selected" : "" %>>Faculty</option>
          <option value="admin" <%= filters.uploader_type === "admin" ? "selected" : "" %>>Admin</option>
        </select>
      </div>
      <div class="col-12 col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-fill" style="font-size:0.875rem;">
          <i class="fas fa-search me-1"></i>Filter
        </button>
        <a href="/admin/documents" class="btn btn-outline-secondary" style="font-size:0.875rem;" title="Reset">
          <i class="fas fa-times"></i>
        </a>
      </div>
    </div>
  </form>

  <!-- Bulk Action Bar for Documents -->
  <form id="bulkDocsForm" method="POST" class="mb-3">
    <input type="hidden" name="return_to" value="/admin/documents?status=<%= filters.status %>&search=<%= filters.search %>&uploader_type=<%= filters.uploader_type %>">
    <div class="card border-0 shadow-sm rounded-3" style="background:#161b22; border:1px solid #30363d !important;">
      <div class="card-body py-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
          <div class="form-check mb-0">
            <input type="checkbox" class="form-check-input" id="selectAllDocs" style="cursor:pointer; transform:scale(1.15);">
            <label class="form-check-label fw-bold text-light ms-1" for="selectAllDocs" style="cursor:pointer;">
              Select All Documents (<span id="visibleDocsCount"><%= documents.length %></span>)
            </label>
          </div>
          <span class="badge bg-primary px-2 py-1 ms-2">
            <span id="selectedDocsCount">0</span> Selected
          </span>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <button type="submit" formaction="/admin/documents/bulk-review" id="bulkReviewDocsBtn" class="btn btn-sm btn-outline-success fw-semibold" disabled>
            <i class="fas fa-check-double me-1"></i>Mark Selected Reviewed (<span id="bulkReviewCount">0</span>)
          </button>
          <button type="submit" formaction="/admin/documents/bulk-delete" id="bulkDeleteDocsBtn" class="btn btn-sm btn-outline-danger fw-semibold" disabled onclick="return confirm('Permanently delete all selected documents? Files will be removed.');">
            <i class="fas fa-trash-alt me-1"></i>Delete Selected (<span id="bulkDeleteCount">0</span>)
          </button>
        </div>
      </div>
    </div>
  </form>

  <div class="docs-table-wrap">
    <% if (documents.length === 0) { %>
      <div class="empty-state">
        <i class="fas fa-folder-open text-secondary"></i>
        <div class="fs-5 fw-semibold mb-2 text-secondary">No Documents Found</div>
        <div class="small text-secondary">No research proof documents match your filters.</div>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table docs-table mb-0">
          <thead>
            <tr>
              <th style="width: 3%;" class="text-center">
                <input type="checkbox" id="tableSelectAllDocs" class="form-check-input" title="Select All Documents" style="cursor:pointer;">
              </th>
              <th>#</th>
              <th>Faculty</th>
              <th>Document</th>
              <th>Description</th>
              <th>Uploader</th>
              <th>Uploaded</th>
              <th>Status</th>
              <th class="text-center">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% documents.forEach((doc, idx) => {
              const isReviewed = doc.status === "reviewed";
              const isPdf = doc.file_type === "pdf";
              const uploadDate = new Date(doc.uploaded_at);
              const dateStr = uploadDate.toLocaleDateString("en-IN", { day:"2-digit", month:"short", year:"numeric" });
              const timeStr = uploadDate.toLocaleTimeString("en-IN", { hour:"2-digit", minute:"2-digit" });
            %>
            <tr>
              <td class="text-center">
                <input type="checkbox" name="document_ids" value="<%= doc.id %>" form="bulkDocsForm" class="form-check-input doc-select-cb" style="cursor:pointer;">
              </td>
              <td class="text-secondary fw-semibold"><%= idx + 1 %></td>
              <td>
                <a href="/faculty/<%= doc.faculty_id %>" class="faculty-name-link" target="_blank">
                  <%= doc.faculty_name %>
                </a>
                <% if (doc.designation) { %>
                  <div class="text-secondary" style="font-size:0.75rem;"><%= doc.designation %></div>
                <% } %>
                <% if (doc.department) { %>
                  <div class="text-secondary" style="font-size:0.72rem;"><i class="fas fa-building me-1"></i><%= doc.department %></div>
                <% } %>
              </td>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <i class="<%= isPdf ? "fas fa-file-pdf file-icon-pdf" : "fas fa-file-word file-icon-docx" %>"></i>
                  <div>
                    <div class="fw-semibold text-truncate" style="max-width:200px;" title="<%= doc.original_name %>">
                      <%= doc.original_name %>
                    </div>
                    <div class="text-secondary" style="font-size:0.72rem;">
                      <%= (doc.file_size / 1024).toFixed(1) %> KB &middot; <%= doc.file_type.toUpperCase() %>
                    </div>
                  </div>
                </div>
              </td>
              <td><span class="text-secondary small"><%= doc.description || "&mdash;" %></span></td>
              <td>
                <span class="badge badge-<%= doc.uploader_type === "admin" ? "admin" : "faculty" %>-uploader px-2 py-1">
                  <i class="fas fa-<%= doc.uploader_type === "admin" ? "user-shield" : "chalkboard-teacher" %> me-1"></i>
                  <%= doc.uploader_type === "admin" ? "Admin" : "Faculty" %>
                </span>
              </td>
              <td>
                <div class="small"><%= dateStr %></div>
                <div class="text-secondary" style="font-size:0.72rem;"><%= timeStr %></div>
              </td>
              <td>
                <span class="badge badge-<%= isReviewed ? "reviewed" : "pending" %> px-2 py-1">
                  <i class="fas fa-<%= isReviewed ? "check-circle" : "clock" %> me-1"></i>
                  <%= isReviewed ? "Reviewed" : "Pending" %>
                </span>
              </td>
              <td>
                <div class="d-flex gap-1 justify-content-center flex-wrap">
                  <a href="/admin/documents/<%= doc.id %>/download" class="btn btn-dl" title="Download">
                    <i class="fas fa-download me-1"></i>Download
                  </a>
                  <% if (!isReviewed) { %>
                    <form action="/admin/documents/<%= doc.id %>/mark-reviewed" method="POST" class="d-inline">
                      <input type="hidden" name="return_to" value="/admin/documents?status=<%= filters.status %>&search=<%= filters.search %>&uploader_type=<%= filters.uploader_type %>">
                      <button type="submit" class="btn btn-review">
                        <i class="fas fa-check me-1"></i>Reviewed
                      </button>
                    </form>
                  <% } %>
                  <form action="/admin/documents/<%= doc.id %>/delete" method="POST" class="d-inline"
                    onsubmit="return confirm('Delete this document permanently?')">
                    <input type="hidden" name="return_to" value="/admin/documents?status=<%= filters.status %>&search=<%= filters.search %>&uploader_type=<%= filters.uploader_type %>">
                    <button type="submit" class="btn btn-del">
                      <i class="fas fa-trash me-1"></i>Delete
                    </button>
                  </form>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
  const selectAllTop = document.getElementById('selectAllDocs');
  const selectAllTable = document.getElementById('tableSelectAllDocs');
  const reviewBtn = document.getElementById('bulkReviewDocsBtn');
  const deleteBtn = document.getElementById('bulkDeleteDocsBtn');
  const countSpan = document.getElementById('selectedDocsCount');
  const revCountSpan = document.getElementById('bulkReviewCount');
  const delCountSpan = document.getElementById('bulkDeleteCount');

  function getDocCheckboxes() {
    return Array.from(document.querySelectorAll('.doc-select-cb'));
  }

  function updateDocsSelectionUI() {
    const checked = getDocCheckboxes().filter(cb => cb.checked);
    const count = checked.length;
    if (countSpan) countSpan.textContent = count;
    if (revCountSpan) revCountSpan.textContent = count;
    if (delCountSpan) delCountSpan.textContent = count;
    if (reviewBtn) reviewBtn.disabled = count === 0;
    if (deleteBtn) deleteBtn.disabled = count === 0;

    const all = getDocCheckboxes();
    const allChecked = all.length > 0 && all.every(cb => cb.checked);
    if (selectAllTop) selectAllTop.checked = allChecked;
    if (selectAllTable) selectAllTable.checked = allChecked;
  }

  function toggleAll(checked) {
    getDocCheckboxes().forEach(cb => cb.checked = checked);
    updateDocsSelectionUI();
  }

  if (selectAllTop) {
    selectAllTop.addEventListener('change', function() { toggleAll(this.checked); });
  }
  if (selectAllTable) {
    selectAllTable.addEventListener('change', function() { toggleAll(this.checked); });
  }

  getDocCheckboxes().forEach(cb => {
    cb.addEventListener('change', updateDocsSelectionUI);
  });
});
</script>
</body>
</html>
