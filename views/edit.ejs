<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit <%= faculty.name %> — UIC Research Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark portal-nav">
  <div class="container-fluid px-4">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/portal">
      <div class="brand-icon"><i class="fas fa-flask"></i></div>
      <div>
        <div class="brand-title">UIC Research Portal</div>
        <div class="brand-sub">University Institute of Computing, Chandigarh University</div>
      </div>
    </a>
    <div class="ms-auto d-flex align-items-center gap-3">
      <a href="/" class="btn btn-outline-light btn-sm fw-semibold"><i class="fas fa-home me-1"></i>Home & About</a>
      <a href="/portal" class="nav-link-btn"><i class="fas fa-th-large me-1"></i>Directory</a>
      <a href="/faculty/add" class="btn btn-add">
        <i class="fas fa-user-plus me-1"></i>Add Faculty
      </a>
    </div>
  </div>
</nav>

<main class="main-content">
  <div class="container" style="max-width:860px;">

    <div class="page-header">
      <div>
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb custom-breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item"><a href="/portal">Directory</a></li>
            <li class="breadcrumb-item"><a href="/faculty/<%= faculty.id %>"><%= faculty.name %></a></li>
            <li class="breadcrumb-item active">Edit Profile</li>
          </ol>
        </nav>
        <h1 class="page-title"><i class="fas fa-edit me-2"></i>Edit Faculty Profile</h1>
        <p class="page-sub">Updating details for <strong><%= faculty.name %></strong></p>
      </div>
    </div>

    <% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="fas fa-exclamation-triangle me-2"></i><%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>

    <form action="/faculty/<%= faculty.id %>/edit" method="POST" enctype="multipart/form-data" id="facultyForm">

      <!-- Section 1: Personal Info -->
      <div class="form-section">
        <div class="form-section-header">
          <i class="fas fa-id-card me-2"></i>Faculty Profile Information
        </div>
        <div class="form-section-body">
          <div class="photo-upload-area mb-4">
            <div class="photo-preview-wrap" id="photoPreviewWrap">
              <% if (faculty.photo) { %>
                <img id="photoPreview" src="/uploads/<%= faculty.photo %>" alt="Current photo" class="photo-preview-img" style="display:block;">
                <div class="photo-placeholder" id="photoPlaceholder" style="display:none;">
                  <i class="fas fa-camera fa-2x"></i><span>Click to upload photo</span>
                </div>
              <% } else { %>
                <div class="photo-placeholder" id="photoPlaceholder">
                  <i class="fas fa-camera fa-2x"></i><span>Click to upload photo</span>
                </div>
                <img id="photoPreview" src="" alt="Preview" class="photo-preview-img" style="display:none;">
              <% } %>
            </div>
            <div class="photo-upload-info">
              <label for="photo" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-upload me-1"></i>Change Photo
              </label>
              <input type="file" id="photo" name="photo" accept="image/*" class="d-none">
              <div class="text-muted small mt-1">Leave blank to keep current photo</div>
            </div>
          </div>

          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label required-label">Full Name</label>
              <input type="text" name="name" class="form-control portal-input" value="<%= faculty.name %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label required-label">Employee Code</label>
              <input type="text" name="employee_code" class="form-control portal-input" value="<%= faculty.employee_code %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Designation</label>
              <select name="designation" class="form-select portal-input">
                <option value="">Select Designation</option>
                <% ['Professor','Associate Professor','Assistant Professor','Lecturer','Research Fellow','Visiting Faculty'].forEach(d => { %>
                <option value="<%= d %>" <%= faculty.designation === d ? 'selected' : '' %>><%= d %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Department</label>
              <input type="text" name="department" class="form-control portal-input" value="<%= faculty.department %>">
            </div>
          </div>
        </div>
      </div>

      <div class="form-actions">
        <a href="/faculty/<%= faculty.id %>" class="btn btn-cancel"><i class="fas fa-times me-1"></i>Cancel</a>
        <button type="submit" class="btn btn-submit"><i class="fas fa-save me-1"></i>Save Profile Changes</button>
      </div>

    </form>
  </div>
</main>

<footer class="portal-footer">
  <div class="container-fluid px-4 text-center">
    <span><i class="fas fa-university me-1"></i><strong>UIC Research Portal</strong> &bull; University Institute of Computing, Chandigarh University &copy; <%= new Date().getFullYear() %></span>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/app.js"></script>
</body>
</html>
